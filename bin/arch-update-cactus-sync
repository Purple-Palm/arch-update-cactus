#!/usr/bin/env bash
# arch-update-cactus-sync: bring this machine to the newest *tested* version of Arch Update by Cactus.
#
# GitHub CI moves the "stable" branch only after the tests pass, and every machine mirrors that
# branch: fetch it, switch the checkout to it, run the new version's self-test here, refresh the
# installed files. sync.ok remembers the last version that passed on this machine. A version that
# fails — or whose check was cut short by a shutdown — is replaced by that one again and left
# alone for a day (sync.rejected).
# Runs hourly and after login (arch-update-cactus-sync.timer) and from the launcher before each
# start. "--quick" (the launcher): the network gets 5 s instead of 30, and a sync that is already
# running is waited for, so the window always opens on a verified version.
#
# Exit status: 0 nothing new / offline / skipped, 10 updated, 1 a new version was rejected.
set -uo pipefail

ROOT=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
INSTALLED=$(realpath -m "$HOME/.local/share/arch-update-cactus")
STATE=$HOME/.local/state/arch-update-auto
LOG=$STATE/sync.log
OK=$STATE/sync.ok
REJECTED=$STATE/sync.rejected
BRANCH=stable
mkdir -p "$STATE"

log() {
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
	[[ -t 2 ]] && printf '%s\n' "$*" >&2
	if (($(stat -c %s "$LOG" 2>/dev/null || echo 0) > 100000)); then
		tail -n 300 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
	fi
	return 0
}

# Only for a person running it by hand.
say() {
	[[ -t 2 ]] && printf '%s\n' "$*" >&2
	return 0
}

# Only the installed copy follows "stable"; a development clone is never reset under its owner.
if [[ $ROOT != "$INSTALLED" || -L $HOME/.local/share/arch-update-cactus ]]; then
	say "это не установленная копия ($ROOT): синхронизируется только $INSTALLED"
	exit 0
fi
wait=30
[[ ${1-} == --quick ]] && wait=5

exec 9>"$STATE/sync.lock"
if [[ ${1-} == --quick ]]; then
	flock -w 20 9 || exit 0
else
	flock -n 9 || exit 0
fi
cd "$ROOT" || exit 0
export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false
# We hold the sync lock, so a git lock file older than a few minutes was left by a crash.
find .git -maxdepth 5 -name '*.lock' -mmin +5 -delete 2>/dev/null

# Make the checkout exactly this commit.
switch_to() {
	rm -f .git/index.lock
	git reset --quiet --hard "$1" 2>>"$LOG"
}

# The checked-out version's self-test, then refresh what install.sh generates from it.
verified() {
	"$ROOT/install.sh" --check >>"$LOG" 2>&1 && "$ROOT/install.sh" --sync >>"$LOG" 2>&1
}

# This version failed here: back to the last one that passed.
reject() {
	local good
	echo "$1" >"$REJECTED"
	good=$(cat "$OK" 2>/dev/null)
	if [[ -n $good && $good != "$1" ]] && git cat-file -e "$good^{commit}" 2>/dev/null && switch_to "$good"; then
		"$ROOT/install.sh" --sync >>"$LOG" 2>&1
		log "версия ${1:0:7} не прошла самопроверку на этой машине — вернул ${good:0:7}"
	else
		log "версия ${1:0:7} не прошла самопроверку на этой машине, а проверенной версии для отката нет"
	fi
}

# 1. The installed copy is a mirror: edits made in it are saved as a patch, then overwritten
#    (this also repairs a checkout left half-switched by a crash).
if [[ -n $(git status --porcelain --untracked-files=no 2>/dev/null) ]]; then
	patch=$STATE/local-changes-$(date +%F_%H-%M-%S).patch
	git diff HEAD >"$patch" 2>/dev/null
	switch_to HEAD
	log "в установленной копии были изменения — сохранил их в $patch и вернул файлы"
fi

# 2. What is installed now must have passed here (a sync or the installer may have been cut short).
head=$(git rev-parse HEAD)
if [[ $head != "$(cat "$OK" 2>/dev/null)" ]]; then
	if verified; then
		echo "$head" >"$OK"
		log "версия ${head:0:7} проверена"
	else
		reject "$head"
	fi
fi

# 3. Anything newer on GitHub? A public repository needs no credentials.
if ! err=$(timeout "$wait" git -c credential.helper= fetch --quiet origin "$BRANCH" 2>&1); then
	err=${err:-нет ответа за $wait с}
	err=${err//$'\n'/ }
	say "GitHub недоступен: $err"
	# Logged when the reason changes or once a day: offline is normal, a broken fetch is not.
	if [[ $err != "$(cat "$STATE/sync.fetch-error" 2>/dev/null)" ||
		-n $(find "$STATE/sync.fetch-error" -mmin +1440 2>/dev/null) ]]; then
		echo "$err" >"$STATE/sync.fetch-error"
		log "не удалось получить обновления: $err"
	fi
	exit 0
fi
rm -f "$STATE/sync.fetch-error"
old=$(git rev-parse HEAD) new=$(git rev-parse FETCH_HEAD)
if [[ $old == "$new" ]]; then
	say "установлена последняя версия: ${new:0:7} $(git log -1 --format=%s)"
	exit 0
fi
if [[ $new == "$(cat "$REJECTED" 2>/dev/null)" && -z $(find "$REJECTED" -mmin +1440 2>/dev/null) ]]; then
	say "версия ${new:0:7} не прошла самопроверку на этой машине; новая попытка через сутки или с новой версией"
	exit 0
fi

# 4. Switch, check, keep or go back.
if ! switch_to "$new"; then
	log "не удалось переключиться на ${new:0:7} — возвращаю ${old:0:7}"
	switch_to "$old"
	exit 1
fi
if verified; then
	echo "$new" >"$OK"
	rm -f "$REJECTED"
	log "обновлено ${old:0:7} → ${new:0:7}: $(git log -1 --format=%s)"
	exit 10
fi
reject "$new"
exit 1
