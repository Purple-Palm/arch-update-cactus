#!/usr/bin/env bash
# arch-update-cactus-sync: bring this machine to the newest *tested* version of Arch Update by Cactus.
#
# GitHub CI moves the "stable" branch only after the tests pass, and every machine mirrors that
# branch: fetch it, switch the checkout to it, run the new version's self-test, refresh the
# installed files. A version that fails its self-test is rolled back and remembered as bad.
# Runs hourly and after login (arch-update-cactus-sync.timer) and from the launcher before each
# start ("--quick": gives the network 5 s instead of 30, so a click on the tray never waits long).
#
# Exit status: 0 nothing new / offline / skipped, 10 updated, 1 the new version was rejected.
set -uo pipefail

ROOT=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
INSTALLED=$HOME/.local/share/arch-update-cactus
STATE=$HOME/.local/state/arch-update-auto
LOG=$STATE/sync.log
BRANCH=stable
mkdir -p "$STATE"

log() {
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
	[[ -t 2 ]] && printf '%s\n' "$*" >&2
	return 0
}

# Only the installed copy follows "stable"; a development clone is never reset under its owner.
[[ $ROOT == "$INSTALLED" ]] || exit 0
wait=30
[[ ${1-} == --quick ]] && wait=5

exec 9>"$STATE/sync.lock"
flock -n 9 || exit 0                       # another sync is already running
cd "$ROOT" || exit 0

# A public repository needs no credentials; never let git open a password prompt from a timer.
export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false
if ! timeout "$wait" git -c credential.helper= fetch --quiet origin "$BRANCH" 2>/dev/null; then
	exit 0                                 # offline: the next run will catch up
fi
old=$(git rev-parse HEAD) new=$(git rev-parse FETCH_HEAD)
[[ $old == "$new" ]] && exit 0
if [[ $new == "$(cat "$STATE/sync.rejected" 2>/dev/null)" ]]; then
	exit 0                                 # already tried this one and it failed here
fi
if [[ -n $(git status --porcelain) ]]; then
	log "в $ROOT есть локальные правки: обновление ${new:0:7} пропущено (посмотри git status)"
	exit 0
fi

git reset --quiet --hard "$new" || exit 1
if "$ROOT/install.sh" --check >>"$LOG" 2>&1 && "$ROOT/install.sh" --sync >>"$LOG" 2>&1; then
	log "обновлено ${old:0:7} → ${new:0:7}: $(git log -1 --format=%s)"
	rm -f "$STATE/sync.rejected"
	tail -n 300 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
	exit 10
fi
log "версия ${new:0:7} не прошла самопроверку на этой машине, остаюсь на ${old:0:7}"
echo "$new" >"$STATE/sync.rejected"
git reset --quiet --hard "$old"
"$ROOT/install.sh" --sync >>"$LOG" 2>&1
exit 1
