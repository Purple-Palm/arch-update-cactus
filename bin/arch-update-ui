sys.path.insert(0, LIB)
try:
    import engine  # noqa: E402
    import games  # noqa: E402
    import report  # noqa: E402
except Exception as e:      # no python-pexpect, a damaged file…: the update itself must still be possible
    print(f"arch-update-ui: не загрузился движок апдейтера: {e!r}")
    print("Если не хватает pexpect: sudo pacman -S --needed python-pexpect")
    try:
        if "--self-test" not in sys.argv and "--demo" not in sys.argv and \
                input("Enter — обычный arch-update, q — выход: ").strip() not in ("q", "й"):
            os.execvp("arch-update", ["arch-update"])
    except (EOFError, KeyboardInterrupt, OSError):
        pass
    sys.exit(1)

DEMO = "--demo" in sys.argv
AUTOPLAY = DEMO and os.environ.get("ARCH_UPDATE_UI_AUTOPLAY") == "1"   # demo drives itself (screenshots)
DEMO_CMD = os.path.join(LIB, "demo-update")
FPS = int(os.environ.get("ARCH_UPDATE_UI_FPS") or 30)


class Pace:
    """Frame pacing: FPS while frames are cheap, half of it once they cost more than 8 ms
    (a slow laptop CPU), so the UI never competes with the update for the processor."""
    def __init__(self):
        self.cost = 0.0

    def measure(self, seconds):
        self.cost += (seconds - self.cost) * 0.1

    @property
    def interval(self):
        return 1 / (FPS if self.cost < 0.008 else max(1, FPS // 2))


PACE = Pace()

# ───────────────────────────── colour ─────────────────────────────

def hexrgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


BG = hexrgb("#0b0e17")
PAL_ARCH = [hexrgb(c) for c in ("#1793d1", "#4f7bff", "#8b5cff", "#d65cff", "#ff5ca8", "#8b5cff", "#4f7bff")]
PAL_RUN = [hexrgb(c) for c in ("#00f5c4", "#00d2ff", "#3d8bff", "#00d2ff")]
PAL_OK = [hexrgb(c) for c in ("#3ddc84", "#00f5c4", "#7cffb2", "#00f5c4")]
PAL_WARN = [hexrgb(c) for c in ("#ffb347", "#ffd166", "#ff9f43", "#ffd166")]
PAL_BAD = [hexrgb(c) for c in ("#ff5c7a", "#ff8f5c", "#ff3d6e", "#ff8f5c")]
TEXT = hexrgb("#c9d1e3")
DIM = hexrgb("#6b7591")
FAINT = hexrgb("#2a3147")       # rules, tracks, grid dots: never text (1.5:1 on BG)
MUTED = hexrgb("#4e5876")       # quiet text: captions, pending stages, hints, the log path (2.7:1)
TRACK = hexrgb("#1a2034")       # trough of the progress bars
GOOD = hexrgb("#3ddc84")
WARN = hexrgb("#ffc457")
BAD = hexrgb("#ff5c7a")
PINK = hexrgb("#ff5ca8")


PANEL = hexrgb("#141a2a")


def lerp(a, b, t):
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def grad(pal, x):
    x = x % 1.0
    n = len(pal)
    p = x * n
    i = int(p)
    return lerp(pal[i % n], pal[(i + 1) % n], p - i)


def shade(c, k):
    return tuple(int(v * k) for v in c)


def ease(t):
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    return 1 - (1 - t) ** 3


def clamp01(t):
    return 0.0 if t < 0 else 1.0 if t > 1 else t


class Backdrop:
    """Slowly drifting, twinkling star field plus a faint aurora along the bottom edge."""

    def __init__(self, n=110, seed=7):
        rnd = __import__("random").Random(seed)
        self.stars = [(rnd.random(), rnd.random(), 0.004 + rnd.random() * 0.018, rnd.random() * 6.3,
                       rnd.choice("···∙∙•✦") if rnd.random() < 0.97 else "✦") for _ in range(n)]

    def draw(self, c, t, pal, fade=1.0):
        """Drawn AFTER the screen's content, and only into cells two columns away from anything
        drawn, so the sky never shows inside a selection band, never reads as punctuation next to
        a word and never runs into a line of text."""
        # The background moves slowly: 6 updates per second look the same as 30 and keep almost
        # every row unchanged between frames, so only a small diff is sent to the terminal.
        t = math.floor(t * 6) / 6
        fade = round(fade * 8) / 8
        cells = []
        for sx, sy, speed, ph, ch in self.stars[:max(1, c.w * c.h // 36)]:    # a small screen: fewer stars
            x = int(((sx - t * speed) % 1.0) * c.w) % c.w     # % 1.0 can round up to 1.0
            y = int(sy * (c.h - 1))
            tw = 0.35 + 0.65 * (0.5 + 0.5 * math.sin(t * 1.7 + ph))
            k = (0.10 if ch in "·∙" else 0.18) * tw * fade
            cells.append((x, y, ch, lerp(BG, grad(pal, sx + t * 0.02), k)))
        base = c.h - 3                     # aurora: two thin sine threads, ▔ ─ ▁ by the height in the row
        for j, (amp, fr, sp) in enumerate(((1.3, 0.045, 0.55), (0.9, 0.07, -0.4))):
            hue = math.floor(t * 0.03 * 48) / 48 + j * 0.3
            for x in range(c.w):
                v = math.sin(x * fr + t * sp + j * 2) * amp + math.sin(x * fr * 0.37 - t * 0.3) * 0.6
                yf = base - 1.5 - j - v                    # fractional row (grows downwards)
                r = math.floor(yf)
                if 0 <= r < c.h:
                    k = math.floor((0.16 + 0.07 * math.sin(x * 0.05 + t)) * fade * 64) / 64
                    col = lerp(BG, grad(pal, math.floor(x / c.w * 0.8 * 24) / 24 + hue), k)
                    cells.append((x, r, "▔─▁"[min(2, int((yf - r) * 3))], col))
        keep = []
        for x, y, ch, fg in cells:         # decided against the content alone, then written
            fgs, bgs = c.fg[y], c.bg[y]
            for i in range(max(0, x - 2), min(c.w, x + 3)):
                if fgs[i] is not None or bgs[i] is not None:
                    break
            else:
                keep.append((x, y, ch, fg))
        for x, y, ch, fg in keep:
            c.ch[y][x], c.fg[y][x] = ch, fg


U = types.SimpleNamespace(grad=grad, lerp=lerp, shade=shade, PAL_ARCH=PAL_ARCH, PAL_RUN=PAL_RUN, TEXT=TEXT,
                          DIM=DIM, FAINT=FAINT, BG=BG, PINK=PINK, GOOD=GOOD, PANEL=PANEL)
BACKDROP = Backdrop()


# ───────────────────────────── big font (ANSI Shadow) ─────────────────────────────

GLYPHS = {
    "A": [" █████╗ ", "██╔══██╗", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    "R": ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔══██╗", "██║  ██║", "╚═╝  ╚═╝"],
    "C": [" ██████╗", "██╔════╝", "██║     ", "██║     ", "╚██████╗", " ╚═════╝"],
    "H": ["██╗  ██╗", "██║  ██║", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    "U": ["██╗   ██╗", "██║   ██║", "██║   ██║", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    "P": ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔═══╝ ", "██║     ", "╚═╝     "],
    "D": ["██████╗ ", "██╔══██╗", "██║  ██║", "██║  ██║", "██████╔╝", "╚═════╝ "],
    "T": ["████████╗", "╚══██╔══╝", "   ██║   ", "   ██║   ", "   ██║   ", "   ╚═╝   "],
    "E": ["███████╗", "██╔════╝", "█████╗  ", "██╔══╝  ", "███████╗", "╚══════╝"],
    " ": ["   "] * 6,
}
# Verdict glyphs in half blocks: a pixel is one column by half a row (about square), so the strokes
# run at a smooth 45 degrees instead of the big font's two-column steps.
CHECK = ["             ▄██",
         "           ▄██▀ ",
         " ▄▄      ▄██▀   ",
         " ▀██▄  ▄██▀     ",
         "   ▀████▀       ",
         "     ▀▀         "]
CROSS = ["██▄      ▄██",
         " ▀██▄  ▄██▀ ",
         "   ▀████▀   ",
         "   ▄████▄   ",
         " ▄██▀  ▀██▄ ",
         "██▀      ▀██"]
BANG = [" ████ ", " ████ ", " ████ ", "  ▀▀  ", " ▄▄▄▄ ", " ████ "]
SHADOW_CHARS = set("╔╗╚╝═║")


def big_text(word):
    """Returns (rows, letter_spans) for a word in the big font."""
    rows = [""] * 6
    spans = []
    for ch in word:
        g = GLYPHS[ch]
        start = len(rows[0])
        for i in range(6):
            rows[i] += g[i]
        spans.append((start, len(rows[0])))
    return rows, spans


# ───────────────────────────── canvas ─────────────────────────────

class Canvas:
    """A frame of cells; serialised with 24-bit colour, only changed rows are rewritten."""

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.clear()
        self.prev = [None] * h

    def clear(self):
        self.ch = [[" "] * self.w for _ in range(self.h)]
        self.fg = [[None] * self.w for _ in range(self.h)]
        self.bg = [[None] * self.w for _ in range(self.h)]
        self.bd = [[False] * self.w for _ in range(self.h)]

    def put(self, x, y, text, fg=TEXT, bg=None, bold=False, alpha=1.0):
        if y < 0 or y >= self.h:
            return
        if alpha < 1:
            fg = lerp(BG, fg, alpha)
            if bg:
                bg = lerp(BG, bg, alpha)
        for i, c in enumerate(text):
            xx = x + i
            if 0 <= xx < self.w:
                self.ch[y][xx] = c
                self.fg[y][xx] = fg
                if bg is not None:
                    self.bg[y][xx] = bg
                self.bd[y][xx] = bold

    def cput(self, y, text, fg=TEXT, **k):
        self.put((self.w - len(text)) // 2, y, text, fg, **k)

    def dim(self, k):
        """Push everything drawn so far towards the background (behind a modal)."""
        for y in range(self.h):
            fr, br = self.fg[y], self.bg[y]
            for x in range(self.w):
                if fr[x]:
                    fr[x] = lerp(fr[x], BG, k)
                if br[x]:
                    br[x] = lerp(br[x], BG, k)

    def blank(self, x, y, w, h, color):
        """Opaque rectangle: wipes whatever was drawn below (modals)."""
        for yy in range(max(0, y), min(self.h, y + h)):
            for xx in range(max(0, x), min(self.w, x + w)):
                self.ch[yy][xx], self.fg[yy][xx], self.bg[yy][xx], self.bd[yy][xx] = " ", None, color, False

    def fill_bg(self, x, y, w, color):
        if 0 <= y < self.h:
            for xx in range(max(0, x), min(self.w, x + w)):
                self.bg[y][xx] = color

    def rows(self):
        """Each row as text with the fewest colour changes: a space shows only its background,
        so it never switches the text colour, and a change re-sends only what differs.
        Every cell gets our own background, so a light terminal theme never shows through.
        A row starts and ends with the terminal's default attributes."""
        out = []
        for y in range(self.h):
            parts, cfg, cbg, cbd = [], None, None, False
            chs, fgs, bgs, bds = self.ch[y], self.fg[y], self.bg[y], self.bd[y]
            for x in range(self.w):
                ch, bg = chs[x], bgs[x] or BG
                if ch == " ":
                    fg, bd = cfg, cbd
                else:
                    fg, bd = fgs[x] or TEXT, bds[x]
                if fg != cfg or bg != cbg or bd != cbd:
                    codes = []
                    if bd != cbd:
                        codes.append("1" if bd else "22")
                    if fg != cfg:
                        codes.append("38;2;%d;%d;%d" % fg)
                    if bg != cbg:
                        codes.append("48;2;%d;%d;%d" % bg)
                    parts.append("\x1b[" + ";".join(codes) + "m")
                    cfg, cbg, cbd = fg, bg, bd
                parts.append(ch)
            out.append("".join(parts) + "\x1b[0m")
        return out


def bar(c, x, y, w, frac, color, alpha=1.0):
    """Progress bar: the gradient fill ends in a 1/8-cell edge and lies in a dim full-height trough."""
    filled = clamp01(frac) * w
    full = int(filled)
    for i in range(w):
        if i < full:
            c.put(x + i, y, "█", color(i), alpha=alpha)
        elif i == full:
            c.put(x + i, y, " ▏▎▍▌▋▊▉"[int((filled - i) * 8)], color(i), bg=TRACK, alpha=alpha)
        else:
            c.put(x + i, y, " ", bg=TRACK, alpha=alpha)


KEY_RE = re.compile(r"(?<!\S)(↑↓|←→|[↑↓←→]|Enter|Esc|Space|Ctrl\+\]|стрелки|[A-Za-z])(?=\s)")


def keyline(c, y, text, col=DIM, key=TEXT, alpha=1.0, x=None, bg=None):
    """A line of key hints (centred unless x is given): the keys a step brighter than what they do."""
    if len(text) > c.w - 2:
        text = text[:c.w - 3] + "…"
    if x is None:
        x = (c.w - len(text)) // 2
    c.put(x, y, text, col, bg=bg, alpha=alpha)
    for m in KEY_RE.finditer(text):
        c.put(x + m.start(), y, m.group(), key, bg=bg, alpha=alpha)


def pill(c, x, y, w, color, accent, alpha=1.0):
    """Selection band: a bright edge on the left and a gradient that dissolves into the background over
    its last ten cells. It writes every cell of the band, so no star or aurora glyph ever shows inside."""
    for i in range(w):
        k = min(1.0, (w - i) / 10) ** 1.5
        c.put(x + i, y, " ", bg=lerp(BG, color(i), alpha * (0.15 + 0.85 * k)))
    c.put(x, y, "▌", accent, alpha=alpha)


def badge(c, x, y, text, col, alpha=1.0):
    """A small label: tinted background with half-block ends, text in the accent colour (len+2 cells)."""
    tint = lerp(BG, col, 0.24)
    c.put(x, y, "▐", tint, alpha=alpha)
    c.put(x + 1, y, text, col, bg=tint, bold=True, alpha=alpha)
    c.put(x + 1 + len(text), y, "▌", tint, alpha=alpha)


def term_size():
    try:
        return os.get_terminal_size(sys.stdout.fileno())
    except OSError:
        return os.terminal_size((120, 40))


class Screen:
    def __init__(self):
        self.size = term_size()
        self.canvas = Canvas(*self.size)
        self.alive = True

    def resize(self):
        self.size = term_size()
        self.canvas = Canvas(*self.size)

    def enter(self):
        self.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[2J")

    def leave(self):
        self.write("\x1b[0m\x1b[2J\x1b[?7h\x1b[?25h\x1b[?1049l")

    def write(self, s):
        if not engine.TERM_OK:
            return
        data = memoryview(s.encode())
        try:
            while data:
                data = data[os.write(1, data):]   # SIGWINCH can cut a blocked write short
        except OSError:
            engine.lost_terminal()

    def flush(self):
        c = self.canvas
        rows = c.rows()
        buf = ["\x1b[?2026h\x1b[0m"]
        for y, r in enumerate(rows):
            if c.prev[y] != r:
                buf.append(f"\x1b[{y + 1};1H{r}")
                c.prev[y] = r
        buf.append("\x1b[?2026l")
        if len(buf) > 2:
            self.write("".join(buf))
        c.clear()


# ───────────────────────────── input ─────────────────────────────

KEYS = {b"\x1b[A": "up", b"\x1bOA": "up", b"\x1b[B": "down", b"\x1bOB": "down", b"\x1b[C": "right",
        b"\x1bOC": "right", b"\x1b[D": "left", b"\x1bOD": "left", b"\x1b[5~": "pgup", b"\x1b[6~": "pgdn",
        b"\x1b[H": "home", b"\x1b[F": "end", b"\x1bOH": "home", b"\x1bOF": "end", b"\x1b[1~": "home",
        b"\x1b[4~": "end"}
CTRL = {0x0d: "enter", 0x0a: "enter", 0x7f: "bs", 0x08: "bs", 0x1d: "ctrl]", 0x03: "ctrl-c", 0x20: "space",
        0x09: "tab"}
ESC_SEQ = re.compile(rb"\x1b(?:\[[0-?]*[ -/]*[@-~]|O[ -~])")     # CSI ... final byte, or SS3 x
# The same key on the Russian layout (й is q): menu and game keys work whichever layout is on.
# Only for commands; text typed into an answer stays as typed.
LATIN = dict(zip("йцукенгшщзфывапролдячсмитьЙЦУКЕНГШЩЗФЫВАПРОЛДЯЧСМИТЬ",
                 "qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"))


def parse_keys(data):
    keys, i = [], 0
    while i < len(data):
        b = data[i]
        if b == 0x1b:
            m = ESC_SEQ.match(data, i)
            if m:                                   # known key, or unknown sequence: dropped, never 'esc'
                if m.group() in KEYS:
                    keys.append(KEYS[m.group()])
                i = m.end()
            elif i + 1 < len(data) and data[i + 1] != 0x1b:
                i += 2                              # Alt+key: dropped
            else:
                keys.append("esc")                  # lone Esc
                i += 1
            continue
        if b in CTRL:
            keys.append(CTRL[b])
            i += 1
            continue
        for n in (1, 2, 3, 4):                      # exactly one UTF-8 character
            try:
                keys.append(data[i:i + n].decode("utf-8"))
                i += n
                break
            except UnicodeDecodeError:
                pass
        else:
            i += 1                                  # invalid byte: dropped
    return keys


# ───────────────────────────── monitors ─────────────────────────────

UI_STATE = os.path.join(engine.STATE_DIR, "ui.json")


def ui_state():
    try:
        with open(UI_STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_ui_state(**kw):
    d = ui_state()
    d.update(kw)
    try:
        os.makedirs(engine.STATE_DIR, exist_ok=True)
        with open(UI_STATE, "w") as f:
            json.dump(d, f)
    except OSError:
        pass


def konsole_pid():
    """PID of the Konsole window the launcher opened for us (an ancestor konsole started with the
    ArchUpdate profile). Started by hand from another Konsole, we never move that window."""
    pid = os.getpid()
    for _ in range(8):
        try:
            with open(f"/proc/{pid}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            with open(f"/proc/{ppid}/comm") as f:
                if f.read().strip() == "konsole":
                    with open(f"/proc/{ppid}/cmdline", "rb") as fc:
                        return ppid if b"ArchUpdate" in fc.read().split(b"\0") else None
            pid = ppid
        except (OSError, ValueError, IndexError):
            return None
    return None


def monitor_count():
    try:
        d = json.loads(engine.run(["kscreen-doctor", "-j"], timeout=5) or "{}")
        return sum(1 for o in d.get("outputs", []) if o.get("enabled"))
    except ValueError:
        return 0


def primary_output():
    """KDE's primary monitor (priority 1 in kscreen)."""
    try:
        d = json.loads(engine.run(["kscreen-doctor", "-j"], timeout=5) or "{}")
        outs = [o for o in d.get("outputs", []) if o.get("enabled")]
        best = min(outs, key=lambda o: o.get("priority") or 99)
        return best["name"]
    except (ValueError, KeyError):
        return None


def active_output():
    return engine.run(["qdbus6", "org.kde.KWin", "/KWin", "org.kde.KWin.activeOutputName"], timeout=3).strip()


def kwin_move_window(pid, target=None, step=0):
    """Send the window of process `pid` to the output named `target`, or `step` outputs
    left (-1) / right (+1) in their left-to-right desk order. Uses a one-shot KWin script."""
    js = """
const ws = workspace.screens.slice().sort((a, b) => a.geometry.x - b.geometry.x || a.geometry.y - b.geometry.y);
const target = %s, step = %d;
for (const w of workspace.windowList()) {
    if (w.pid !== %d) continue;
    let t = null;
    if (target) t = ws.find(s => s.name === target);
    else {
        const i = ws.findIndex(s => s.name === w.output.name), j = i + step;
        if (i >= 0 && j >= 0 && j < ws.length) t = ws[j];
    }
    if (t && t.name !== w.output.name) workspace.sendClientToScreen(w, t);
}
""" % (json.dumps(target), step, pid)
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"arch-update-ui-move-{os.getpid()}.js")
    name = f"arch-update-ui-move-{os.getpid()}"
    try:
        with open(path, "w") as f:
            f.write(js)
        sid = engine.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", path, name],
                         timeout=3).strip()
        if sid.lstrip("-").isdigit() and int(sid) >= 0:
            engine.run(["qdbus6", "org.kde.KWin", f"/Scripting/Script{sid}", "org.kde.kwin.Script.run"], timeout=3)
            time.sleep(0.3)
        engine.run(["qdbus6", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name], timeout=3)
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


# ───────────────────────────── data ─────────────────────────────

def updater_version():
    """(short hash, date, subject) of this checkout of the updater, None outside git."""
    out = engine.run(["git", "-C", os.path.dirname(HERE), "log", "-1", "--format=%h%x09%cd%x09%s",
                      "--date=format:%d.%m.%Y"], timeout=3).strip().split("\t")
    return out if len(out) == 3 else None


def fetch(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": "arch-update-ui (by Cactus)"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def last_update_date():
    try:
        state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
        with open(os.path.join(state, "arch-update", "last_update_run")) as f:
            return f.read().strip()
    except OSError:
        return ""


def get_news():
    page = fetch("https://archlinux.org/news/")
    items = re.findall(r'<td>(\d{4}-\d{2}-\d{2})</td>\s*<td class="wrap"><a href="(/news/[^"]+)"[^>]*>([^<]+)</a>',
                       page)
    last = last_update_date()
    return [{"date": d, "url": "https://archlinux.org" + u, "title": html.unescape(t).strip(),
             "new": bool(last) and d >= last, "body": None} for d, u, t in items[:6]]


def html_to_text(s):
    s = re.sub(r"(?is)<(script|style).*?</\1>", "", s)
    s = re.sub(r"(?i)<br\s*/?>", "\n", s)
    s = re.sub(r"(?i)<li[^>]*>", "\n  • ", s)
    s = re.sub(r"(?i)</(p|div|pre|ul|ol|h\d)>", "\n\n", s)
    s = re.sub(r"(?s)<[^>]+>", "", s)
    s = html.unescape(s)
    return re.sub(r"\n{3,}", "\n\n", s).strip()


def get_article(url):
    page = fetch(url)
    m = re.search(r'<div class="article-content"[^>]*>(.*?)</div>\s*</div>', page, re.S)
    info = re.search(r'<p class="article-info">([^<]+)</p>', page)
    body = html_to_text(m.group(1)) if m else "Не удалось разобрать статью."
    return (html.unescape(info.group(1)).strip() if info else ""), body


MONTHS = ["янв", "фев", "мар", "апр", "мая", "июн", "июл", "авг", "сен", "окт", "ноя", "дек"]


def ru_date(d):
    try:
        y, m, dd = d.split("-")
        return f"{int(dd)} {MONTHS[int(m) - 1]}"
    except (ValueError, IndexError):
        return d


def fmt_dur(sec):
    sec = int(round(sec))
    if sec < 60:
        return f"{max(sec, 1)} с"
    m, s = divmod(sec, 60)
    if m < 10:
        return f"{m} мин {s:02d} с"
    return f"{m} мин"


def plural(n, one, few, many):
    n10, n100 = n % 10, n % 100
    if n10 == 1 and n100 != 11:
        return one
    if 2 <= n10 <= 4 and not 12 <= n100 <= 14:
        return few
    return many


# ───────────────────────────── settings: the update reports ─────────────────────────────

SETTINGS_ITEMS = (("reports", "Отчёты об обновлениях"), ("preview", "Что именно уходит"), ("back", "Назад"))
REPORT_ABOUT = ("После каждого обновления разработчику уходит отчёт: модель устройства, процессор, видеокарта, "
                "память, ядро, рабочий стол, как подключена сеть (Wi-Fi или кабель, адаптер, сигнал), какие "
                "пакеты обновились, итог проверки и журнал обновления.",
                "Имя пользователя и компьютера, пароли, адреса и название Wi-Fi не отправляются. Отчёты видит "
                "только разработчик (закрытый репозиторий на GitHub).")
PREVIEW_INTRO = "так выглядит отчёт с этой машины — последний отправленный или собранный сейчас из последнего журнала"
REPORTS_HINT = "новое: отчёты об обновлениях — в «Настройках» (по умолчанию выключены)"
REPORTS_UNDECIDED = {"enabled": False, "decided": False, "id": "", "endpoint": False, "waiting": 0,
                     "last_sent": "", "last_error": ""}
JSON_KEY = re.compile(r'\s*"(?:[^"\\]|\\.)*":')
UNPRINTABLE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def reports_parts(st):
    """What the quiet line under the reports switch says, from report.status()."""
    if not st["enabled"]:
        return ["сейчас ничего не собирается и не отправляется"]
    parts = [f"ID этой машины в отчётах: {st['id'] or '—'}"]
    if not st["endpoint"]:
        return parts + ["сервер для отчётов ещё не подключён — отчёты ждут на этой машине"
                        + (f": {st['waiting']}" if st["waiting"] else "")]
    m = re.match(r"\d{4}-(\d\d)-(\d\d)T(\d\d):(\d\d)", st["last_sent"] or "")
    if st["waiting"]:
        parts.append(f"ждут отправки: {st['waiting']}")
    elif m:
        parts.append("последний отчёт отправлен {1}.{0} {2}:{3}".format(*m.groups()))
    else:
        parts.append("первый отчёт уйдёт после следующего обновления")
    if st["last_error"]:
        err = " ".join(st["last_error"].split())
        parts.append("ошибка: " + (err if len(err) <= 48 else err[:47] + "…"))
    return parts


def wrap_parts(parts, width, rows=2):
    """Parts joined by " · " with the line breaks between them (inside one only when it is longer
    than a line), in at most `rows` lines: the last one keeps what fits and ends in "…"."""
    lines = []
    for part in parts:
        if lines and len(lines[-1]) + 3 + len(part) <= width:
            lines[-1] += " · " + part
        elif len(lines) >= rows:
            room = width - len(lines[-1]) - 3
            lines[-1] = lines[-1] + " · " + part[:room - 1] if room > 12 else lines[-1][:width - 1]
            lines[-1] += "…"
            break
        else:
            lines += textwrap.wrap(part, width, break_on_hyphens=False) or [""]
    if len(lines) > rows:                           # one part longer than the rows left for it
        lines = lines[:rows]
        lines[-1] = lines[-1][:width - 1] + "…"
    return lines


def preview_source(text):
    """report.preview() as lines to read: (kind, line). The fields as JSON, then the log line by line
    (inside the JSON the whole log is one string with \\n in it)."""
    try:
        data = json.loads(text)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return [("json", UNPRINTABLE.sub("?", line.expandtabs())) for line in text.split("\n")]
    log = data.pop("log", None)
    out = [("json", UNPRINTABLE.sub("?", line))           # JSON leaves U+0080…U+009F as they are
           for line in json.dumps(data, ensure_ascii=False, indent=1).split("\n")]
    if isinstance(log, str):
        rows = log.split("\n")
        if rows[-1] == "":
            rows.pop()
        n = len(rows)
        out += [("json", ""), ("rule", f'"log": журнал обновления, {n} {plural(n, "строка", "строки", "строк")}'
                               if n else '"log": пусто (журнала обновления на этой машине пока нет)')]
        out += [("log", UNPRINTABLE.sub("?", row.expandtabs())) for row in rows]
    return out


def wrap_source(src, width):
    """(kind, text, first) rows of the given width; a wrapped line goes on indented under itself."""
    out = []
    for kind, line in src:
        if len(line) <= width:
            out.append((kind, line, True))
            continue
        indent = " " * min(len(line) - len(line.lstrip(" ")) + 2, width // 2)
        parts = textwrap.wrap(line, width, subsequent_indent=indent, break_on_hyphens=False) or [line[:width]]
        out += [(kind, p, i == 0) for i, p in enumerate(parts)]
    return out


# ───────────────────────────── the app ─────────────────────────────

class App:
    def __init__(self, live=True):
        """live=False: no update check, news download or window placement (the self-test)."""
        self.s = Screen()
        self.t0 = time.time()
        self.state = "splash"
        self.repo, self.aur, self.check_failed = None, None, False
        self.news, self.news_err = None, None
        self.menu_sel = 0
        self.menu_t = None
        self.news_sel = 0
        self.article = None
        self.scroll = 0
        self.confirm = None
        self.resized = False
        self.quit = False
        self.kpid = konsole_pid() if live else None
        self.monitors = 0
        self.moving = False
        self.toast_text, self.toast_t, self.toast_secs = "", 0.0, 2.2
        self._risky = None
        self.live = live
        # The reports' state, read again only when the settings are open: never once per frame.
        self.rep, self.rep_t = (report.status() if live else dict(REPORTS_UNDECIDED)), time.time()
        self.hinted = False
        self.set_sel, self.set_key_t = 0, 0.0
        self.pv_open, self.pv_scroll, self.pv_page = False, 0, 10      # "Что именно уходит"
        self.pv_gen, self.pv_data, self.pv_busy, self.pv_wrap = 0, None, None, None
        bat = engine.battery() if live else None
        self.low_battery = bat[0] if bat and bat[1] and bat[0] < 30 else None
        self.version = updater_version() if live else None
        if self.kpid and "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            threading.Thread(target=self._find_monitors, daemon=True).start()
        if live:
            threading.Thread(target=self._load_updates, daemon=True).start()
            threading.Thread(target=self._load_news, daemon=True).start()

    # data loading
    def _load_updates(self):
        if DEMO:
            time.sleep(1.4)
            self.repo = [("mesa", "1:26.2.5-1", "1:26.2.6-1"), ("linux-firmware", "20260916-1", "20261014-1"),
                         ("qt6-base", "6.12.0-3", "6.12.1-1"), ("plasma-workspace", "6.8.0-1", "6.8.1-1"),
                         ("kwin", "6.8.0-1", "6.8.1-1"), ("python-pip", "26.2.2-1", "26.2.3-1"),
                         ("ffmpeg", "2:9.0.2-2", "2:9.0.3-1"), ("pipewire", "1:1.6.9-1", "1:1.6.10-1")]
            self.aur = [("brave-bin", "1:1.97.59-1", "1:1.97.60-1")]
            self.risky_pkgs()
            return
        repo, aur, failed = engine.check_updates()
        self.risky_pkgs()                    # dkms status: here, not in the first menu frame
        self.repo, self.aur, self.check_failed = repo, aur, failed

    def _find_monitors(self):
        self.monitors = monitor_count()
        if self.monitors > 1:
            self._restore_monitor()

    def _restore_monitor(self):
        """Open on the primary (central) monitor. Konsole's window may not exist yet when we start,
        so the move is repeated a few times (it does nothing once the window is already there)."""
        target = primary_output()
        if not target:
            return
        for delay in (0.15, 0.5, 1.0, 2.0):
            time.sleep(delay)
            kwin_move_window(self.kpid, target=target)

    def move_screen(self, direction):
        """← / →: our window to the neighbouring monitor; remembered for next time."""
        if self.monitors < 2 or self.moving:
            return
        self.moving = True

        def work():
            try:
                before = active_output()
                kwin_move_window(self.kpid, step=-1 if direction == "left" else 1)
                time.sleep(0.5)
                after = active_output()
                if after and after != before:
                    self.toast(f"монитор: {after}")
                else:
                    self.toast("это крайний монитор")
            finally:
                self.moving = False
        threading.Thread(target=work, daemon=True).start()

    def toast(self, text, secs=2.2):
        self.toast_text, self.toast_t, self.toast_secs = text, time.time(), secs

    def draw_toast(self):
        if not self.toast_text:
            return
        age = time.time() - self.toast_t
        if age > self.toast_secs:
            self.toast_text = ""
            return
        a = clamp01(age / 0.2) * clamp01((self.toast_secs - age) / 0.6)
        c, t = self.s.canvas, self.now()
        text = f"  ◂  {self.toast_text}  ▸  "
        if len(text) > c.w - 2:                    # a narrow terminal: the arrows go before any words
            text = f"  {self.toast_text}  "
        if len(text) > c.w - 2:
            text = text[:c.w - 4] + "… "
        x0, y = (c.w - len(text)) // 2, c.h - 4
        for i, ch in enumerate(text):
            c.put(x0 + i, y, ch, (255, 255, 255), bg=shade(grad(PAL_ARCH, i / len(text) * 0.6 - t * 0.2), 0.55),
                  bold=True, alpha=a)

    def hint(self, *parts):
        """Footer with the ←→ monitor hint when there is more than one monitor."""
        if self.monitors > 1:
            last = parts[-1:] if parts and parts[-1] == "q выход" else ()
            parts = parts[:len(parts) - len(last)] + ("←→ монитор",) + last
        self.footer("   ".join(parts))

    def _load_news(self):
        try:
            self.news = get_news()
        except Exception as e:      # network down etc.
            self.news, self.news_err = [], str(e)

    def _load_article(self, item):
        try:
            item["info"], item["body"] = get_article(item["url"])
        except Exception as e:
            item["info"], item["body"] = "", f"Не удалось загрузить статью: {e}"

    @property
    def loaded(self):
        return self.repo is not None and self.news is not None

    @property
    def count(self):
        return len(self.repo or []) + len(self.aur or [])

    def risky_pkgs(self):
        """Packages after which the screen may freeze for a while: the NVIDIA driver, or a kernel
        while the NVIDIA DKMS module has to be rebuilt for it."""
        if self._risky is None:
            kernels = set(engine.kernel_packages()) if "nvidia" in engine.dkms_built() else set()
            self._risky = lambda n: bool(engine.NVIDIA_PKGS.match(n)) or n in kernels
        return self._risky

    @property
    def kernel_gpu(self):
        risky = self.risky_pkgs()
        return [n for n, *_ in (self.repo or []) if risky(n)]

    def menu_items(self):
        if self.count:
            items = [("auto", "Обновить автоматически", "сам отвечу на вопросы, позову тебя только если важно"),
                     ("manual", "Обычный Arch-Update", "отвечаешь на вопросы сам")]
        else:
            items = [("recheck", "Проверить ещё раз", "вдруг что-то вышло"),
                     ("manual", "Обычный Arch-Update", "запустить как есть")]
        if self.news:
            items.append(("news", "Читать новости Arch", f"{len(self.news)} последних"))
        word = "вкл" if self.rep["enabled"] else "выкл" if self.rep["decided"] else "не выбраны"
        items.append(("settings", "Настройки", f"отчёты об обновлениях: {word}"))
        items.append(("quit", "Выйти", ""))
        return items

    # ── drawing helpers
    def now(self):
        return time.time() - self.t0

    def draw_title(self, top, t, pal=PAL_ARCH, reveal_t=None, blend=None, alpha=1.0):
        c = self.s.canvas
        word = "ARCH UPDATE" if c.w >= 92 else "ARCH"
        rows, spans = big_text(word)
        width = len(rows[0])
        x0 = (c.w - width) // 2
        for li, (a, b) in enumerate(spans):
            if reveal_t is not None:
                a_t = clamp01((reveal_t - 0.07 * li) / 0.35)
                if a_t <= 0:
                    continue
                dy = -int(round((1 - ease(a_t)) * 2))
            else:
                a_t, dy = 1.0, 0
            for ry in range(6):
                seg = rows[ry][a:b]
                for i, ch in enumerate(seg):
                    if ch == " ":
                        continue
                    x = a + i
                    pos = x / max(1, width) * 0.85 + ry * 0.035 - t * 0.12
                    col = grad(pal, pos)
                    if blend is not None:                      # transition wave to another palette
                        k = blend(x0 + x, top + ry)
                        col = lerp(col, grad(PAL_RUN, pos), k)
                    if ch in SHADOW_CHARS:
                        col = shade(col, 0.45)
                    c.put(x0 + x, top + ry + dy, ch, col, bold=ch not in SHADOW_CHARS, alpha=a_t * alpha)
        if word == "ARCH" and c.h > top + 8:
            c.cput(top + 6, "U P D A T E", grad(pal, -t * 0.12), bold=True, alpha=alpha)
        return top + 6 if word == "ARCH" else top + 5     # the one-line title has no "U P D A T E" row

    def byline(self, y, t, start):
        c = self.s.canvas
        text = "by Cactus"
        x0 = (c.w - len(text)) // 2
        for i, ch in enumerate(text):
            a = clamp01((t - start - 0.06 * i) / 0.3)
            if a > 0:
                c.put(x0 + i, y, ch, grad(PAL_ARCH, 0.55 + i * 0.03 - t * 0.05), alpha=a * 0.9)

    def spinner(self, t):
        return "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[int(t * 12) % 10]

    def footer(self, text):
        keyline(self.s.canvas, self.s.canvas.h - 2, text)

    # ── screens
    def draw_splash(self):
        c, t = self.s.canvas, self.now()
        top = max(1, c.h // 2 - 9)
        y = self.draw_title(top, t, reveal_t=t)
        self.byline(y + 1, t, 0.9)
        y += 4
        tasks = [("проверяю обновления", self.repo is not None,
                  (f"найдено {self.count} {plural(self.count, 'обновление', 'обновления', 'обновлений')}"
                   if self.count else ("не удалось проверить" if self.check_failed else "система актуальна"))
                  if self.repo is not None else ""),
                 ("загружаю новости Arch", self.news is not None,
                  (f"{len(self.news)} новостей" if self.news else "нет связи с archlinux.org")
                  if self.news is not None else "")]
        tx = (c.w - max(len(label) + 4 for label, _, _ in tasks)) // 2     # one left edge: icons in a column
        for i, (label, done, result) in enumerate(tasks):
            a = clamp01((t - 1.2 - i * 0.15) / 0.4)
            if a <= 0:
                continue
            line = f"{'✓' if done else self.spinner(t + i)}  {result if done else label + '…'}"
            col = GOOD if done else grad(PAL_ARCH, t * 0.3 + i * 0.2)
            c.put(tx, y + i, line, col, alpha=a)
        news_ready = self.news is not None or t > 5.0      # slow archlinux.org: news fills in on the menu
        if self.repo is not None and news_ready and t > 2.0:
            self.state, self.menu_t, self.from_splash = "menu", time.time(), True
            self.announce_version()
            self.announce_reports()
        elif self.repo is None and t > 15:
            keyline(c, c.h - 2, "проверка затянулась · Enter — обычный Arch-Update без проверки · q — выход")
        elif t > 1.5:
            self.hint("q выход")
        BACKDROP.draw(c, t, PAL_ARCH, clamp01(t / 1.5))     # after the content: only into empty cells
        self.draw_toast()

    def announce_version(self):
        """First start of a new version of the updater (it updates itself from GitHub): say so."""
        if not self.version:
            return
        seen = ui_state().get("version")
        if seen != self.version[0]:
            save_ui_state(version=self.version[0])
            if seen:
                self.toast(f"апдейтер обновился: {self.version[2]}", secs=5)

    def announce_reports(self):
        """Once, for a user who has never chosen: the reports exist, and they are off until a yes.
        Never on top of another toast (the new version's): then on a later start."""
        if self.hinted or self.rep["decided"]:
            return
        self.hinted = True
        if (self.toast_text and time.time() - self.toast_t < self.toast_secs) or ui_state().get("reports_hint"):
            return
        save_ui_state(reports_hint=True)
        self.toast(REPORTS_HINT, secs=6)

    def draw_version(self):
        if self.version:
            c = self.s.canvas
            text = f"{self.version[1]} · {self.version[0]}"
            c.put(c.w - len(text) - 2, c.h - 1, text, MUTED)

    def menu_layout(self):
        """Sizes of the menu blocks. On a low terminal (a laptop) they shrink step by step —
        one-line menu items, fewer news and packages, a one-line title — until all of it fits."""
        c = self.s.canvas
        L = types.SimpleNamespace(W=min(c.w - 8, 96), big_title=True, menu_subs=True,
                                  news_rows=min(3, len(self.news or [])), pkg_rows=0)
        L.colw = 46 if L.W >= 92 else L.W
        L.ncol = max(1, L.W // L.colw)
        pk, items = self.count, len(self.menu_items())
        if pk:
            L.pkg_rows = min((pk + L.ncol - 1) // L.ncol, max(3, min(8, c.h - 32)))

        def measure():
            L.title_h = (10 if c.w < 92 else 9) if L.big_title else 3
            L.news_h = (2 + L.news_rows if L.news_rows else 0) if self.news else 2
            if pk:
                L.upd_h = 1 + L.pkg_rows + (1 if pk > L.pkg_rows * L.ncol else 0) + (1 if self.check_failed else 0) + 1
            else:
                L.upd_h = 4
            nw = bool(self.kernel_gpu) + (self.low_battery is not None)
            L.warn_h = nw + 1 if nw else 0                   # warnings stacked, one blank row below
            L.menu_h = 1 + (2 * items if L.menu_subs else items + 1)
            return L.title_h + L.news_h + L.upd_h + L.warn_h + L.menu_h
        shrink = [("menu_subs", False), ("news_rows", min(L.news_rows, 1)), ("pkg_rows", min(L.pkg_rows, 2)),
                  ("big_title", False), ("news_rows", 0), ("pkg_rows", min(L.pkg_rows, 1))]
        L.total = measure()
        while L.total > c.h - 4 and shrink:                  # a free row above the footer
            setattr(L, *shrink.pop(0))
            L.total = measure()
        return L

    def title_top(self):
        return 1 + max(0, (self.s.canvas.h - 4 - self.menu_layout().total) // 2)

    def draw_small_title(self, y, t, pal=PAL_ARCH, alpha=1.0):
        """The title in one line, for terminals too low for the big letters."""
        c = self.s.canvas
        head = "A R C H   U P D A T E"
        hx = (c.w - len(head)) // 2
        for i, ch in enumerate(head):
            c.put(hx + i, y, ch, grad(pal, i / len(head) * 0.7 - t * 0.12), bold=True, alpha=alpha)

    def draw_menu(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10    # colour flow at 10 fps: cheaper frames
        mt = time.time() - self.menu_t
        L = self.menu_layout()
        W = L.W
        x0 = (c.w - W) // 2
        target = self.title_top()
        if L.big_title:
            top = target
            if mt < 0.6 and getattr(self, "from_splash", False):      # glide up from the splash position
                top = round(max(1, c.h // 2 - 9) + (target - max(1, c.h // 2 - 9)) * ease(mt / 0.6))
            y = self.draw_title(top, t)
            self.byline(y + 1, t, -1)
        else:
            self.draw_small_title(target, t)
            self.byline(target + 1, t, -1)
        y = target + L.title_h

        def appear(i):
            return clamp01((mt - 0.35 - i * 0.06) / 0.35)

        # news
        k = 0
        if self.news and L.news_rows:
            a = appear(k); k += 1
            c.put(x0, y, "НОВОСТИ ARCH", grad(PAL_ARCH, 0.1 - t * 0.05), bold=True, alpha=a)
            c.put(x0 + 13, y, "─" * (W - 13), FAINT, alpha=a)
            y += 1
            for item in self.news[:L.news_rows]:
                a = appear(k); k += 1
                date = ru_date(item["date"]).ljust(7)
                title = item["title"]
                room = W - 9 - (6 if item["new"] else 0)
                if len(title) > room:
                    title = title[:room - 1] + "…"
                c.put(x0, y, "●", PINK if item["new"] else DIM, alpha=a)
                c.put(x0 + 2, y, date, DIM, alpha=a)
                c.put(x0 + 9, y, title, TEXT, alpha=a)
                if item["new"]:
                    badge(c, x0 + W - 5, y, "NEW", PINK, alpha=a)
                y += 1
            y += 1
        elif self.news_err:
            c.put(x0, y, "новости недоступны (нет связи с archlinux.org)", DIM, alpha=appear(0))
            y += 2
        elif self.news is None:
            c.put(x0, y, self.spinner(t) + "  загружаю новости Arch…", DIM, alpha=appear(0))
            y += 2

        # updates
        a = appear(k); k += 1
        label = f"ОБНОВЛЕНИЯ · {self.count}" if self.count else "ОБНОВЛЕНИЯ"
        c.put(x0, y, label, grad(PAL_ARCH, 0.3 - t * 0.05), bold=True, alpha=a)
        c.put(x0 + len(label) + 1, y, "─" * (W - len(label) - 1), FAINT, alpha=a)
        y += 1
        if not self.count:
            a = appear(k); k += 1
            msg = "Не удалось проверить обновления (нет сети или зеркало не отвечает)" if self.check_failed \
                else "✓  Система актуальна"
            c.cput(y + 1, msg, WARN if self.check_failed else GOOD, bold=True, alpha=a)
            y += 3
        else:
            pkgs = [(n, o, nw, False) for n, o, nw in self.repo] + [(n, o, nw, True) for n, o, nw in self.aur]
            colw, ncol = L.colw, L.ncol
            shown = pkgs[:L.pkg_rows * ncol]
            risky = set(self.kernel_gpu)
            for i, (n, o, nw, is_aur) in enumerate(shown):
                a = appear(k + i // ncol)
                cx, cy = x0 + (i % ncol) * colw, y + i // ncol
                name = n if len(n) <= 24 else n[:23] + "…"
                ver = nw if len(nw) <= colw - 28 else nw[:colw - 29] + "…"
                c.put(cx, cy, "aur" if is_aur else " • ", PINK if is_aur else DIM, alpha=a)
                c.put(cx + 4, cy, name, TEXT, bold=n in risky, alpha=a)
                c.put(cx + 5 + len(name), cy, ver, DIM, alpha=a)
            rows_used = (len(shown) + ncol - 1) // ncol
            k += rows_used
            y += rows_used
            if len(pkgs) > len(shown):
                c.put(x0 + 4, y, f"+ ещё {len(pkgs) - len(shown)}", DIM, alpha=appear(k))
                y += 1
            if self.check_failed:
                c.put(x0 + 4, y, "часть проверки не удалась — список может быть неполным", WARN, alpha=appear(k))
                y += 1
            y += 1
        if self.kernel_gpu:
            a = appear(k); k += 1
            c.put(x0, y, "⚠", WARN, bold=True, alpha=a)
            msg = "в обновлении ядро/NVIDIA: перед запуском сохрани работу — экран может подвиснуть"
            if len(msg) > W - 2:
                msg = "ядро/NVIDIA: сохрани работу — экран может подвиснуть"[:W - 2]
            c.put(x0 + 2, y, msg, WARN, alpha=a)
            y += 1
        if self.low_battery is not None:
            a = appear(k); k += 1
            c.put(x0, y, "⚠", WARN, bold=True, alpha=a)
            c.put(x0 + 2, y, f"батарея {self.low_battery}% — подключи зарядку, обновление может идти долго"[:W - 2],
                  WARN, alpha=a)
            y += 1
        if self.kernel_gpu or self.low_battery is not None:
            y += 1

        # menu: a gradient pill under the selected item
        y += 1
        items = self.menu_items()
        mw = min(W, 60)
        mx = (c.w - mw) // 2
        for i, (key, title, sub) in enumerate(items):
            a = appear(k + i)
            sel = i == self.menu_sel
            if sel:
                pill(c, mx, y, mw, lambda xx: shade(grad(PAL_ARCH, xx / mw * 0.6 - t * 0.1), 0.5),
                     grad(PAL_ARCH, -t * 0.1), a)
                c.put(mx + 2, y, "▸ " + title, (255, 255, 255), bold=True, alpha=a)
                if sub:
                    c.put(mx + 4, y + 1, sub[:mw - 4], DIM, alpha=a)
            else:
                c.put(mx + 4, y, title, TEXT, alpha=a * 0.9)
                if sub and L.menu_subs:
                    c.put(mx + 4, y + 1, sub[:mw - 4], MUTED, alpha=a)
            y += 2 if L.menu_subs or sel else 1     # compact: only the chosen item explains itself
        self.hint("↑↓ выбор", "Enter запуск", "q выход")
        self.draw_version()
        BACKDROP.draw(c, t, PAL_ARCH)                       # after the content, before toast and modal
        self.draw_toast()
        if self.confirm:
            self.draw_modal("Ядро или драйвер NVIDIA",
                            ["В этом обновлении: " + ", ".join(self.kernel_gpu[:4]),
                             "Сохрани работу и закрой важные программы: пока собирается",
                             "драйвер (DKMS), экран может подвиснуть. Не перезагружайся,",
                             "пока не увидишь итог."], "Enter — продолжить    Esc — назад", PAL_WARN)

    def draw_modal(self, title, lines, hint, pal, input_text=None):
        c, t = self.s.canvas, self.now()
        c.dim(0.72)
        w = min(c.w - 6, max(52, max(len(l) for l in lines) + 8))
        h = len(lines) + (6 if input_text is not None else 4)       # the answer field gets a blank row below
        x0, y0 = (c.w - w) // 2, (c.h - h) // 2
        border = grad(pal, -t * 0.25)
        c.blank(x0, y0, w, h, hexrgb("#121726"))
        c.put(x0, y0, "╭" + "─" * (w - 2) + "╮", border, bg=hexrgb("#121726"))
        c.put(x0, y0 + h - 1, "╰" + "─" * (w - 2) + "╯", border, bg=hexrgb("#121726"))
        for yy in range(y0 + 1, y0 + h - 1):
            c.put(x0, yy, "│", border, bg=hexrgb("#121726"))
            c.put(x0 + w - 1, yy, "│", border, bg=hexrgb("#121726"))
        c.put(x0 + 3, y0, f" {title} ", grad(pal, 0.2 - t * 0.2), bg=hexrgb("#121726"), bold=True)
        for i, l in enumerate(lines):
            c.put(x0 + 3, y0 + 1 + i, l, TEXT, bg=hexrgb("#121726"))
        yy = y0 + 1 + len(lines)
        if input_text is not None:
            cur = "█" if int(t * 2) % 2 == 0 else " "
            field = hexrgb("#1b2235")                                 # the answer sits in a field
            c.fill_bg(x0 + 2, yy + 1, w - 4, field)
            c.put(x0 + 3, yy + 1, ("› " + input_text + cur)[-(w - 6):], (255, 255, 255), bg=field, bold=True)
        keyline(c, y0 + h - 2, hint, x=x0 + 3, bg=hexrgb("#121726"))

    def draw_news(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10
        W = min(c.w - 8, 100)
        x0 = (c.w - W) // 2
        if self.article is None:
            c.cput(2, "НОВОСТИ ARCH", grad(PAL_ARCH, -t * 0.1), bold=True)
            y = 4
            for i, item in enumerate(self.news):
                sel = i == self.news_sel
                if sel:
                    pill(c, x0, y, W, lambda xx: shade(grad(PAL_ARCH, xx / W * 0.5 - t * 0.1), 0.45),
                         grad(PAL_ARCH, -t * 0.1))
                tag = "  NEW" if item["new"] else ""
                title = item["title"]
                if len(title) > W - 14 - len(tag):
                    title = title[:W - 15 - len(tag)] + "…"
                c.put(x0 + 1, y, ("▸ " if sel else "  ") + ru_date(item["date"]).ljust(7) + title,
                      (255, 255, 255) if sel else TEXT, bold=sel)
                if tag:
                    badge(c, x0 + W - 6, y, "NEW", PINK)
                y += 2
            self.hint("↑↓ выбор", "Enter читать", "Esc назад")
            self.draw_toast()
            return
        item = self.article
        c.cput(2, "НОВОСТИ ARCH", grad(PAL_ARCH, -t * 0.1), bold=True)
        title_lines = textwrap.wrap(item["title"], max(10, W))
        y = 4
        for tl in title_lines:
            c.cput(y, tl, grad(PAL_ARCH, 0.2 - t * 0.08), bold=True)
            y += 1
        if item.get("info"):
            c.cput(y, item["info"], DIM)
        y += 2
        if item["body"] is None:
            c.cput(y + 2, self.spinner(t) + "  загружаю статью…", grad(PAL_ARCH, t * 0.3))
        else:
            body = []
            for para in item["body"].split("\n"):
                body += textwrap.wrap(para, max(10, W)) or [""]
            view_h = c.h - y - 4
            self.scroll = max(0, min(self.scroll, len(body) - view_h))
            for i, line in enumerate(body[self.scroll:self.scroll + view_h]):
                c.put(x0, y + i, line, TEXT)
            if len(body) > view_h:
                c.put(x0 + W + 2, y, "▲" if self.scroll else " ", DIM)
                c.put(x0 + W + 2, y + view_h - 1, "▼" if self.scroll + view_h < len(body) else " ", DIM)
        self.footer("↑↓ прокрутка   ←→ страница   Esc назад")       # here ←→ page, never move the window
        self.draw_toast()

    # ── settings
    def open_settings(self):
        self.state, self.set_sel, self.pv_open = "settings", 0, False
        self.set_key_t = time.time()         # the Enter that opened the screen is no choice (see handle)
        self.pv_gen += 1                     # the preview is put together once per visit
        self.refresh_reports()

    def refresh_reports(self):
        if self.live:
            self.rep = report.status()
        self.rep_t = time.time()

    def toggle_reports(self):
        on, waiting = not self.rep["enabled"], self.rep["waiting"]
        try:
            report.set_consent(on)           # off also drops what was still waiting to be sent
        except OSError as e:
            self.toast(f"не удалось сохранить: {e.strerror or e}", secs=4)
            return
        self.refresh_reports()
        self.pv_gen += 1                     # the preview carries this machine's ID only while on
        self.toast("спасибо! отчёт уйдёт после следующего обновления" if on else
                   "отчёты выключены" + (", неотправленные удалены" if waiting else ""), secs=3)

    def _load_preview(self, gen):
        try:
            src = preview_source(report.preview())
        except Exception as e:               # whatever went wrong, the screen says it instead of waiting
            src = [("json", f"не удалось собрать отчёт: {e!r}")]
        self.pv_data = (gen, src)

    def preview_rows(self, width):
        """The preview wrapped to the width, or None while it is being put together (in a thread
        of its own: the device, pacman and the whole log take a moment on a slow machine)."""
        data = self.pv_data
        if data is None or data[0] != self.pv_gen:
            if self.live and self.pv_busy != self.pv_gen:
                self.pv_busy = self.pv_gen
                threading.Thread(target=self._load_preview, args=(self.pv_gen,), daemon=True).start()
            return None
        if not self.pv_wrap or self.pv_wrap[:2] != (data[0], width):
            self.pv_wrap = (data[0], width, wrap_source(data[1], width))     # once per visit and width
        return self.pv_wrap[2]

    def draw_settings(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10
        if self.live and time.time() - self.rep_t > 2:      # a sender may have finished meanwhile
            self.refresh_reports()
        W = min(c.w - 8, 100)
        x0 = (c.w - W) // 2
        c.cput(2, "НАСТРОЙКИ", grad(PAL_ARCH, -t * 0.1), bold=True)
        if self.pv_open:
            return self.draw_preview(c, t, W, x0)
        y = 4
        for i, (key, title) in enumerate(SETTINGS_ITEMS):
            sel = i == self.set_sel
            if sel:
                pill(c, x0, y, W, lambda xx: shade(grad(PAL_ARCH, xx / W * 0.5 - t * 0.1), 0.45),
                     grad(PAL_ARCH, -t * 0.1))
            c.put(x0 + 1, y, ("▸ " if sel else "  ") + title, (255, 255, 255) if sel else TEXT, bold=sel)
            if key == "reports":
                word = "ВКЛ" if self.rep["enabled"] else "ВЫКЛ"
                badge(c, x0 + W - len(word) - 3, y, word, GOOD if self.rep["enabled"] else DIM)
                for para in REPORT_ABOUT:
                    for line in textwrap.wrap(para, W - 4):
                        y += 1
                        c.put(x0 + 3, y, line, DIM)
                for j, line in enumerate(wrap_parts(reports_parts(self.rep), W - 4)):
                    c.put(x0 + 3, y + 2 + j, line, MUTED)
                y += 3                       # two rows for it either way: the items below never jump
            y += 2
        self.hint("↑↓ выбор", "Enter переключить/открыть", "Esc назад")
        BACKDROP.draw(c, t, PAL_ARCH)        # after the content, before the toast
        self.draw_toast()

    def draw_preview(self, c, t, W, x0):
        """What a report from this machine holds, laid out like a news article."""
        c.cput(4, "Что именно уходит", grad(PAL_ARCH, 0.2 - t * 0.08), bold=True)
        y = 5
        for line in textwrap.wrap(PREVIEW_INTRO, W):
            c.cput(y, line, DIM)
            y += 1
        y += 1
        view_h = max(1, c.h - y - 4)
        self.pv_page = max(1, view_h - 2)
        rows = self.preview_rows(W)
        if rows is None:
            c.cput(y + 2, self.spinner(t) + "  собираю…", grad(PAL_ARCH, t * 0.3))
        else:
            self.pv_scroll = max(0, min(self.pv_scroll, len(rows) - view_h))
            c.blank(x0, y, W, view_h, BG)    # the text column stays clear of stars
            for i, (kind, text, first) in enumerate(rows[self.pv_scroll:self.pv_scroll + view_h]):
                if kind == "rule":
                    c.put(x0, y + i, "─" * W, FAINT, bg=BG)
                    c.put(x0 + 2, y + i, f" {text} ", MUTED, bg=BG)
                    continue
                c.put(x0, y + i, text, TEXT, bg=BG)
                m = JSON_KEY.match(text) if kind == "json" and first else None
                if m:
                    c.put(x0, y + i, m.group(), DIM, bg=BG)
            if len(rows) > view_h:
                c.put(x0 + W + 2, y, "▲" if self.pv_scroll else " ", DIM)
                c.put(x0 + W + 2, y + view_h - 1, "▼" if self.pv_scroll + view_h < len(rows) else " ", DIM)
                pos = f"{self.pv_scroll + 1}–{min(len(rows), self.pv_scroll + view_h)} из {len(rows)}"
                c.put(x0 + W - len(pos), y + view_h, pos, MUTED)
        self.footer("↑↓ прокрутка   ←→ страница   Esc назад")       # here ←→ page, never move the window
        BACKDROP.draw(c, t, PAL_ARCH)
        self.draw_toast()

    # ── input
    def handle(self, key):
        key = LATIN.get(key, key)
        if key in ("left", "right") and not self.confirm and self.monitors > 1 and \
                not (self.state == "news" and self.article is not None) and \
                not (self.state == "settings" and self.pv_open):
            self.move_screen(key)
            return None
        if self.state == "splash":
            if key in ("q", "esc"):
                self.quit = True
            elif key == "enter" and self.repo is None and self.now() > 15:
                return "manual"
            return None
        if self.state == "menu":
            items = self.menu_items()
            if self.confirm:
                if key == "enter":
                    if time.time() - self.confirm > 0.8:     # a fresh press after a pause is consent
                        self.confirm = None
                        return "auto"
                    self.confirm = time.time()               # held/double Enter: keep waiting
                if key in ("esc", "q"):
                    self.confirm = None
                return None
            if key in ("up", "k"):
                self.menu_sel = (self.menu_sel - 1) % len(items)
            elif key in ("down", "j", "tab"):
                self.menu_sel = (self.menu_sel + 1) % len(items)
            elif len(key) == 1 and key in "123456789" and int(key) <= len(items):
                self.menu_sel = int(key) - 1
                return self.handle("enter")
            elif key in ("q", "esc"):
                return "quit"
            elif key == "enter":
                action = items[self.menu_sel][0]
                if action == "auto" and self.kernel_gpu:
                    self.confirm = time.time()
                    return None
                if action == "news":
                    self.state, self.news_sel, self.article = "news", 0, None
                    return None
                if action == "settings":
                    self.open_settings()
                    return None
                if action == "recheck":
                    self.repo, self.state, self.t0 = None, "splash", time.time() - 2.0
                    threading.Thread(target=self._load_updates, daemon=True).start()
                    return None
                return action
            return None
        if self.state == "news":
            if self.article is None:
                if key in ("up", "k"):
                    self.news_sel = (self.news_sel - 1) % len(self.news)
                elif key in ("down", "j"):
                    self.news_sel = (self.news_sel + 1) % len(self.news)
                elif key == "enter":
                    self.article, self.scroll = self.news[self.news_sel], 0
                    if self.article["body"] is None:
                        threading.Thread(target=self._load_article, args=(self.article,), daemon=True).start()
                elif key in ("esc", "q"):
                    self.state, self.menu_t = "menu", time.time() - 5
            else:
                if key in ("up", "k"):
                    self.scroll = max(0, self.scroll - 1)
                elif key in ("down", "j", "space"):
                    self.scroll += 1
                elif key in ("pgup", "left"):
                    self.scroll = max(0, self.scroll - 10)
                elif key in ("pgdn", "right"):
                    self.scroll += 10
                elif key in ("esc", "q", "enter"):
                    self.article = None
            return None
        if self.state == "settings":
            if self.pv_open:
                if key in ("up", "k"):
                    self.pv_scroll = max(0, self.pv_scroll - 1)
                elif key in ("down", "j", "space"):
                    self.pv_scroll += 1
                elif key in ("pgup", "left"):
                    self.pv_scroll = max(0, self.pv_scroll - self.pv_page)
                elif key in ("pgdn", "right"):
                    self.pv_scroll += self.pv_page
                elif key in ("home", "end"):
                    self.pv_scroll = 0 if key == "home" else 1 << 30     # the next frame clamps it
                elif key in ("esc", "q", "enter"):
                    self.pv_open = False
                return None
            if key in ("up", "k"):
                self.set_sel = (self.set_sel - 1) % len(SETTINGS_ITEMS)
            elif key in ("down", "j", "tab"):
                self.set_sel = (self.set_sel + 1) % len(SETTINGS_ITEMS)
            elif key in ("enter", "space"):
                what = SETTINGS_ITEMS[self.set_sel][0]
                if what == "reports":
                    # As in the kernel/NVIDIA confirm, only a fresh press after a pause (longer than a
                    # held key waits before it repeats) is a choice: the Enter that opened this screen,
                    # pressed twice or held down, never flips the switch.
                    fresh, self.set_key_t = time.time() - self.set_key_t > 0.8, time.time()
                    if fresh:
                        self.toggle_reports()
                elif what == "preview":
                    self.pv_open, self.pv_scroll = True, 0
                else:
                    self.state, self.menu_t = "menu", time.time() - 5
            elif key in ("esc", "q"):
                self.state, self.menu_t = "menu", time.time() - 5
            return None
        return None

    def check_resize(self):
        """Window size changed: new canvas (full redraw) for the new size."""
        if self.resized:
            self.resized = False
            self.s.resize()
            self.s.write("\x1b[2J")

    def frame(self):
        t = time.perf_counter()
        self.check_resize()
        {"splash": self.draw_splash, "menu": self.draw_menu, "news": self.draw_news,
         "settings": self.draw_settings}[self.state]()
        self.s.flush()
        PACE.measure(time.perf_counter() - t)

    def loop(self):
        """Splash/menu/news/settings loop. Returns the chosen action."""
        while not self.quit:
            self.frame()
            if AUTOPLAY and self.state == "menu" and time.time() - self.menu_t > 3.5:
                return "auto"
            r = select.select([0], [], [], PACE.interval)[0]
            if r:
                try:
                    data = os.read(0, 1024)
                except OSError:
                    data = b""
                if not data:
                    return "quit"
                for key in parse_keys(data):
                    action = self.handle(key)
                    if action:
                        return action
        return "quit"


# ───────────────────────────── transition + live view ─────────────────────────────

class LiveView(engine.TerminalView):
    """Engine view for the auto mode: a compact animated dashboard."""
    animated = True

    def __init__(self, app, demo=False):
        super().__init__()
        self.app = app
        self.s = app.s
        hist = engine.History()
        if demo:
            hist.d.update({"sec_per_pkg": 0.75, "hooks_sec": 4.6, "dl_bps": 24e6, "cleanup_sec": 2.0,
                           "aur": {"brave-bin": 8.0}})
        self.prog = engine.Progress(len(app.repo or []), app.aur or [], hist)
        self.feed = []          # (time, text, kind)
        self.raw_tail = b""
        self.modal = None       # (why, line)
        self.input = ""
        self.raw = False
        self.eta_shown = None
        self.t_start = time.time()
        self.last_frame = 0
        self.demo = demo
        self.answers = 0
        self.lines = engine.Feed()
        self.game = None          # running mini-game
        self.hub = False          # game picker open
        self.hub_sel = 0
        self.update_done = False  # set when arch-update finished while a game is open
        self.best = ui_state().get("best", {})

    # engine hooks
    def output(self, data, *_):   # *_: an older engine, met mid-update, still passes its lines too
        self.raw_tail = (self.raw_tail + data)[-120_000:]
        if self.raw:
            self.out(data)
            return
        lines = self.lines.push(data)
        self.prog.feed_partial(self.lines.partial())
        for line in lines:
            msg = self.prog.feed_line(line)
            if msg:
                kind = "err" if re.match(r"^(error|warning)", msg, re.I) else "info"
                self.push(msg, kind)

    def push(self, text, kind="info"):
        if self.feed and self.feed[-1][1] == text:
            return
        self.feed.append((time.time(), text, kind))
        self.feed = self.feed[-40:]

    def message(self, msg, color=engine.C_DIM):
        if engine.LOG:
            engine.LOG.text(msg)
        if self.raw:
            super().message(msg, color)
        else:
            text = " ".join(msg.replace("[автоответчик]", "").split())
            if text:
                self.push(text, "warn")

    ANSWER_TEXT = {
        "proceed with update": "подтвердил обновление",
        "Arch news": "новости уже показаны — продолжаю",
        "pacman proceed": "подтвердил установку",
        "replace package": "подтвердил замену пакета",
        "import PGP key": "импортировал ключ PGP",
        "choose provider": "выбрал вариант по умолчанию",
        "choose group members": "выбрал вариант по умолчанию",
        "yay menu (default)": "yay: вариант по умолчанию",
        "yay proceed": "подтвердил сборку",
        "yay remove make deps": "сборочные зависимости уберу после сборки",
        "clean package cache": "чищу кэш пакетов",
        "remove orphan packages": "сирот не трогаю — посмотрим вместе",
        "process pacnew files": ".pacnew оставляю на потом",
        "reboot now": "перезагрузку не делаю",
        "restart services": "сервисы не перезапускаю",
        "remove unused flatpaks": "flatpak не трогаю",
        "another arch-update is running": "уже идёт другое обновление — отменяю",
    }

    def answered(self, label, line, answer):
        self.answers += 1
        if label in ("press enter to quit", "press enter to continue"):
            return
        text = self.ANSWER_TEXT.get(label)
        if not text:
            q = line if len(line) < 56 else line[:53] + "…"
            text = f"ответил «{answer}» — {q}"
        self.push(text, "auto")

    def handover(self, why, line):
        if self.raw:
            return super().handover(why, line)
        self.modal, self.input = (why, line), ""
        self.secret = bool(engine.RESPONDER and engine.RESPONDER.secret)
        self.bell()

    def handover_done(self):
        self.modal, self.input = None, ""

    def fallback(self, tb):
        self.go_raw("внутренняя ошибка интерфейса — дальше обычный вывод:\n" + tb)

    def go_raw(self, why):
        if self.raw:
            return
        self.raw = True
        self.s.leave()
        self.s.write("\x1b[2J\x1b[H")
        tail = self.raw_tail[-8000:]
        self.out(tail)
        super().message(f"\r\n[arch-update-ui] {why}\r\n", engine.C_YEL)

    def key(self, data):
        if self.raw:
            return data
        keys = parse_keys(data)
        if "ctrl]" in keys:
            self.go_raw("ручной режим: дальше полный вывод, отвечаешь сам.")
            return b"\x1d"
        if not self.modal and (self.game or self.hub):
            for k in keys:
                if k == "ctrl-c":
                    return b"\x03"
                self.game_key(k)
            return None
        if not self.modal:
            for k in ("left", "right"):
                if k in keys:
                    self.app.move_screen(k)
            if any(LATIN.get(k, k) in ("g", "G") for k in keys):
                self.hub, self.hub_sel = True, 0
                return None
        if self.modal:
            for k in keys:
                if k == "enter":
                    text, self.input = self.input, ""
                    return text.encode() + b"\r"
                if k == "bs":
                    self.input = self.input[:-1]
                elif k == "ctrl-c":
                    return b"\x03"
                elif k == "space":
                    self.input += " "
                elif len(k) == 1 and k.isprintable():
                    self.input += k
            return None
        if "ctrl-c" in keys:
            return b"\x03"
        return None

    # ── mini-games
    def game_key(self, k):
        k = LATIN.get(k, k)
        if self.hub:
            n = len(games.GAMES)
            if k in ("up", "k", "w"):
                self.hub_sel = (self.hub_sel - 1) % n
            elif k in ("down", "j", "s", "tab"):
                self.hub_sel = (self.hub_sel + 1) % n
            elif len(k) == 1 and k in "123456789"[:n]:
                self.hub_sel = int(k) - 1
                self.game_key("enter")
            elif k == "enter":
                self.game, self.hub = games.GAMES[self.hub_sel](), False
            elif k in ("esc", "q"):
                self.hub = False
            return
        if k == "esc":
            self.save_best()
            self.game.paused = True if hasattr(self.game, "paused") and not self.game.over else self.game.paused
            self.game, self.hub = None, False      # back to the dashboard (G starts a new game)
            return
        self.game.key(k)
        if self.game.over:
            self.save_best()

    def save_best(self):
        g = self.game
        if g and g.score > self.best.get(g.name, 0):
            self.best[g.name] = g.score
            save_ui_state(best=self.best)

    def play_after(self):
        """arch-update finished while a game is open: let the player finish, then show the summary."""
        self.update_done = True
        while (self.game or self.hub) and engine.TERM_OK:
            self.tick()
            if select.select([0], [], [], PACE.interval)[0]:
                try:
                    data = os.read(0, 1024)
                except OSError:
                    return
                if not data:
                    return
                for k in parse_keys(data):
                    self.game_key(k)
        self.save_best()

    def tick(self):
        if self.raw or not engine.TERM_OK:
            return
        now = time.time()
        if AUTOPLAY and not self.modal:          # demo showcase: play a little Tetris by itself
            if not self.game and now - self.t_start > 4:
                self.game = games.Tetris()
            elif self.game and now - getattr(self, "auto_k", 0) > 0.3:
                self.auto_k = now
                self.game.key(__import__("random").choice(["left", "right", "up", "down", "down"]))
        if self.game and not self.modal:
            self.game.step(now)
        if now - self.last_frame < PACE.interval:
            return
        self.last_frame = now
        t = time.perf_counter()
        self.app.check_resize()
        self.draw()
        self.s.flush()
        PACE.measure(time.perf_counter() - t)
        if AUTOPLAY and self.modal:
            self.modal_t = getattr(self, "modal_t", None) or now
            if now - self.modal_t > 3.0 and engine.RESPONDER:
                self.modal_t = None
                engine.RESPONDER.user_input(b"n\r")

    # drawing
    def draw(self, fade=1.0):
        c, t = self.s.canvas, time.time() - self.app.t0
        t = math.floor(t * 10) / 10     # colour flows at 10 fps: most rows stay identical between frames
        if self.game or self.hub:
            self.draw_games(c, t)
        else:
            self.draw_dashboard(c, t, fade)
        BACKDROP.draw(c, t, PAL_RUN, fade)      # after the content (only into empty cells), before the modal
        self.app.draw_toast()
        if self.modal:
            why, line = self.modal
            lines = textwrap.wrap(line, max(10, min(c.w - 14, 76)), break_on_hyphens=False) or [line]
            self.app.draw_modal("Нужен твой ответ", [why[:1].upper() + why[1:], ""] + lines,
                                "Enter — отправить    Ctrl+] — полный вывод", PAL_WARN,
                                input_text=("•" * len(self.input)) if getattr(self, "secret", False) else self.input)

    def status_strip(self, c, t, y):
        """One compact line with the update's state, shown above the games."""
        p = self.prog
        if self.update_done:
            text = "✓  обновление завершено   ·   Esc — к итогу"
            c.cput(y, text, GOOD, bold=True)
            return
        stage = {"start": "подготовка", "download": "загрузка", "install": "установка", "hooks": "хуки",
                 "aur": "сборка AUR", "cleanup": "завершение"}.get(p.stage, "обновление")
        frac = p.overall()
        eta = f"осталось ≈ {fmt_dur(max(1, self.eta_shown or p.eta()))}"
        bw = 24
        text_l = f"ARCH UPDATE  ·  {stage}  "
        text_r = f"  {int(frac * 100):3d}%  ·  {eta}"
        if len(text_l) + bw + len(text_r) > c.w - 2:       # narrow terminal: no title, shorter bar
            text_l = f"{stage}  "
            bw = max(6, c.w - 2 - len(text_l) - len(text_r))
        x = (c.w - len(text_l) - bw - len(text_r)) // 2
        for i, ch in enumerate(text_l):
            c.put(x + i, y, ch, grad(PAL_RUN, i / 40 - t * 0.15), bold=i < 11)
        x += len(text_l)
        bar(c, x, y, bw, frac, lambda i: grad(PAL_RUN, i / bw * 0.7 - t * 0.25))
        c.put(x + bw, y, text_r, TEXT)

    def draw_games(self, c, t):
        if self.hub:
            self.status_strip(c, t, 1 if c.h >= 26 else 0)      # a laptop screen: row 0, as in the games
            top = max(3, (c.h - 9) // 2)                        # the 9-row block, centred
            title = "МИНИ-ИГРЫ"
            c.cput(top, " ".join(title), grad(PAL_ARCH, -t * 0.12), bold=True)
            c.cput(top + 1, "обновление идёт дальше само — играй спокойно", DIM)
            mw = 44
            mx = (c.w - mw) // 2
            y = top + 4
            for i, G in enumerate(games.GAMES):
                sel = i == self.hub_sel
                best = self.best.get(G.name)
                if sel:
                    pill(c, mx, y, mw, lambda xx: shade(grad(PAL_ARCH, xx / mw * 0.6 - t * 0.1), 0.5),
                         grad(PAL_ARCH, -t * 0.1))
                c.put(mx + 2, y, ("▸ " if sel else "  ") + f"{i + 1}  {G.title}", (255, 255, 255) if sel else TEXT,
                      bold=sel)
                if best:
                    rec = f"рекорд {best}"
                    c.put(mx + mw - len(rec) - 2, y, rec, DIM if not sel else (220, 220, 235))
                y += 2
            self.app.hint("↑↓ выбор", "Enter играть", "Esc назад")
            return
        g = self.game
        g.scale = 1
        for sc in (3, 2):        # largest scale that fits the screen (big monitors get big cells)
            g.scale = sc
            w_, h_ = g.size()
            if w_ <= c.w - 6 and h_ <= min(c.h - 8, c.h * 3 // 4):
                break
            g.scale = 1
        gw, gh = g.size()
        x0 = (c.w - gw) // 2
        title = f"{g.title.upper()}   ·   очки {g.score}   ·   рекорд {max(g.score, self.best.get(g.name, 0))}"
        if c.h >= gh + 8:                  # roomy: strip, gap, title, board, gap, footer
            self.status_strip(c, t, 1)
            y0, foot = max(3, (c.h - gh) // 2), c.h - 2
            c.cput(y0 - 1, title, grad(PAL_ARCH, 0.2 - t * 0.1), bold=True)
        else:                              # low terminal (a laptop): title only if it fits, the rest centred
            self.status_strip(c, t, 0)
            foot = c.h - 1
            has_title = c.h >= gh + 3
            y0 = 1 + max(0, (c.h - 2 - gh - has_title) // 2)
            if has_title:
                c.cput(y0, title, grad(PAL_ARCH, 0.2 - t * 0.1), bold=True)
                y0 += 1
        c.blank(x0, y0, gw, gh, BG)        # the board counts as drawn: no star or aurora inside it
        g.draw(c, U, x0, y0, t)
        hint = g.hints + "   ·   Esc — выйти из игры"
        if len(hint) > c.w - 2:
            hint = g.hints + "  ·  Esc — выход"
        keyline(c, foot, hint)

    def draw_dashboard(self, c, t, fade=1.0):
        W = min(c.w - 8, 84)
        x0 = (c.w - W) // 2
        p = self.prog
        top = max(1, c.h // 2 - 13)
        gap = 1 if c.h < 30 else 2         # blank rows between blocks: one on a laptop, two on a desktop

        # header
        head = "A R C H   U P D A T E"
        hx = (c.w - len(head)) // 2
        for i, ch in enumerate(head):
            c.put(hx + i, top, ch, grad(PAL_RUN, i / len(head) * 0.7 - t * 0.15), bold=True, alpha=fade)
        sub = "демо-режим · ничего не меняется" if self.demo else "обновление системы"
        c.cput(top + 1, sub, DIM, alpha=fade)

        # stages
        stages = [("download", "Загрузка"), ("install", "Установка"), ("hooks", "Хуки")]
        if p.aur_pkgs:
            stages.append(("aur", "AUR"))
        stages.append(("cleanup", "Завершение"))
        order = engine.Progress.STAGES
        cur = order.index(p.stage) if p.stage in order else -1
        seg = W // len(stages)
        y = top + 2 + gap
        for i, (key, name) in enumerate(stages):
            idx = order.index(key)
            cx = x0 + i * seg + seg // 2
            if idx < cur:
                dot, col = "●", grad(PAL_RUN, i * 0.15)
            elif idx == cur:
                pulse = 0.55 + 0.45 * math.sin(t * 5)
                dot, col = "◉", lerp(DIM, grad(PAL_RUN, i * 0.15 - t * 0.2), pulse)
            else:
                dot, col = "○", MUTED
            if i < len(stages) - 1:
                lc = grad(PAL_RUN, i * 0.15) if idx < cur else FAINT
                c.put(cx + 2, y, ("━" if idx < cur else "─") * (seg - 3), lc, alpha=fade)     # done: heavier
            c.put(cx, y, dot, col, bold=True, alpha=fade)
            c.put(cx - len(name) // 2, y + 1, name, TEXT if idx == cur else (DIM if idx < cur else MUTED),
                  bold=idx == cur, alpha=fade)

        # stage line
        y += 2 + gap
        title = {"start": "Подготовка", "download": "Скачиваю пакеты", "install": "Устанавливаю пакеты",
                 "hooks": "Выполняю хуки", "aur": "Собираю пакеты из AUR", "cleanup": "Наводим порядок",
                 "end": "Готово"}.get(p.stage, "Обновление")
        if p.stage == "aur" and p.building:
            title = f"Собираю {p.building}"
        c.put(x0, y, title, TEXT, bold=True, alpha=fade)
        right = ""
        if p.stage == "install" and p.total:
            right = f"{p.done} / {p.total}"
        elif p.stage == "hooks" and p.hooks_total:
            right = f"{p.hooks_done} / {p.hooks_total}"
        elif p.stage == "download" and p.dl_seen:
            right = f"{int(p.dl_pct)}%"
        elif p.stage == "aur" and p.aur_pkgs:
            right = f"{p.aur_done} / {p.aur_count()}"
        c.put(x0 + W - len(right), y, right, DIM, alpha=fade)

        # progress bar (overall), sub-cell precision, flowing gradient
        y += 2
        frac = p.overall()
        bar(c, x0, y, W, frac, lambda i: grad(PAL_RUN, i / W * 0.8 - t * 0.25), alpha=fade)
        pct = f"{int(frac * 100)}%"
        c.put(x0 + W - len(pct), y + 1, pct, TEXT, bold=True, alpha=fade)

        # eta
        eta = p.eta()
        if self.eta_shown is None:
            self.eta_shown = eta
        else:
            self.eta_shown += (eta - self.eta_shown) * 0.08
        elapsed = time.time() - self.t_start
        el = f"прошло {int(elapsed // 60)}:{int(elapsed % 60):02d}"
        if p.stage in ("start",) and elapsed < 3:
            eta_txt = "оцениваю время…"
        else:
            eta_txt = f"осталось ≈ {fmt_dur(max(1, self.eta_shown))}"
        c.put(x0, y + 1, eta_txt, grad(PAL_RUN, 0.3 - t * 0.1), alpha=fade)
        c.put(x0 + len(eta_txt) + 3, y + 1, el, DIM, alpha=fade)

        # activity feed: newest at the bottom, older lines fade out
        y += 2 + gap
        rows = max(3, min(9, c.h - 5 - gap - y))      # the invitation keeps its blank row(s) above
        items = self.feed[-rows:]
        for i, (ts, text, kind) in enumerate(items):
            age_rank = len(items) - 1 - i
            k = 1.0 - age_rank / (rows + 1)
            k *= clamp01((time.time() - ts) / 0.25) * 0.85 + 0.15
            col = {"info": TEXT, "auto": hexrgb("#7cf5d6"), "warn": WARN, "err": BAD}[kind]
            icon = {"info": "›", "auto": "✓", "warn": "!", "err": "✗"}[kind]
            line = text if len(text) <= W - 4 else text[:W - 5] + "…"
            yy = y + (rows - len(items)) + i
            c.put(x0 + 1, yy, icon, col, alpha=fade * k)
            c.put(x0 + 3, yy, line, col if age_rank == 0 else lerp(DIM, col, k), alpha=fade * k)

        # invitation to play
        inv = "▶  G — мини-игры, пока идёт обновление"
        yy = y + rows + gap
        ix = (c.w - len(inv)) // 2
        pulse = 0.7 + 0.3 * math.sin(t * 2.2)
        for i, ch in enumerate(inv):
            c.put(ix + i, yy, ch, lerp(BG, grad(PAL_ARCH, i / len(inv) * 0.6 - t * 0.15), pulse), bold=True, alpha=fade)
        hint = "Ctrl+] — полный вывод и ручной режим" + ("   ·   ←→ монитор" if self.app.monitors > 1 else "")
        keyline(c, c.h - 2, hint, MUTED, DIM, alpha=fade)      # quieter than the invitation above


def transition(app, view):
    """The menu screen flows into the live view: a diagonal colour wave recolours the title
    into the run palette and dissolves everything else, then the dashboard fades in."""
    s, dur = app.s, 1.2
    t0 = time.time()
    while True:
        k = (time.time() - t0) / dur
        if k >= 1:
            break
        app.check_resize()
        app.draw_menu()
        c, t = s.canvas, app.now()
        front = ease(k) * (c.h + 24) - 12
        top = app.title_top()
        band = 6 if app.menu_layout().big_title else 1
        for y in range(c.h):
            for x in range(c.w):
                b = clamp01((front - y - (x / c.w) * 12) / 6)
                if b <= 0:
                    continue
                if c.bg[y][x]:
                    c.bg[y][x] = lerp(c.bg[y][x], BG, b)
                if c.fg[y][x] is None:
                    continue
                if top <= y < top + band and c.ch[y][x] != " ":
                    target = grad(PAL_RUN, x / c.w * 0.85 - t * 0.12)
                    if c.ch[y][x] in SHADOW_CHARS:
                        target = shade(target, 0.45)
                    c.fg[y][x] = lerp(c.fg[y][x], target, b)
                else:
                    c.fg[y][x] = lerp(c.fg[y][x], BG, b)
        for x in range(c.w):                       # glowing edge riding the wave
            yy = int(front - (x / c.w) * 12)
            if 0 <= yy < c.h and c.ch[yy][x] == " ":
                c.put(x, yy, "▁", grad(PAL_RUN, x / c.w - k), alpha=0.5 * (1 - k))
        s.flush()
        time.sleep(PACE.interval)
    t1 = time.time()
    while time.time() - t1 < 0.35:                 # big title dissolves
        a = 1 - ease((time.time() - t1) / 0.35)
        app.check_resize()
        if app.menu_layout().big_title:
            app.draw_title(app.title_top(), app.now(), pal=PAL_RUN, alpha=a)
        else:
            app.draw_small_title(app.title_top(), app.now(), pal=PAL_RUN, alpha=a)
        s.flush()
        time.sleep(PACE.interval)
    t1 = time.time()
    while time.time() - t1 < 0.5:                  # dashboard fades in
        app.check_resize()
        view.draw(fade=ease((time.time() - t1) / 0.5))
        s.flush()
        time.sleep(PACE.interval)


# ───────────────────────────── summary ─────────────────────────────

class ReportLine:
    """The summary's quiet line about this update's report: where the report is now. Looked up at
    most once a second; the sender works in a process of its own."""
    SENDING = 10                    # seconds of "отправляется…" before it counts as waiting

    def __init__(self, path):
        self.path, self.t0, self.state, self.polled = path, time.time(), "waiting", 0.0
        self.endpoint = bool(report.endpoint())

    def text(self):
        now = time.time()
        if now - self.polled >= 1:
            self.polled = now
            # looked up twice when not found: the sender may move it between two folders just then
            self.state = report.state_of(self.path) or report.state_of(self.path)
        if self.state == "sent":
            return "отчёт отправлен разработчику"
        if self.state == "rejected":
            return "отчёт не принят сервером"
        if self.state == "waiting":
            if self.endpoint and now - self.t0 < self.SENDING:
                return "отчёт: отправляется…"
            return "отчёт ждёт отправки — уйдёт при следующем запуске"
        return ""


def queue_report(app, res, mode, elapsed):
    """This update's report, if the user said yes (never for the demo): queued, and sent by a
    process of its own. Returns its ReportLine for the summary, or None when none was made."""
    w, h = term_size()
    path = report.after_update(res, demo=DEMO, mode=mode, seconds=elapsed,
                               ui={"screen": f"{w}x{h}", "monitors": app.monitors})
    return ReportLine(path) if path else None


def summary_view(res, elapsed, sent=None):
    """What the summary screen shows for a finished run (res is None when nothing ran);
    sent: the ReportLine of its report, if one was made."""
    verdict = res["verdict"] if res else 0
    n = len(res["changed"]) + len(res["added"]) if res else 0
    lines = []
    if res:
        lines += [("✗", p, BAD) for p in res["problems"]]
        lines += [("⚠", w, WARN) for w in res["warnings"]]
        lines += [("✓", o, GOOD) for o in res["ok"]]
    return types.SimpleNamespace(
        verdict=verdict, pal=[PAL_OK, PAL_WARN, PAL_BAD][verdict], glyph=[CHECK, BANG, CROSS][verdict],
        head=(res or {}).get("head") or
        ["Обновление завершено", "Готово — есть что прочитать", "Нужна проверка — не перезагружайся"][verdict],
        stats=f"{n} {plural(n, 'пакет', 'пакета', 'пакетов')} за {fmt_dur(elapsed)}" if res else "",
        lines=lines, log=res["log"] if res else None, sent=sent)


def draw_summary(app, sv, t, demo, left):
    """One frame of the summary; left = seconds until it closes by itself, None if it stays open."""
    c = app.s.canvas
    W = min(c.w - 8, 84)
    gap = 7 if c.h < 30 else 8                                   # glyph top -> headline
    note = sv.sent.text() if sv.sent else ""                     # where this update's report is
    foot = c.h - 5 if note else c.h - 4                          # the journal line, the report's below it
    wraps = [textwrap.wrap(tx, max(10, W - 4), break_on_hyphens=False) or [""] for _, tx, _ in sv.lines]
    need = gap + 3 + sum(min(2, len(w)) for w in wraps)          # glyph, headline, stats, blank, list
    top = max(1, (foot - need) // 2)                             # centred above the journal line
    gw = len(sv.glyph[0])
    gx = (c.w - gw) // 2
    for ry, row in enumerate(sv.glyph):
        a = clamp01((t - ry * 0.06) / 0.3)
        for i, ch in enumerate(row):
            if ch != " ":
                col = grad(sv.pal, i / gw * 0.7 + ry * 0.04 - t * 0.12)
                if ch in SHADOW_CHARS:
                    col = shade(col, 0.45)
                c.put(gx + i, top + ry, ch, col, bold=True, alpha=a)
    y = top + gap
    c.cput(y, sv.head, grad(sv.pal, 0.2 - t * 0.1), bold=True, alpha=clamp01((t - 0.4) / 0.4))
    if demo:
        c.cput(y + 1, "демо-режим: это была имитация, система не менялась", DIM, alpha=clamp01((t - 0.5) / 0.4))
    elif sv.stats:
        c.cput(y + 1, sv.stats, DIM, alpha=clamp01((t - 0.5) / 0.4))
    y += 3
    longest = max([min(len(tx), W - 4) for _, tx, _ in sv.lines] or [0]) + 4
    x0 = (c.w - longest) // 2
    for i, (icon, _, col) in enumerate(sv.lines[: max(3, foot - y - 2)]):
        a = clamp01((t - 0.7 - i * 0.08) / 0.35)
        wrapped = wraps[i]
        if y + min(2, len(wrapped)) > foot - 1:           # low terminal: the log line stays readable
            break
        c.put(x0 + 2, y, icon, col, bold=True, alpha=a)
        tcol = TEXT if icon != "✓" else DIM               # one colour per item, its second line too
        c.put(x0 + 4, y, wrapped[0], tcol, alpha=a)
        y += 1
        for extra in wrapped[1:2]:
            c.put(x0 + 4, y, extra, tcol, alpha=a)
            y += 1
    if sv.log:
        c.cput(foot, "журнал: " + sv.log.replace(os.path.expanduser("~"), "~"), MUTED)
    if note:
        c.cput(foot + 1, note, MUTED)
    mon = "   ·   ←→ монитор" if app.monitors > 1 else ""
    if left is not None:
        keyline(c, c.h - 2, f"закроется через {int(math.ceil(left))} с   ·   Enter — закрыть{mon}   ·   "
                            "любая клавиша — оставить")
    else:
        keyline(c, c.h - 2, "Enter — закрыть" + mon)


def summary_screen(app, res, elapsed, demo=False, sent=None):
    s = app.s
    sv = summary_view(res, elapsed, sent)
    countdown = sv.verdict == 0 and not (res or {}).get("exitstatus")
    try:
        termios.tcflush(0, termios.TCIFLUSH)   # an Enter typed during the run/checks must not close it
    except termios.error:
        pass
    t0, keep, deadline = time.time(), not countdown, time.time() + 10
    while True:
        app.check_resize()
        left = None
        if not keep:
            left = max(0, deadline - time.time())
            if left <= 0:
                return
        draw_summary(app, sv, time.time() - t0, demo, left)
        app.draw_toast()
        s.flush()
        if select.select([0], [], [], PACE.interval)[0]:
            try:
                data = os.read(0, 64)
            except OSError:
                return
            if not data:
                return
            if time.time() - t0 < 1.0:            # late typeahead: the verdict must be readable first
                continue
            keys = parse_keys(data)
            if "enter" in keys:
                return
            moves = [k for k in keys if k in ("left", "right")] if app.monitors > 1 else []
            for k in moves:
                app.move_screen(k)
            if len(moves) < len(keys):        # any other key keeps the window open
                keep = True


# ───────────────────────────── self-test ─────────────────────────────

def self_test():
    """Draw every screen off-screen at laptop and desktop sizes: no terminal, no network, no change
    to the system. install.sh --check runs it before a machine accepts a self-update, so a version
    that cannot draw itself never goes live."""
    global save_ui_state
    save_ui_state = lambda **kw: None          # noqa: E731 — the user's ui.json is never touched
    for name in ("set_consent", "after_update", "queue", "start_sender", "send_pending"):
        setattr(report, name, lambda *a, **kw: None)     # nor the reports' settings.json and outbox
    Screen.write = lambda self, s: None
    app = App(live=False)
    app.repo = [("linux", "6.18.1-1", "6.18.2-1"), ("mesa", "1:26.2.5-1", "1:26.2.6-1")] + \
        [(f"package-with-a-long-name-{i}", "1.0.0-1", "1.0.1-1") for i in range(30)]
    app.aur = [("brave-bin", "1:1.97.59-1", "1:1.97.60-1")]
    app._risky = lambda n: n == "linux"        # the kernel/NVIDIA warning, whatever this machine has
    app.version = ("abc1234", "30.10.2026", "a new version with a long description of what changed")
    app.low_battery = 17
    app.toast("апдейтер обновился: " + app.version[2], secs=5)
    app.news = [{"date": f"2026-10-1{i}", "url": "", "new": i == 0, "info": "автор · дата",
                 "title": f"Новость {i}: длинный заголовок, который не помещается в узкое окно терминала",
                 "body": "Первый абзац.\n\n" + "слово " * 400} for i in range(6)]
    res = {"verdict": 2, "changed": ["a"] * 40, "added": ["b"], "removed": [], "exitstatus": 1,
           "problems": ["очень длинное описание проблемы " * 6], "warnings": ["предупреждение"],
           "ok": ["/boot в порядке"], "log": os.path.join(engine.STATE_DIR, "logs", "x.log")}
    # The settings with what report.status() and report.preview() can give, made up here: the
    # self-test reads and writes none of the real ones.
    states = [dict(REPORTS_UNDECIDED), dict(REPORTS_UNDECIDED, decided=True),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="1a2b3c4d", waiting=2),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="f" * 90, endpoint=True, waiting=12,
                   last_sent="2026-10-30T17:45:45", last_error="URLError: " + "name resolution failed " * 6)]
    preview = json.dumps({"schema": 1, "id": "1a2b3c4d", "time": "2026-10-31T08:00:00Z",
                          "updater": {"commit": "abc1234", "date": "31.10.2026"},
                          "device": {"model": "очень длинное название модели " * 6, "odd": "\x1b[2J\x9b2J",
                                     "gpu": [{"id": "8086:3185", "name": "Intel UHD Graphics 600", "driver": "i915"}],
                                     "network": {"type": "Wi-Fi", "driver": "iwlwifi", "signal_dbm": -61}},
                          "update": {"mode": "auto", "verdict": 1, "changed": [f"pkg-{i}" for i in range(40)]},
                          "log": "[17:42:38 СТАРТ] arch-update\n" + ("строка\tжурнала\x07 " * 12 + "\n") * 300
                                 + "x" * 500 + "\n"}, ensure_ascii=False, indent=1)
    for w, h in ((80, 24), (100, 30), (136, 38), (320, 80)):
        c = app.s.canvas = Canvas(w, h)

        def shot(draw):
            draw()
            c.rows()
            c.clear()
        app.state, app.confirm = "splash", None
        for age in (0.0, 1.3, 3.0, 20.0):
            app.t0 = time.time() - age
            shot(app.draw_splash)
        app.state, app.menu_t, app.from_splash = "menu", time.time() - 5, True
        if app.menu_layout().total > h - 4:     # every item and warning, a free row above the footer
            raise RuntimeError(f"the menu does not fit into {w}x{h}")
        for st in states:
            app.rep, app.menu_sel = st, len(app.menu_items()) - 2
            shot(app.draw_menu)
        app.menu_sel = 0
        app.toast(REPORTS_HINT)
        shot(app.draw_menu)
        app.confirm = time.time()
        shot(app.draw_menu)
        app.confirm, app.state = None, "settings"
        for st in states:
            app.rep = st
            for i in range(len(SETTINGS_ITEMS)):
                app.set_sel = i
                shot(app.draw_settings)
        app.pv_open, app.pv_data = True, None
        shot(app.draw_settings)                 # still being put together
        app.pv_data = (app.pv_gen, preview_source(preview))
        for scroll in (0, 40, 1 << 30):
            app.pv_scroll = scroll
            shot(app.draw_settings)
        app.pv_open, app.state, app.article = False, "news", None
        shot(app.draw_news)
        app.article, app.scroll = app.news[0], 3
        shot(app.draw_news)
        app.state, app.article = "menu", None
        view = LiveView(app, demo=True)
        view.bell = lambda: None
        for kind in ("info", "auto", "warn", "err"):
            view.push("строка ленты " * 8, kind)
        shot(view.draw)
        view.handover("запрос пароля", "[sudo] password for cactus:")
        view.input = "secret"
        shot(view.draw)
        view.handover_done()
        view.hub = True
        shot(view.draw)
        view.hub = False
        for G in games.GAMES:
            view.game = G()
            for k in ("down", "left", "up", "right", "down"):
                view.game.key(k)
                view.game.step(time.time())
            shot(view.draw)
        view.update_done = True
        shot(view.draw)
        view.game = None
        for sv, demo, left in ((summary_view(res, 125), False, None), (summary_view(res, 3), False, 7.5),
                               (summary_view(None, 0), True, None)):
            shot(lambda: draw_summary(app, sv, 2.0, demo, left))
        sent = ReportLine(os.path.join(report.OUTBOX, "x.json"))
        for state, age in (("waiting", 0), ("waiting", 60), ("sent", 0), ("rejected", 0)):
            sent.state, sent.t0, sent.polled, sent.endpoint = state, time.time() - age, math.inf, True
            shot(lambda: draw_summary(app, summary_view(res, 125, sent), 2.0, False, 7.5))
    print("arch-update-ui: self-test ok")


# ───────────────────────────── main ─────────────────────────────

def run_auto(app):
    view = LiveView(app, demo=DEMO)
    transition(app, view)
    t0 = time.time()
    status, res, _ = engine.run_update(view, manual=False, stop_on_news=False,
                                       cmd=DEMO_CMD if DEMO else None, dims=tuple(app.s.size),
                                       on_spawn=lambda ch: setattr(app, "child", ch), demo=DEMO)
    elapsed = time.time() - t0
    sent = queue_report(app, res, "auto", elapsed)     # now: a game left open must not hold it back
    if not DEMO and not view.raw and res is not None and res.get("started", True):
        view.prog.learn()
    if (view.game or view.hub) and not view.raw and engine.TERM_OK:
        view.play_after()
    return view, res, elapsed, sent


def run_manual(app, tty_state):
    app.s.leave()
    termios.tcsetattr(0, termios.TCSADRAIN, tty_state)
    tty.setraw(0)
    view = engine.TerminalView()
    engine.VIEW = view
    view.message("[arch-update] обычный Arch-Update: на вопросы отвечаешь ты. Всё пишется в журнал, "
                 "в конце будет проверка системы.\n")
    t0 = time.time()
    status, res, _ = engine.run_update(view, manual=True, cmd=DEMO_CMD if DEMO else None,
                                       dims=tuple(app.s.size), on_spawn=lambda ch: setattr(app, "child", ch),
                                       demo=DEMO)
    elapsed = time.time() - t0
    return res, elapsed, queue_report(app, res, "manual", elapsed)


def main():
    if "--self-test" in sys.argv:
        return self_test()
    if not sys.stdin.isatty():
        sys.exit("arch-update-ui нужен терминал")
    if DEMO:
        os.environ["ARCH_UPDATE_AUTO_NOTIFY"] = "0"
        os.environ["ARCH_UPDATE_AUTO_LOGDIR"] = os.path.join(engine.STATE_DIR, "demo-logs")
    engine.shield_from_window_close()
    old = termios.tcgetattr(0)
    holder = {}

    def on_winch(*_):
        app = holder.get("app")
        if not app:
            return
        app.resized = True
        ch = getattr(app, "child", None)
        if ch:
            try:
                ch.setwinsize(*reversed(term_size()))
            except (OSError, ValueError):
                pass
    signal.signal(signal.SIGWINCH, on_winch)      # before the size is first read: no resize gets lost
    app, action, res = None, None, None
    try:
        app = holder["app"] = App()
        app.child = None
        st = app.rep
        if not DEMO and st["enabled"] and st["waiting"] and st["endpoint"]:
            report.start_sender()                 # what an earlier run could not send, in its own process
        tty.setraw(0)
        app.s.enter()
        app.resized = True                        # the terminal may still be going full screen
        action = app.loop()
        if action == "auto":
            view, res, elapsed, sent = run_auto(app)
            if engine.TERM_OK:
                if view.raw:
                    app.s.enter()
                app.s.resize()
                summary_screen(app, res, elapsed, demo=DEMO, sent=sent)
        elif action == "manual":
            res, elapsed, sent = run_manual(app, old)
            if engine.TERM_OK:
                app.s.enter()
                app.s.resize()
                summary_screen(app, res, elapsed, demo=DEMO, sent=sent)
    except Exception:
        tb = traceback.format_exc()
        try:
            os.makedirs(engine.STATE_DIR, exist_ok=True)
            with open(os.path.join(engine.STATE_DIR, "ui-error.log"), "a") as f:
                f.write(time.strftime("\n== %F %T ==\n") + tb)
        except OSError:
            pass
        if app:
            app.s.leave()
        try:
            termios.tcsetattr(0, termios.TCSADRAIN, old)
        except termios.error:
            pass
        print("\narch-update-ui: ошибка интерфейса (подробности в ~/.local/state/arch-update-auto/ui-error.log)")
        print(tb)
        if res:
            for p in res["problems"]:
                print("✗", p)
            for w in res["warnings"]:
                print("⚠", w)
            print("✓ проблем не найдено" if not res["problems"] else "НЕ перезагружайся, пока не разберёмся")
            print("журнал:", res["log"])
        # Nothing has run yet (and this is not the demo, which must never touch the system):
        # the plain updater still can. Chosen mode as chosen; before a choice, the user answers.
        if engine.LOG is None and not DEMO and engine.TERM_OK and action != "quit":
            mode = action if action in ("auto", "manual") else None
            if not mode:
                try:
                    if input("Enter — обычный Arch-Update (на вопросы отвечаешь сам), q — выход: ").strip() \
                            in ("q", "й"):
                        return
                except (EOFError, KeyboardInterrupt, OSError):
                    return
                mode = "manual"
            os.environ["ARCH_UPDATE_AUTO_MODE"] = mode
            print("Запускаю обычный режим…\n")
            try:
                os.execv(os.path.join(HERE, "arch-update-auto"), ["arch-update-auto"])
            except OSError as e:
                print(f"не удалось запустить arch-update-auto: {e}")
        if engine.TERM_OK:
            try:
                input("Enter — закрыть")
            except (EOFError, OSError):
                pass
        return
    finally:
        if engine.TERM_OK and app:
            app.s.leave()
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old)
            except termios.error:
                pass


if __name__ == "__main__":
    main()
