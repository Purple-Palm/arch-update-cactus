class App:
    def __init__(self, live=True):
        """live=False: no update check, news download or window placement (the self-test)."""
        self.s = Screen()
        self.t0 = time.time()
        self.state = "splash"
        self.repo, self.aur, self.check_failed = None, None, False
        self.news, self.news_err = None, None
        self.menu_sel = 0
        self.menu_t = None
        self.menu_since = None          # when the menu first showed (the waiting reports' sender waits for it)
        self.news_sel = 0
        self.article = None
        self.scroll = 0
        self.confirm = None
        self.resized = False
        self.quit = False
        self.kpid = konsole_pid() if live else None
        self.monitors = 0
        self.moving = False
        self.toast_text, self.toast_t, self.toast_secs = "", 0.0, 2.2
        self._risky = None
        self.live = live
        # The reports' state, read again only when the settings are open: never once per frame.
        self.rep, self.rep_t = (report.status() if live else dict(REPORTS_UNDECIDED)), time.time()
        self.sender_due = live and not DEMO        # see send_waiting
        self.report_line = None                    # this update's report (ReportLine), once there is one
        self.hinted = False
        self.set_sel, self.set_key_t = 0, 0.0
        self.pv = None                             # "Что именно уходит" (a Reader), while it is open
        self.services_on = report.option("restart_services", False) if live else False
        # The last updates kept on this machine (report.local_updates; None while being read), the one chosen,
        # its report while open (a Reader), and the first D of a delete: (its journal, when).
        self.up_list, self.up_sel, self.up_reader, self.up_del, self.up_gen = None, 0, None, None, 0
        self.jobs = []                             # reports sent by hand from the menu or the list: answers to tell
        self.leaving = None                        # q in the menu while a report is on its way: since when it waits
        self.pressed = {}                          # key → when it was last pressed (a key held down counts once)
        self.child = None                          # what runs in the plain terminal now (for window resizes)
        self.bad = None                            # the last update while it says not to reboot (refresh_banner)
        if live:
            self.refresh_banner()
        bat = engine.battery() if live else None
        self.low_battery = bat[0] if bat and bat[1] and bat[0] < 30 else None
        self.version = updater_version() if live else None
        if self.kpid and "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            threading.Thread(target=self._find_monitors, daemon=True).start()
        if live:
            threading.Thread(target=self._load_updates, daemon=True).start()
            threading.Thread(target=self._load_news, daemon=True).start()

    # data loading
    def _load_updates(self):
        if DEMO:
            time.sleep(1.4)
            self.repo = [("mesa", "1:26.2.5-1", "1:26.2.6-1"), ("linux-firmware", "20260916-1", "20261014-1"),
                         ("qt6-base", "6.12.0-3", "6.12.1-1"), ("plasma-workspace", "6.8.0-1", "6.8.1-1"),
                         ("kwin", "6.8.0-1", "6.8.1-1"), ("python-pip", "26.2.2-1", "26.2.3-1"),
                         ("ffmpeg", "2:9.0.2-2", "2:9.0.3-1"), ("pipewire", "1:1.6.9-1", "1:1.6.10-1")]
            self.aur = [("brave-bin", "1:1.97.59-1", "1:1.97.60-1")]
            self.risky_pkgs()
            return
        repo, aur, failed = engine.check_updates()
        self.risky_pkgs()                    # dkms status: here, not in the first menu frame
        self.repo, self.aur, self.check_failed = repo, aur, failed

    def _find_monitors(self):
        self.monitors = monitor_count()
        if self.monitors > 1:
            self._restore_monitor()

    def _restore_monitor(self):
        """Open on the primary (central) monitor. Konsole's window may not exist yet when we start,
        so the move is repeated a few times (it does nothing once the window is already there)."""
        target = primary_output()
        if not target:
            return
        for delay in (0.15, 0.5, 1.0, 2.0):
            time.sleep(delay)
            kwin_move_window(self.kpid, target=target)

    def move_screen(self, direction):
        """← / →: our window to the neighbouring monitor; remembered for next time."""
        if self.monitors < 2 or self.moving:
            return
        self.moving = True

        def work():
            try:
                before = active_output()
                kwin_move_window(self.kpid, step=-1 if direction == "left" else 1)
                time.sleep(0.5)
                after = active_output()
                if after and after != before:
                    self.toast(f"монитор: {after}")
                else:
                    self.toast("это крайний монитор")
            finally:
                self.moving = False
        threading.Thread(target=work, daemon=True).start()

    def toast(self, text, secs=2.2):
        self.toast_text, self.toast_t, self.toast_secs = text, time.time(), secs

    def draw_toast(self):
        if not self.toast_text:
            return
        age = time.time() - self.toast_t
        if age > self.toast_secs:
            self.toast_text = ""
            return
        a = clamp01(age / 0.2) * clamp01((self.toast_secs - age) / 0.6)
        c, t = self.s.canvas, self.now()
        text = f"  ◂  {self.toast_text}  ▸  "
        if len(text) > c.w - 2:                    # a narrow terminal: the arrows go before any words
            text = f"  {self.toast_text}  "
        if len(text) > c.w - 2:
            text = text[:c.w - 4] + "… "
        x0, y = (c.w - len(text)) // 2, c.h - 4
        for i, ch in enumerate(text):
            c.put(x0 + i, y, ch, (255, 255, 255), bg=shade(grad(PAL_ARCH, i / len(text) * 0.6 - t * 0.2), 0.55),
                  bold=True, alpha=a)

    def hint(self, *parts):
        """Footer with the ←→ monitor hint when there is more than one monitor."""
        if self.monitors > 1:
            last = parts[-1:] if parts and parts[-1] == "q выход" else ()
            parts = parts[:len(parts) - len(last)] + ("←→ монитор",) + last
        self.footer("   ".join(parts))

    def _load_news(self):
        try:
            self.news = get_news()
        except Exception as e:      # network down etc.
            self.news, self.news_err = [], str(e)

    def _load_article(self, item):
        try:
            item["info"], item["body"] = get_article(item["url"])
        except Exception as e:
            item["info"], item["body"] = "", f"Не удалось загрузить статью: {e}"

    @property
    def loaded(self):
        return self.repo is not None and self.news is not None

    @property
    def count(self):
        return len(self.repo or []) + len(self.aur or [])

    def risky_pkgs(self):
        """Packages after which the screen may freeze for a while: the NVIDIA driver, or a kernel
        while the NVIDIA DKMS module has to be rebuilt for it."""
        if self._risky is None:
            kernels = set(engine.kernel_packages()) if "nvidia" in engine.dkms_built() else set()
            self._risky = lambda n: bool(engine.NVIDIA_PKGS.match(n)) or n in kernels
        return self._risky

    @property
    def kernel_gpu(self):
        risky = self.risky_pkgs()
        return [n for n, *_ in (self.repo or []) if risky(n)]

    def menu_items(self):
        if self.count:
            items = [("auto", "Обновить автоматически", "сам отвечу на вопросы, позову тебя только если важно"),
                     ("manual", "Обычный Arch-Update", "отвечаешь на вопросы сам")]
        else:
            items = [("recheck", "Проверить ещё раз", "вдруг что-то вышло"),
                     ("manual", "Обычный Arch-Update", "запустить как есть")]
        if self.news:
            items.append(("news", "Читать новости Arch", f"{len(self.news)} последних"))
        if self.bad:
            items.append(("last", "Последнее обновление", "НЕ перезагружайся — что не так и что с этим делать"))
        word = "вкл" if self.rep["enabled"] else "выкл" if self.rep["decided"] else "ещё не решено"
        items.append(("settings", "Настройки", f"отчёты об обновлениях: {word}"))
        items.append(("quit", "Выйти", ""))
        return items

    # ── the menu's warning about the last update
    def refresh_banner(self):
        """The last update, while it found problems in this very boot and nothing has fixed them
        (engine.unresolved): until a reboot or a fix the menu warns about it, with its keys (Actions). The chosen
        menu item stays chosen, whatever comes or goes above it."""
        chosen = self.menu_key()
        old = self.bad
        try:                                 # a summary nobody can read is no reason not to start
            data = engine.unresolved()
            before = report.report_state(data["log"]) if data and self.live and not DEMO else None
            self.bad = Actions(self, data, demo=DEMO, sent_before=before) if data else None
        except Exception:
            note_ui_error(traceback.format_exc())
            self.bad = None
        if self.bad and old and old.log == self.bad.log:
            # A report of it on its way (by hand, or by itself after F) is not offered again meanwhile; S offered
            # again after F stays offered.
            self.bad.job, self.bad.again = old.job, old.again
            self.bad.sent = old.sent or self.bad.sent
        self.choose(chosen)

    def menu_key(self):
        items = self.menu_items()
        return items[self.menu_sel][0] if 0 <= self.menu_sel < len(items) else None

    def choose(self, key):
        """The menu item of that key chosen again (an item above it came or went), else the nearest one."""
        keys = [k for k, _, _ in self.menu_items()]
        self.menu_sel = keys.index(key) if key in keys else min(self.menu_sel, len(keys) - 1)

    def banner_text(self):
        """What the menu's warning says, (head, the problem), and its keys as (long, short) hints, the same as on
        the update's summary; None without one."""
        if not self.bad:
            return None
        keys = [k for k in self.bad.keys() if k[0][:1] in "FS"]
        keys.sort(key=lambda k: k[0][:1] != "F")            # what to do about it first
        return ("Последнее обновление: НЕ перезагружайся", short_problem(first_problem(self.bad.res))), keys

    @staticmethod
    def banner_lines(text, width, rows):
        """The warning in at most rows lines: head and problem in one line when they fit, else the problem in a
        line of its own; in one line the head gives way to the problem."""
        head, problem = text
        if not problem:
            return [fit(head, width)]
        one = f"{head} — {problem}"
        if len(one) <= width:
            return [one]
        if rows >= 2:
            return [fit(head, width), fit(problem, width)]
        return [fit(f"НЕ перезагружайся — {problem}", width)]

    def banner_key(self, key):
        """F or S under the menu's warning; "terminal" when it went to the plain terminal and back."""
        acts, job = self.bad, self.bad.job
        went = acts.press(key)
        if acts.job is not job and acts.job:
            self.jobs.append(acts.job)           # its answer comes as a toast
            self.toast(SENDING, secs=60)
        if not went:
            return None
        self.refresh_banner()
        self.toast(acts.status.text, secs=6)
        self.menu_t = time.time() - 5
        return "terminal"

    def show_last(self):
        """The last update's summary again (the menu's item under its warning): what went wrong, and its keys."""
        res = self.bad.res
        if self.toast_text == SENDING:           # its own line on the summary says how the report fares
            self.toast_text = ""
        summary_screen(self, res, seconds_of(res), demo=DEMO, review=when_text(res.get("began"), year=False),
                       acts=self.bad)
        self.refresh_banner()
        self.state, self.menu_t = "menu", time.time() - 5

    def poll_jobs(self):
        """A report sent by hand from the menu or the list has its answer: a toast says it (unless one already
        did, or the summary's own line), and the list shows it."""
        for job in [j for j in self.jobs if j.done]:
            if not job.told:
                job.told = True
                self.toast(job.result[1], secs=5)
            if self.state == "updates":
                self.reload_updates()
        self.jobs = [j for j in self.jobs if not j.done]

    def waiting_jobs(self):
        return [j for j in SendJob.ALL if not j.done]

    def left(self):
        """q in the menu while a report sent by hand was on its way: True once its answer has shown a moment (or it
        took too long)."""
        now = time.time()
        if self.waiting_jobs():
            return now - self.leaving > SendJob.WAIT
        for job in SendJob.ALL:
            if not job.told:
                job.told = True
                self.toast(job.result[1], secs=5)
        self.left_at = getattr(self, "left_at", None) or now
        return now - self.left_at > 1.5

    def fresh_press(self, key):
        """False for a key held down or pressed twice within FRESH: such a key counts once."""
        now, last = time.time(), self.pressed.get(key, 0.0)
        self.pressed[key] = now
        return now - last > FRESH

    # ── drawing helpers
    def now(self):
        return time.time() - self.t0

    def draw_title(self, top, t, pal=PAL_ARCH, reveal_t=None, blend=None, alpha=1.0):
        c = self.s.canvas
        word = "ARCH UPDATE" if c.w >= 92 else "ARCH"
        rows, spans = big_text(word)
        width = len(rows[0])
        x0 = (c.w - width) // 2
        for li, (a, b) in enumerate(spans):
            if reveal_t is not None:
                a_t = clamp01((reveal_t - 0.07 * li) / 0.35)
                if a_t <= 0:
                    continue
                dy = -int(round((1 - ease(a_t)) * 2))
            else:
                a_t, dy = 1.0, 0
            for ry in range(6):
                seg = rows[ry][a:b]
                for i, ch in enumerate(seg):
                    if ch == " ":
                        continue
                    x = a + i
                    pos = x / max(1, width) * 0.85 + ry * 0.035 - t * 0.12
                    col = grad(pal, pos)
                    if blend is not None:                      # transition wave to another palette
                        k = blend(x0 + x, top + ry)
                        col = lerp(col, grad(PAL_RUN, pos), k)
                    if ch in SHADOW_CHARS:
                        col = shade(col, 0.45)
                    c.put(x0 + x, top + ry + dy, ch, col, bold=ch not in SHADOW_CHARS, alpha=a_t * alpha)
        if word == "ARCH" and c.h > top + 8:
            c.cput(top + 6, "U P D A T E", grad(pal, -t * 0.12), bold=True, alpha=alpha)
        return top + 6 if word == "ARCH" else top + 5     # the one-line title has no "U P D A T E" row

    def byline(self, y, t, start):
        c = self.s.canvas
        text = "by Cactus"
        x0 = (c.w - len(text)) // 2
        for i, ch in enumerate(text):
            a = clamp01((t - start - 0.06 * i) / 0.3)
            if a > 0:
                c.put(x0 + i, y, ch, grad(PAL_ARCH, 0.55 + i * 0.03 - t * 0.05), alpha=a * 0.9)

    def spinner(self, t):
        return "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[int(t * 12) % 10]

    def footer(self, text):
        keyline(self.s.canvas, self.s.canvas.h - 2, text)

    # ── screens
    def draw_splash(self):
        c, t = self.s.canvas, self.now()
        top = max(1, c.h // 2 - 9)
        y = self.draw_title(top, t, reveal_t=t)
        self.byline(y + 1, t, 0.9)
        y += 4
        tasks = [("проверяю обновления", self.repo is not None,
                  (f"найдено {self.count} {plural(self.count, 'обновление', 'обновления', 'обновлений')}"
                   if self.count else ("не удалось проверить" if self.check_failed else "система актуальна"))
                  if self.repo is not None else ""),
                 ("загружаю новости Arch", self.news is not None,
                  (f"{len(self.news)} новостей" if self.news else "нет связи с archlinux.org")
                  if self.news is not None else "")]
        tx = (c.w - max(len(label) + 4 for label, _, _ in tasks)) // 2     # one left edge: icons in a column
        for i, (label, done, result) in enumerate(tasks):
            a = clamp01((t - 1.2 - i * 0.15) / 0.4)
            if a <= 0:
                continue
            line = f"{'✓' if done else self.spinner(t + i)}  {result if done else label + '…'}"
            col = GOOD if done else grad(PAL_ARCH, t * 0.3 + i * 0.2)
            c.put(tx, y + i, line, col, alpha=a)
        news_ready = self.news is not None or t > 5.0      # slow archlinux.org: news fills in on the menu
        if self.repo is not None and news_ready and t > 2.0:
            self.state, self.menu_t, self.from_splash = "menu", time.time(), True
            self.menu_since = self.menu_since or self.menu_t
            self.announce_version()
            self.announce_reports()
        elif self.repo is None and t > 15:
            keyline(c, c.h - 2, "проверка затянулась · Enter — обычный Arch-Update без проверки · q — выход")
        elif t > 1.5:
            self.hint("q выход")
        BACKDROP.draw(c, t, PAL_ARCH, clamp01(t / 1.5))     # after the content: only into empty cells
        self.draw_toast()

    def announce_version(self):
        """First start of a new version of the updater (it updates itself from GitHub): say so."""
        if not self.version:
            return
        seen = ui_state().get("version")
        if seen != self.version[0]:
            save_ui_state(version=self.version[0])
            if seen:
                self.toast(f"апдейтер обновился: {self.version[2]}", secs=5)

    def announce_reports(self):
        """Once, for a user who has never chosen: the reports exist, and they are off until a yes.
        Never on top of another toast (the new version's): then on a later start."""
        if self.hinted or self.rep["decided"]:
            return
        self.hinted = True
        if (self.toast_text and time.time() - self.toast_t < self.toast_secs) or ui_state().get("reports_hint"):
            return
        save_ui_state(reports_hint=True)
        self.toast(REPORTS_HINT, secs=6)

    SEND_AFTER = 30                     # seconds in the menu before the waiting reports go out

    def send_waiting(self, leaving=False):
        """Reports an earlier run could not send go out in a process of their own, but not as soon as
        the window opens: first the user has the chance to switch the reports off in Настройки. So
        when the menu is left for an update or for good (leaving=True) or after SEND_AFTER seconds in
        it, once per start, and only if the reports are still on then (never in the demo)."""
        if not self.sender_due or not self.menu_since:  # left from the splash: the menu never showed, next time
            return
        if not leaving and (self.state != "menu" or time.time() - self.menu_since < self.SEND_AFTER):
            return
        self.sender_due = False
        st = report.status()                # now, not as the window opened: a "no" since then counts
        if st["enabled"] and st["waiting"] and st["endpoint"]:
            report.start_sender()

    def draw_version(self):
        if self.version:
            c = self.s.canvas
            text = f"{self.version[1]} · {self.version[0]}"
            c.put(c.w - len(text) - 2, c.h - 1, text, MUTED)

    def menu_layout(self):
        """Sizes of the menu blocks. On a low terminal (a laptop) they shrink step by step —
        one-line menu items, fewer news and packages, a one-line title — until all of it fits."""
        c = self.s.canvas
        L = types.SimpleNamespace(W=min(c.w - 8, 96), big_title=True, menu_subs=True,
                                  news_rows=min(3, len(self.news or [])), pkg_rows=0, compact=False)
        L.colw = 46 if L.W >= 92 else L.W
        L.ncol = max(1, L.W // L.colw)
        pk, items = self.count, len(self.menu_items())
        if pk:
            L.pkg_rows = min((pk + L.ncol - 1) // L.ncol, max(3, min(8, c.h - 32)))
        # The warning about the last update: what it says in up to two rows, then its keys
        L.banner = self.banner_text()
        L.banner_rows = len(self.banner_lines(L.banner[0], L.W - 2, 2)) if L.banner else 0

        def measure():
            L.title_h = (10 if c.w < 92 else 9) if L.big_title else 3
            L.news_h = (2 + L.news_rows if L.news_rows else 0) if self.news else (1 if L.compact else 2)
            if pk:
                more = 1 if L.pkg_rows and pk > L.pkg_rows * L.ncol else 0      # no list at all: the count is above
                L.upd_h = 1 + L.pkg_rows + more + (1 if self.check_failed else 0) + 1
            else:
                L.upd_h = 3 if L.compact else 4
            nw = bool(self.kernel_gpu) + (self.low_battery is not None) + (L.banner_rows + 1 if L.banner else 0)
            L.warn_h = nw + 1 if nw else 0                   # warnings stacked, one blank row below
            L.menu_h = 1 + (2 * items if L.menu_subs else items + 1)
            return L.title_h + L.news_h + L.upd_h + L.warn_h + L.menu_h
        # The package list goes down to one row before the news headline goes: it may be a NEW item. The
        # warning about the last update keeps its second row longest; last of all the package list goes (the
        # header still says how many) and the blank rows around a short message.
        shrink = [("menu_subs", False), ("news_rows", min(L.news_rows, 1)), ("pkg_rows", min(L.pkg_rows, 2)),
                  ("big_title", False), ("pkg_rows", min(L.pkg_rows, 1)), ("news_rows", 0),
                  ("banner_rows", min(L.banner_rows, 1)), ("pkg_rows", 0), ("compact", True)]
        L.total = measure()
        while L.total > c.h - 5 and shrink:                  # the toast's row and the one above the footer free
            setattr(L, *shrink.pop(0))
            L.total = measure()
        return L

    def title_top(self):
        return 1 + max(0, (self.s.canvas.h - 4 - self.menu_layout().total) // 2)

    def draw_small_title(self, y, t, pal=PAL_ARCH, alpha=1.0):
        """The title in one line, for terminals too low for the big letters."""
        c = self.s.canvas
        head = "A R C H   U P D A T E"
        hx = (c.w - len(head)) // 2
        for i, ch in enumerate(head):
            c.put(hx + i, y, ch, grad(pal, i / len(head) * 0.7 - t * 0.12), bold=True, alpha=alpha)

    def draw_menu(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10    # colour flow at 10 fps: cheaper frames
        mt = time.time() - self.menu_t
        L = self.menu_layout()
        W = L.W
        x0 = (c.w - W) // 2
        target = self.title_top()
        if L.big_title:
            top = target
            if mt < 0.6 and getattr(self, "from_splash", False):      # glide up from the splash position
                top = round(max(1, c.h // 2 - 9) + (target - max(1, c.h // 2 - 9)) * ease(mt / 0.6))
            y = self.draw_title(top, t)
            self.byline(y + 1, t, -1)
        else:
            self.draw_small_title(target, t)
            self.byline(target + 1, t, -1)
        y = target + L.title_h

        def appear(i):
            return clamp01((mt - 0.35 - i * 0.06) / 0.35)

        # news
        k = 0
        if self.news and L.news_rows:
            a = appear(k); k += 1
            c.put(x0, y, "НОВОСТИ ARCH", grad(PAL_ARCH, 0.1 - t * 0.05), bold=True, alpha=a)
            c.put(x0 + 13, y, "─" * (W - 13), FAINT, alpha=a)
            y += 1
            for item in self.news[:L.news_rows]:
                a = appear(k); k += 1
                date = ru_date(item["date"]).ljust(7)
                title = item["title"]
                room = W - 9 - (6 if item["new"] else 0)
                if len(title) > room:
                    title = title[:room - 1] + "…"
                c.put(x0, y, "●", PINK if item["new"] else DIM, alpha=a)
                c.put(x0 + 2, y, date, DIM, alpha=a)
                c.put(x0 + 9, y, title, TEXT, alpha=a)
                if item["new"]:
                    badge(c, x0 + W - 5, y, "NEW", PINK, alpha=a)
                y += 1
            y += 1
        elif self.news_err:
            c.put(x0, y, "новости недоступны (нет связи с archlinux.org)", DIM, alpha=appear(0))
            y += 1 if L.compact else 2
        elif self.news is None:
            c.put(x0, y, self.spinner(t) + "  загружаю новости Arch…", DIM, alpha=appear(0))
            y += 1 if L.compact else 2

        # updates
        a = appear(k); k += 1
        label = f"ОБНОВЛЕНИЯ · {self.count}" if self.count else "ОБНОВЛЕНИЯ"
        c.put(x0, y, label, grad(PAL_ARCH, 0.3 - t * 0.05), bold=True, alpha=a)
        c.put(x0 + len(label) + 1, y, "─" * (W - len(label) - 1), FAINT, alpha=a)
        y += 1
        if not self.count:
            a = appear(k); k += 1
            msg = "Не удалось проверить обновления (нет сети или зеркало не отвечает)" if self.check_failed \
                else "✓  Система актуальна"
            c.cput(y if L.compact else y + 1, msg, WARN if self.check_failed else GOOD, bold=True, alpha=a)
            y += 2 if L.compact else 3
        else:
            pkgs = [(n, o, nw, False) for n, o, nw in self.repo] + [(n, o, nw, True) for n, o, nw in self.aur]
            colw, ncol = L.colw, L.ncol
            shown = pkgs[:L.pkg_rows * ncol]
            risky = set(self.kernel_gpu)
            for i, (n, o, nw, is_aur) in enumerate(shown):
                a = appear(k + i // ncol)
                cx, cy = x0 + (i % ncol) * colw, y + i // ncol
                name = n if len(n) <= 24 else n[:23] + "…"
                ver = nw if len(nw) <= colw - 28 else nw[:colw - 29] + "…"
                c.put(cx, cy, "aur" if is_aur else " • ", PINK if is_aur else DIM, alpha=a)
                c.put(cx + 4, cy, name, TEXT, bold=n in risky, alpha=a)
                c.put(cx + 5 + len(name), cy, ver, DIM, alpha=a)
            rows_used = (len(shown) + ncol - 1) // ncol
            k += rows_used
            y += rows_used
            if L.pkg_rows and len(pkgs) > len(shown):
                c.put(x0 + 4, y, f"+ ещё {len(pkgs) - len(shown)}", DIM, alpha=appear(k))
                y += 1
            if self.check_failed:
                c.put(x0 + 4, y, "часть проверки не удалась — список может быть неполным", WARN, alpha=appear(k))
                y += 1
            y += 1
        if L.banner:                    # the last update said not to reboot, and nothing has fixed it since
            a = appear(k); k += 1
            tint = lerp(BG, BAD, 0.12 * a)
            for yy in range(y, y + L.banner_rows + 1):
                c.fill_bg(x0 - 1, yy, W + 2, tint)
            c.put(x0, y, "✗", BAD, bold=True, alpha=a)
            for i, line in enumerate(self.banner_lines(L.banner[0], W - 2, L.banner_rows)):
                c.put(x0 + 2, y, line, BAD, bold=i == 0, alpha=a)
                y += 1
            # The keys as the summary names them, and where to read more: that hint gives way first (the item
            # below explains itself), then the keys take their short forms.
            more = "Enter на «Последнее обновление» — подробнее"
            keys = fit_keys([(k, k) for k, _ in L.banner[1]] + [(more, more)], W - 2)
            if len(keys) > W - 2:
                keys = fit_keys(L.banner[1], W - 2)
            keyline(c, y, keys, x=x0 + 2, alpha=a)
            y += 1
        if self.kernel_gpu:
            a = appear(k); k += 1
            c.put(x0, y, "⚠", WARN, bold=True, alpha=a)
            msg = "в обновлении ядро/NVIDIA: перед запуском сохрани работу — экран может подвиснуть"
            if len(msg) > W - 2:
                msg = "ядро/NVIDIA: сохрани работу — экран может подвиснуть"[:W - 2]
            c.put(x0 + 2, y, msg, WARN, alpha=a)
            y += 1
        if self.low_battery is not None:
            a = appear(k); k += 1
            c.put(x0, y, "⚠", WARN, bold=True, alpha=a)
            c.put(x0 + 2, y, f"батарея {self.low_battery}% — подключи зарядку, обновление может идти долго"[:W - 2],
                  WARN, alpha=a)
            y += 1
        if self.kernel_gpu or self.low_battery is not None or L.banner:
            y += 1

        # menu: a gradient pill under the selected item
        y += 1
        items = self.menu_items()
        mw = min(W, 60)
        mx = (c.w - mw) // 2
        for i, (key, title, sub) in enumerate(items):
            a = appear(k + i)
            sel = i == self.menu_sel
            if sel:
                pill(c, mx, y, mw, lambda xx: shade(grad(PAL_ARCH, xx / mw * 0.6 - t * 0.1), 0.5),
                     grad(PAL_ARCH, -t * 0.1), a)
                c.put(mx + 2, y, "▸ " + title, (255, 255, 255), bold=True, alpha=a)
                if sub:
                    c.put(mx + 4, y + 1, sub[:mw - 4], DIM, alpha=a)
            else:
                c.put(mx + 4, y, title, TEXT, alpha=a * 0.9)
                if sub and L.menu_subs:
                    c.put(mx + 4, y + 1, sub[:mw - 4], MUTED, alpha=a)
            y += 2 if L.menu_subs or sel else 1     # compact: only the chosen item explains itself
        self.hint("↑↓ выбор", "Enter запуск", "q выход")
        self.draw_version()
        BACKDROP.draw(c, t, PAL_ARCH)                       # after the content, before toast and modal
        self.draw_toast()
        if self.confirm:
            self.draw_modal("Ядро или драйвер NVIDIA",
                            ["В этом обновлении: " + ", ".join(self.kernel_gpu[:4]),
                             "Сохрани работу и закрой важные программы: пока собирается",
                             "драйвер (DKMS), экран может подвиснуть. Не перезагружайся,",
                             "пока не увидишь итог."], "Enter — продолжить    Esc — назад", PAL_WARN)

    def draw_modal(self, title, lines, hint, pal, input_text=None):
        c, t = self.s.canvas, self.now()
        c.dim(0.72)
        w = min(c.w - 6, max(52, max(len(l) for l in lines) + 8))
        h = len(lines) + (6 if input_text is not None else 4)       # the answer field gets a blank row below
        x0, y0 = (c.w - w) // 2, (c.h - h) // 2
        border = grad(pal, -t * 0.25)
        c.blank(x0, y0, w, h, hexrgb("#121726"))
        c.put(x0, y0, "╭" + "─" * (w - 2) + "╮", border, bg=hexrgb("#121726"))
        c.put(x0, y0 + h - 1, "╰" + "─" * (w - 2) + "╯", border, bg=hexrgb("#121726"))
        for yy in range(y0 + 1, y0 + h - 1):
            c.put(x0, yy, "│", border, bg=hexrgb("#121726"))
            c.put(x0 + w - 1, yy, "│", border, bg=hexrgb("#121726"))
        c.put(x0 + 3, y0, f" {title} ", grad(pal, 0.2 - t * 0.2), bg=hexrgb("#121726"), bold=True)
        for i, l in enumerate(lines):
            c.put(x0 + 3, y0 + 1 + i, l, TEXT, bg=hexrgb("#121726"))
        yy = y0 + 1 + len(lines)
        if input_text is not None:
            cur = "█" if int(t * 2) % 2 == 0 else " "
            field = hexrgb("#1b2235")                                 # the answer sits in a field
            c.fill_bg(x0 + 2, yy + 1, w - 4, field)
            c.put(x0 + 3, yy + 1, ("› " + input_text + cur)[-(w - 6):], (255, 255, 255), bg=field, bold=True)
        keyline(c, y0 + h - 2, hint, x=x0 + 3, bg=hexrgb("#121726"))

    def draw_news(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10
        W = min(c.w - 8, 100)
        x0 = (c.w - W) // 2
        if self.article is None:
            c.cput(2, "НОВОСТИ ARCH", grad(PAL_ARCH, -t * 0.1), bold=True)
            y = 4
            for i, item in enumerate(self.news):
                sel = i == self.news_sel
                if sel:
                    pill(c, x0, y, W, lambda xx: shade(grad(PAL_ARCH, xx / W * 0.5 - t * 0.1), 0.45),
                         grad(PAL_ARCH, -t * 0.1))
                tag = "  NEW" if item["new"] else ""
                title = item["title"]
                if len(title) > W - 14 - len(tag):
                    title = title[:W - 15 - len(tag)] + "…"
                c.put(x0 + 1, y, ("▸ " if sel else "  ") + ru_date(item["date"]).ljust(7) + title,
                      (255, 255, 255) if sel else TEXT, bold=sel)
                if tag:
                    badge(c, x0 + W - 6, y, "NEW", PINK)
                y += 2
            self.hint("↑↓ выбор", "Enter читать", "Esc назад")
            self.draw_toast()
            return
        item = self.article
        c.cput(2, "НОВОСТИ ARCH", grad(PAL_ARCH, -t * 0.1), bold=True)
        title_lines = textwrap.wrap(item["title"], max(10, W))
        y = 4
        for tl in title_lines:
            c.cput(y, tl, grad(PAL_ARCH, 0.2 - t * 0.08), bold=True)
            y += 1
        if item.get("info"):
            c.cput(y, item["info"], DIM)
        y += 2
        if item["body"] is None:
            c.cput(y + 2, self.spinner(t) + "  загружаю статью…", grad(PAL_ARCH, t * 0.3))
        else:
            body = []
            for para in item["body"].split("\n"):
                body += textwrap.wrap(para, max(10, W)) or [""]
            view_h = c.h - y - 4
            self.scroll = max(0, min(self.scroll, len(body) - view_h))
            for i, line in enumerate(body[self.scroll:self.scroll + view_h]):
                c.put(x0, y + i, line, TEXT)
            if len(body) > view_h:
                c.put(x0 + W + 2, y, "▲" if self.scroll else " ", DIM)
                c.put(x0 + W + 2, y + view_h - 1, "▼" if self.scroll + view_h < len(body) else " ", DIM)
        self.footer("↑↓ прокрутка   ←→ страница   Esc назад")       # here ←→ page, never move the window
        self.draw_toast()

    # ── settings
    def open_settings(self):
        self.state, self.set_sel, self.pv = "settings", 0, None
        if self.toast_text == REPORTS_HINT:  # it pointed here: done
            self.toast_text = ""
        self.set_key_t = time.time()         # the Enter that opened the screen is no choice (see handle)
        self.refresh_reports()
        if self.live:
            self.services_on = report.option("restart_services", False)

    def refresh_reports(self):
        if self.live:
            self.rep = report.status()
        self.rep_t = time.time()

    def toggle_reports(self):
        on, waiting = not self.rep["enabled"], self.rep["waiting"]
        try:
            report.set_consent(on)           # off also drops what was still waiting to be sent
        except OSError as e:
            self.toast(f"не удалось сохранить выбор: {write_error(e)}", secs=4)
            return
        self.refresh_reports()
        if not on:
            self.toast("отчёты выключены" + (", неотправленные удалены" if waiting else ""), secs=3)
        elif self.rep["endpoint"]:
            self.toast("спасибо! отчёт уйдёт после следующего обновления", secs=3)
        else:                                # no server yet: they wait on this machine (the line below says so)
            self.toast("спасибо! отчёты включены — уйдут, когда подключат сервер для отчётов", secs=3)

    def toggle_services(self):
        on = not self.services_on
        try:
            report.set_option("restart_services", on)      # read by the engine as the next update starts
        except OSError as e:
            self.toast(f"не удалось сохранить выбор: {write_error(e)}", secs=4)
            return
        self.services_on = on
        self.toast("сервисы будут перезапускаться сами (кроме тех, что нельзя на ходу)" if on else
                   "сервисы — только по клавише R в конце обновления", secs=3)

    def settings_desc(self, key, width, room=None):
        """What the chosen item is, under the items: [(line, colour)], its paragraphs a blank line apart where they
        fit into room rows. room None: as few rows as it can take, the reports' state counted as its two rows
        either way (to decide the layout by: it never changes as that line grows)."""
        about = {"reports": REPORT_ABOUT, "services": SERVICES_ABOUT, "preview": PREVIEW_ABOUT,
                 "updates": UPDATES_ABOUT}.get(key, ())
        blocks = [[(line, DIM) for line in textwrap.wrap(para, width, break_on_hyphens=False)] for para in about]
        if key == "reports":
            state = [(line, MUTED) for line in wrap_parts(reports_parts(self.rep), width)]
            blocks.append((state + [("", MUTED)] * 2)[:2] if room is None else state)
        lines = [line for block in blocks for line in block]
        if room is not None and len(lines) + len(blocks) - 1 <= room:
            lines = [line for i, block in enumerate(blocks) for line in ([("", DIM)] if i else []) + block]
        return lines

    def settings_layout(self, c, W):
        """(rows from one item to the next, the row the chosen item's description starts at): two apart and a
        blank row below them while the longest description still ends above the toast's row; one apart on a
        low terminal (80x24)."""
        n = len(SETTINGS_ITEMS)
        cached = getattr(self, "_set_layout", None)
        if not cached or cached[0] != (W, c.h):  # it depends on the size alone: worked out once per size
            tallest = max(len(self.settings_desc(k, W - 4)) for k, _ in SETTINGS_ITEMS)
            cached = self._set_layout = ((W, c.h), (2, 4 + 2 * n) if 4 + 2 * n + tallest <= c.h - 4 else
                                         (1, 4 + n + 1))
        return cached[1]

    def draw_settings(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10
        if self.live and time.time() - self.rep_t > 2:      # a sender may have finished meanwhile
            self.refresh_reports()
        W = min(c.w - 8, 100)
        x0 = (c.w - W) // 2
        c.cput(2, "НАСТРОЙКИ", grad(PAL_ARCH, -t * 0.1), bold=True)
        if self.pv:
            return self.draw_reader(c, t, W, x0, self.pv, "Что именно уходит", PREVIEW_INTRO,
                                    "↑↓ прокрутка   ←→ страница   Esc назад")
        step, y_desc = self.settings_layout(c, W)
        for i, (key, title) in enumerate(SETTINGS_ITEMS):
            y = 4 + i * step
            sel = i == self.set_sel
            if sel:
                pill(c, x0, y, W, lambda xx: shade(grad(PAL_ARCH, xx / W * 0.5 - t * 0.1), 0.45),
                     grad(PAL_ARCH, -t * 0.1))
            c.put(x0 + 1, y, ("▸ " if sel else "  ") + title, (255, 255, 255) if sel else TEXT, bold=sel)
            on = {"reports": self.rep["enabled"], "services": self.services_on}.get(key)
            if on is not None:
                word = "ВКЛ" if on else "ВЫКЛ"
                badge(c, x0 + W - len(word) - 3, y, word, GOOD if on else DIM)
        desc = self.settings_desc(SETTINGS_ITEMS[self.set_sel][0], W - 4, room=c.h - 4 - y_desc)
        for j, (line, colour) in enumerate(desc):
            c.put(x0 + 3, y_desc + j, line, colour)
        self.hint("↑↓ выбор", "Enter переключить/открыть", "Esc назад")
        BACKDROP.draw(c, t, PAL_ARCH)        # after the content, before the toast
        self.draw_toast()

    def draw_reader(self, c, t, W, x0, reader, title, intro, footer):
        """A report laid out like a news article: its title, a line about it, the text with ▲▼ and where it is."""
        c.cput(4, fit(title, W), grad(PAL_ARCH, 0.2 - t * 0.08), bold=True)
        y = 5
        for line in textwrap.wrap(intro, W):
            c.cput(y, line, DIM)
            y += 1
        y += 1
        view_h = max(1, c.h - y - 5)        # the row below the text says where it is; the toast's row stays free
        reader.page = max(1, view_h - 2)
        rows = reader.rows(W)
        if rows is None:
            c.cput(y + 2, self.spinner(t) + "  собираю…", grad(PAL_ARCH, t * 0.3))
        else:
            reader.scroll = max(0, min(reader.scroll, len(rows) - view_h))
            c.blank(x0, y, W, view_h, BG)    # the text column stays clear of stars
            for i, (kind, text, first) in enumerate(rows[reader.scroll:reader.scroll + view_h]):
                if kind == "rule":
                    c.put(x0, y + i, "─" * W, FAINT, bg=BG)
                    c.put(x0 + 2, y + i, f" {text} ", MUTED, bg=BG)
                    continue
                c.put(x0, y + i, text, TEXT, bg=BG)
                m = JSON_KEY.match(text) if kind == "json" and first else None
                if m:
                    c.put(x0, y + i, m.group(), DIM, bg=BG)
            if len(rows) > view_h:
                c.put(x0 + W + 2, y, "▲" if reader.scroll else " ", DIM)
                c.put(x0 + W + 2, y + view_h - 1, "▼" if reader.scroll + view_h < len(rows) else " ", DIM)
                pos = f"{reader.scroll + 1}–{min(len(rows), reader.scroll + view_h)} из {len(rows)}"
                c.put(x0 + W - len(pos), y + view_h, pos, MUTED)
        self.footer(footer)                  # here ←→ page, never move the window
        BACKDROP.draw(c, t, PAL_ARCH)
        self.draw_toast()

    # ── the last updates kept on this machine
    DELETE_SECS = 6                          # the second D within that long deletes

    def open_updates(self):
        self.state, self.up_sel, self.up_reader, self.up_del = "updates", 0, None, None
        self.reload_updates(fresh=True)

    def reload_updates(self, fresh=False):
        """The list, read in a thread of its own (a few journals: a moment on a slow machine). fresh: "being read"
        until then; else the list on the screen stays until the new one is in."""
        self.up_gen += 1
        if not self.live:
            return
        if fresh:
            self.up_list = None
        gen = self.up_gen

        def work():
            try:
                got = report.local_updates()
            except Exception:
                note_ui_error(traceback.format_exc())
                got = []
            if gen == self.up_gen:           # a list asked for later is newer
                self.up_list = got
        threading.Thread(target=work, daemon=True).start()

    def chosen_update(self):
        items = self.up_list or []
        if not items:
            return None
        self.up_sel = max(0, min(self.up_sel, len(items) - 1))
        return items[self.up_sel]

    def send_update(self, u):
        if not self.fresh_press("s"):
            return
        if DEMO:
            self.toast(DEMO_SAYS)
        elif self.waiting_jobs():
            self.toast("уже отправляю отчёт — дождись ответа")
        else:
            self.jobs.append(SendJob(u["log"], report_ui(self), app=self))
            self.toast(SENDING, secs=60)

    def delete_update(self, u):
        """D, and D again (a press of its own, not the key held down): the update gone from this machine, its
        journal and summary with it (report.delete_local). Not the one the menu warns about: until it is fixed or
        the machine rebooted, it is what says not to reboot."""
        fresh = self.fresh_press("d")
        if DEMO:
            if fresh:
                self.toast(DEMO_SAYS)
            return
        if self.bad and self.bad.log and os.path.realpath(self.bad.log) == os.path.realpath(u["log"]):
            if fresh:
                self.toast(KEEPS_WARNING, secs=5)
            return
        armed = self.up_del and self.up_del[0] == u["log"] and time.time() - self.up_del[1] < self.DELETE_SECS
        if not armed:
            self.up_del = (u["log"], time.time())
            return
        if not fresh:
            return
        self.up_del = None
        if report.delete_local(u["log"]):
            self.up_list = [x for x in self.up_list or [] if x["log"] != u["log"]]
            self.toast("обновление удалено с этого компьютера", secs=3)
        else:
            self.toast("не удалось удалить это обновление", secs=3)
        self.reload_updates()
        if self.live:
            self.refresh_banner()            # the menu warned about that one, maybe

    def update_detail(self, u):
        """The line under the chosen update: what to read first in it."""
        first = short_problem(first_problem(u)) or next(iter(strs(u.get("warnings")) + strs(u.get("notes"))), "")
        if first:
            return first
        return "итога нет: обновление не дошло до проверки" if u.get("verdict") is None else "проблем не нашлось"

    def draw_updates(self):
        c, t = self.s.canvas, math.floor(self.now() * 10) / 10
        W = min(c.w - 8, 100)
        x0 = (c.w - W) // 2
        c.cput(2, "ПОСЛЕДНИЕ ОБНОВЛЕНИЯ", grad(PAL_ARCH, -t * 0.1), bold=True)
        u = self.chosen_update()
        if self.up_reader and u:
            return self.draw_reader(c, t, W, x0, self.up_reader, f"Отчёт об обновлении {when_text(u['time'])}",
                                    UPDATE_INTRO, "↑↓ прокрутка   ←→ страница   S отправить   Esc назад")
        W = min(c.w - 8, 84)                 # the list: as wide as its columns, centred
        x0 = (c.w - W) // 2
        y = 4
        for line in textwrap.wrap(UPDATES_ON if self.rep["enabled"] else UPDATES_OFF, W)[:2]:
            c.cput(y, line, DIM)
            y += 1
        y += 1
        items = self.up_list
        if items is None:
            c.cput(y + 1, self.spinner(t) + "  читаю журналы…", grad(PAL_ARCH, t * 0.3))
        elif not items:
            c.cput(y + 1, "пока ни одного обновления", DIM)
        else:
            wide = W >= 84                   # room for the year
            gap = 1 if y + 2 * len(items) + 1 <= c.h - 4 else 0
            for i, it in enumerate(items):
                sel = i == self.up_sel
                if sel:
                    pill(c, x0, y, W, lambda xx: shade(grad(PAL_ARCH, xx / W * 0.5 - t * 0.1), 0.45),
                         grad(PAL_ARCH, -t * 0.1))
                quiet = (220, 220, 235) if sel else DIM
                date = when_text(it.get("time"), year=wide) or "—"
                c.put(x0 + 1, y, ("▸ " if sel else "  ") + date, (255, 255, 255) if sel else TEXT, bold=sel)
                glyph, words, col = verdict_mark(it)
                vx = x0 + 3 + (16 if wide else 11) + 3
                c.put(vx, y, glyph, col, bold=True)
                c.put(vx + 2, y, words, col)
                n = it.get("packages") or 0
                known = it.get("started", True) and it.get("verdict") is not None
                c.put(vx + 23, y, f"{n} {plural(n, 'пакет', 'пакета', 'пакетов')}" if known else "—", quiet)
                if it.get("waiting"):                   # its report, or a newer one after F
                    sent, scol = "ждёт отправки", WARN
                elif it.get("sent"):
                    sent, scol = "отправлен" + (f" (№ {it['issue']})" if it.get("issue") else ""), GOOD
                else:
                    sent, scol = "не отправлен", quiet if sel else MUTED
                c.put(vx + 36, y, fit(sent, x0 + W - vx - 36), scol)
                y += 1
                if sel:
                    armed = self.up_del and self.up_del[0] == it["log"] and \
                        time.time() - self.up_del[1] < self.DELETE_SECS
                    line, lcol = ("нажми D ещё раз, чтобы удалить", WARN) if armed else (self.update_detail(it), DIM)
                    c.put(x0 + 5, y, fit(line, W - 6), lcol)
                    y += 1
                y += gap
        if items:
            self.hint("↑↓ выбор", "Enter отчёт", "S отправить", "D удалить", "Esc назад")
        else:
            self.hint("Esc назад")
        BACKDROP.draw(c, t, PAL_ARCH)        # after the content, before the toast
        self.draw_toast()

    # ── input
    def handle(self, key):
        key = LATIN.get(key, key)
        letter = key.lower() if len(key) == 1 else key          # S, R, F, D with Shift or without
        if key in ("left", "right") and not self.confirm and self.monitors > 1 and \
                not (self.state == "news" and self.article is not None) and \
                not (self.state == "settings" and self.pv) and not (self.state == "updates" and self.up_reader):
            self.move_screen(key)
            return None
        if self.state == "splash":
            if key in ("q", "esc"):
                self.quit = True
            elif key == "enter" and self.repo is None and self.now() > 15:
                return "manual"
            return None
        if self.state == "menu":
            items = self.menu_items()
            if self.confirm:
                if key == "enter":
                    if time.time() - self.confirm > 0.8:     # a fresh press after a pause is consent
                        self.confirm = None
                        return "auto"
                    self.confirm = time.time()               # held/double Enter: keep waiting
                if key in ("esc", "q"):
                    self.confirm = None
                return None
            if key in ("up", "k"):
                self.menu_sel = (self.menu_sel - 1) % len(items)
            elif key in ("down", "j", "tab"):
                self.menu_sel = (self.menu_sel + 1) % len(items)
            elif len(key) == 1 and key in "123456789" and int(key) <= len(items):
                self.menu_sel = int(key) - 1
                return self.handle("enter")
            elif key in ("q", "esc"):
                return "quit"
            elif letter in ("f", "s") and self.bad:      # the keys of the warning about the last update
                return self.banner_key(letter)
            elif key == "enter":
                action = items[self.menu_sel][0]
                if action == "auto" and self.kernel_gpu:
                    self.confirm = time.time()
                    return None
                if action == "news":
                    self.state, self.news_sel, self.article = "news", 0, None
                    return None
                if action == "settings":
                    self.open_settings()
                    return None
                if action == "last":
                    return "last"
                if action == "recheck":
                    self.repo, self.state, self.t0 = None, "splash", time.time() - 2.0
                    threading.Thread(target=self._load_updates, daemon=True).start()
                    return None
                return action
            return None
        if self.state == "news":
            if self.article is None:
                if key in ("up", "k"):
                    self.news_sel = (self.news_sel - 1) % len(self.news)
                elif key in ("down", "j"):
                    self.news_sel = (self.news_sel + 1) % len(self.news)
                elif key == "enter":
                    self.article, self.scroll = self.news[self.news_sel], 0
                    if self.article["body"] is None:
                        threading.Thread(target=self._load_article, args=(self.article,), daemon=True).start()
                elif key in ("esc", "q"):
                    self.state, self.menu_t = "menu", time.time() - 5
            else:
                if key in ("up", "k"):
                    self.scroll = max(0, self.scroll - 1)
                elif key in ("down", "j", "space"):
                    self.scroll += 1
                elif key in ("pgup", "left"):
                    self.scroll = max(0, self.scroll - 10)
                elif key in ("pgdn", "right"):
                    self.scroll += 10
                elif key in ("esc", "q", "enter"):
                    self.article = None
            return None
        if self.state == "settings":
            if self.pv:
                if not self.pv.key(key) and key in ("esc", "q", "enter"):
                    self.pv = None
                return None
            if key in ("up", "k"):
                self.set_sel = (self.set_sel - 1) % len(SETTINGS_ITEMS)
            elif key in ("down", "j", "tab"):
                self.set_sel = (self.set_sel + 1) % len(SETTINGS_ITEMS)
            elif key in ("enter", "space"):
                what = SETTINGS_ITEMS[self.set_sel][0]
                if what in SWITCHES:
                    # As in the kernel/NVIDIA confirm, only a fresh press after a pause (longer than a
                    # held key waits before it repeats) is a choice: the Enter that opened this screen,
                    # pressed twice or held down, never flips a switch.
                    fresh, self.set_key_t = time.time() - self.set_key_t > FRESH, time.time()
                    if fresh:
                        (self.toggle_reports if what == "reports" else self.toggle_services)()
                elif what == "preview":
                    self.pv = Reader(report.preview, start=self.live)
                elif what == "updates":
                    self.open_updates()
                else:
                    self.state, self.menu_t = "menu", time.time() - 5
            elif key in ("esc", "q"):
                self.state, self.menu_t = "menu", time.time() - 5
            return None
        if self.state == "updates":
            u = self.chosen_update()
            if self.up_reader:
                if self.up_reader.key(key):
                    return None
                if letter == "s" and u:
                    self.send_update(u)
                elif key in ("esc", "q", "enter"):
                    self.up_reader = None
                return None
            if letter != "d":
                self.up_del = None           # the second D must follow the first
            if key in ("up", "k") and u:
                self.up_sel = (self.up_sel - 1) % len(self.up_list)
            elif key in ("down", "j", "tab") and u:
                self.up_sel = (self.up_sel + 1) % len(self.up_list)
            elif key == "enter" and u:
                ui = report_ui(self)
                self.up_reader = Reader(lambda log=u["log"]: report.build_from_log(log, ui=ui), start=self.live)
            elif letter == "s" and u:
                self.send_update(u)
            elif letter == "d" and u:
                self.delete_update(u)
            elif key in ("esc", "q"):
                self.state = "settings"
            return None
        return None

    def check_resize(self):
        """Window size changed: new canvas (full redraw) for the new size."""
        if self.resized:
            self.resized = False
            self.s.resize()
            self.s.write("\x1b[2J")

    def frame(self):
        t = time.perf_counter()
        self.check_resize()
        {"splash": self.draw_splash, "menu": self.draw_menu, "news": self.draw_news,
         "settings": self.draw_settings, "updates": self.draw_updates}[self.state]()
        self.s.flush()
        PACE.measure(time.perf_counter() - t)

    def loop(self):
        """Splash/menu/news/settings loop. Returns the chosen action."""
        while not self.quit:
            self.frame()
            self.send_waiting()
            self.poll_jobs()
            if self.leaving and self.left():
                return "quit"
            if AUTOPLAY and self.state == "menu" and time.time() - self.menu_t > 3.5:
                return "auto"
            r = select.select([0], [], [], PACE.interval)[0]
            if r:
                try:
                    data = os.read(0, 1024)
                except OSError:
                    data = b""
                if not data:
                    return "quit"
                for key in parse_keys(data):
                    action = self.handle(key)
                    if action == "last":
                        self.show_last()
                    if action in ("last", "terminal"):
                        break                # what was typed with it is no answer to what came next
                    if action == "quit" and self.leaving is None and self.waiting_jobs():
                        # A report sent by hand is on its way: its answer first, then the menu is left.
                        self.leaving = time.time()
                        self.toast(WAITING + " (q ещё раз — не ждать)", secs=SendJob.WAIT)
                        break
                    if action:
                        return action
            if not engine.TERM_OK:           # the window closed while a fix ran in the plain terminal
                return "quit"
        return "quit"


# ───────────────────────────── transition + live view ─────────────────────────────

class LiveView(engine.TerminalView):
    """Engine view for the auto mode: a compact animated dashboard."""
    animated = True

    def __init__(self, app, demo=False):
        super().__init__()
        self.app = app
        self.s = app.s
        hist = engine.History()
        if demo:
            hist.d.update({"sec_per_pkg": 0.75, "hooks_sec": 4.6, "dl_bps": 24e6, "cleanup_sec": 2.0,
                           "aur": {"brave-bin": 8.0}})
        self.prog = engine.Progress(len(app.repo or []), app.aur or [], hist)
        self.feed = []          # (time, text, kind)
        self.raw_tail = b""
        self.modal = None       # (why, line)
        self.input = ""
        self.raw = False
        self.eta_shown = None
        self.t_start = time.time()
        self.last_frame = 0
        self.demo = demo
        self.answers = 0
        self.lines = engine.Feed()
        self.game = None          # running mini-game
        self.hub = False          # game picker open
        self.hub_sel = 0
        self.update_done = False  # set when arch-update finished while a game is open
        self.best = ui_state().get("best", {})

    # engine hooks
    def output(self, data, *_):   # *_: an older engine, met mid-update, still passes its lines too
        self.raw_tail = (self.raw_tail + data)[-120_000:]
        if self.raw:
            self.out(data)
            return
        lines = self.lines.push(data)
        self.prog.feed_partial(self.lines.partial())
        for line in lines:
            msg = self.prog.feed_line(line)
            if msg:
                kind = "err" if re.match(r"^(error|warning)", msg, re.I) else "info"
                self.push(msg, kind)

    def push(self, text, kind="info"):
        if self.feed and self.feed[-1][1] == text:
            return
        self.feed.append((time.time(), text, kind))
        self.feed = self.feed[-40:]

    def message(self, msg, color=engine.C_DIM):
        if engine.LOG:
            engine.LOG.text(msg)
        if self.raw:
            super().message(msg, color)
        else:
            text = " ".join(msg.replace("[автоответчик]", "").split())
            if text:
                self.push(text, "warn")

    ANSWER_TEXT = {
        "proceed with update": "подтвердил обновление",
        "Arch news": "новости уже показаны — продолжаю",
        "pacman proceed": "подтвердил установку",
        "replace package": "подтвердил замену пакета",
        "import PGP key": "импортировал ключ PGP",
        "choose provider": "выбрал вариант по умолчанию",
        "choose group members": "выбрал вариант по умолчанию",
        "yay menu (default)": "yay: вариант по умолчанию",
        "yay proceed": "подтвердил сборку",
        "yay remove make deps": "сборочные зависимости уберу после сборки",
        "clean package cache": "чищу кэш пакетов",
        "remove orphan packages": "сирот не трогаю — посмотрим вместе",
        "process pacnew files": ".pacnew оставляю на потом",
        "reboot now": "перезагрузку не делаю",
        "restart services": "сервисы не перезапускаю",
        "remove unused flatpaks": "flatpak не трогаю",
        "another arch-update is running": "уже идёт другое обновление — отменяю",
    }

    def answered(self, label, line, answer):
        self.answers += 1
        if label in ("press enter to quit", "press enter to continue"):
            return
        text = self.ANSWER_TEXT.get(label)
        if not text:
            q = line if len(line) < 56 else line[:53] + "…"
            text = f"ответил «{answer}» — {q}"
        self.push(text, "auto")

    def handover(self, why, line):
        if self.raw:
            return super().handover(why, line)
        self.modal, self.input = (why, line), ""
        self.secret = bool(engine.RESPONDER and engine.RESPONDER.secret)
        self.bell()

    def handover_done(self):
        self.modal, self.input = None, ""

    def fallback(self, tb):
        self.go_raw("внутренняя ошибка интерфейса — дальше обычный вывод:\n" + tb)

    def go_raw(self, why):
        if self.raw:
            return
        self.raw = True
        self.s.leave()
        self.s.write("\x1b[2J\x1b[H")
        tail = self.raw_tail[-8000:]
        self.out(tail)
        super().message(f"\r\n[arch-update-ui] {why}\r\n", engine.C_YEL)

    def key(self, data):
        if self.raw:
            return data
        keys = parse_keys(data)
        if "ctrl]" in keys:
            self.go_raw("ручной режим: дальше полный вывод, отвечаешь сам.")
            return b"\x1d"
        if not self.modal and (self.game or self.hub):
            for k in keys:
                if k == "ctrl-c":
                    return b"\x03"
                self.game_key(k)
            return None
        if not self.modal:
            for k in ("left", "right"):
                if k in keys:
                    self.app.move_screen(k)
            if any(LATIN.get(k, k) in ("g", "G") for k in keys):
                self.hub, self.hub_sel = True, 0
                return None
        if self.modal:
            for k in keys:
                if k == "enter":
                    text, self.input = self.input, ""
                    return text.encode() + b"\r"
                if k == "bs":
                    self.input = self.input[:-1]
                elif k == "ctrl-c":
                    return b"\x03"
                elif k == "space":
                    self.input += " "
                elif len(k) == 1 and k.isprintable():
                    self.input += k
            return None
        if "ctrl-c" in keys:
            return b"\x03"
        return None

    # ── mini-games
    def game_key(self, k):
        k = LATIN.get(k, k)
        if self.hub:
            n = len(games.GAMES)
            if k in ("up", "k", "w"):
                self.hub_sel = (self.hub_sel - 1) % n
            elif k in ("down", "j", "s", "tab"):
                self.hub_sel = (self.hub_sel + 1) % n
            elif len(k) == 1 and k in "123456789"[:n]:
                self.hub_sel = int(k) - 1
                self.game_key("enter")
            elif k == "enter":
                self.game, self.hub = games.GAMES[self.hub_sel](), False
            elif k in ("esc", "q"):
                self.hub = False
            return
        if k == "esc":
            self.save_best()
            self.game.paused = True if hasattr(self.game, "paused") and not self.game.over else self.game.paused
            self.game, self.hub = None, False      # back to the dashboard (G starts a new game)
            return
        self.game.key(k)
        if self.game.over:
            self.save_best()

    def save_best(self):
        g = self.game
        if g and g.score > self.best.get(g.name, 0):
            self.best[g.name] = g.score
            save_ui_state(best=self.best)

    def play_after(self):
        """arch-update finished while a game is open: let the player finish, then show the summary."""
        self.update_done = True
        while (self.game or self.hub) and engine.TERM_OK:
            self.tick()
            if select.select([0], [], [], PACE.interval)[0]:
                try:
                    data = os.read(0, 1024)
                except OSError:
                    return
                if not data:
                    return
                for k in parse_keys(data):
                    self.game_key(k)
        self.save_best()

    def tick(self):
        if self.raw or not engine.TERM_OK:
            return
        now = time.time()
        if AUTOPLAY and not self.modal:          # demo showcase: play a little Tetris by itself
            if not self.game and now - self.t_start > 4:
                self.game = games.Tetris()
            elif self.game and now - getattr(self, "auto_k", 0) > 0.3:
                self.auto_k = now
                self.game.key(__import__("random").choice(["left", "right", "up", "down", "down"]))
        if self.game and not self.modal:
            self.game.step(now)
        if now - self.last_frame < PACE.interval:
            return
        self.last_frame = now
        t = time.perf_counter()
        self.app.check_resize()
        self.draw()
        self.s.flush()
        PACE.measure(time.perf_counter() - t)
        if AUTOPLAY and self.modal:
            self.modal_t = getattr(self, "modal_t", None) or now
            if now - self.modal_t > 3.0 and engine.RESPONDER:
                self.modal_t = None
                engine.RESPONDER.user_input(b"n\r")

    # drawing
    def draw(self, fade=1.0):
        c, t = self.s.canvas, time.time() - self.app.t0
        t = math.floor(t * 10) / 10     # colour flows at 10 fps: most rows stay identical between frames
        if self.game or self.hub:
            self.draw_games(c, t)
        else:
            self.draw_dashboard(c, t, fade)
        BACKDROP.draw(c, t, PAL_RUN, fade)      # after the content (only into empty cells), before the modal
        self.app.draw_toast()
        if self.modal:
            why, line = self.modal
            lines = textwrap.wrap(line, max(10, min(c.w - 14, 76)), break_on_hyphens=False) or [line]
            self.app.draw_modal("Нужен твой ответ", [why[:1].upper() + why[1:], ""] + lines,
                                "Enter — отправить    Ctrl+] — полный вывод", PAL_WARN,
                                input_text=("•" * len(self.input)) if getattr(self, "secret", False) else self.input)

    def status_strip(self, c, t, y):
        """One compact line with the update's state, shown above the games."""
        p = self.prog
        if self.update_done:
            text = "✓  обновление завершено   ·   Esc — к итогу"
            c.cput(y, text, GOOD, bold=True)
            return
        stage = {"start": "подготовка", "download": "загрузка", "install": "установка", "hooks": "хуки",
                 "aur": "сборка AUR", "cleanup": "завершение"}.get(p.stage, "обновление")
        frac = p.overall()
        eta = f"осталось ≈ {fmt_dur(max(1, self.eta_shown or p.eta()))}"
        bw = 24
        text_l = f"ARCH UPDATE  ·  {stage}  "
        text_r = f"  {int(frac * 100):3d}%  ·  {eta}"
        if len(text_l) + bw + len(text_r) > c.w - 2:       # narrow terminal: no title, shorter bar
            text_l = f"{stage}  "
            bw = max(6, c.w - 2 - len(text_l) - len(text_r))
        x = (c.w - len(text_l) - bw - len(text_r)) // 2
        for i, ch in enumerate(text_l):
            c.put(x + i, y, ch, grad(PAL_RUN, i / 40 - t * 0.15), bold=i < 11)
        x += len(text_l)
        bar(c, x, y, bw, frac, lambda i: grad(PAL_RUN, i / bw * 0.7 - t * 0.25))
        c.put(x + bw, y, text_r, TEXT)

    def draw_games(self, c, t):
        if self.hub:
            self.status_strip(c, t, 1 if c.h >= 26 else 0)      # a laptop screen: row 0, as in the games
            top = max(3, (c.h - 9) // 2)                        # the 9-row block, centred
            title = "МИНИ-ИГРЫ"
            c.cput(top, " ".join(title), grad(PAL_ARCH, -t * 0.12), bold=True)
            c.cput(top + 1, "обновление идёт дальше само — играй спокойно", DIM)
            mw = 44
            mx = (c.w - mw) // 2
            y = top + 4
            for i, G in enumerate(games.GAMES):
                sel = i == self.hub_sel
                best = self.best.get(G.name)
                if sel:
                    pill(c, mx, y, mw, lambda xx: shade(grad(PAL_ARCH, xx / mw * 0.6 - t * 0.1), 0.5),
                         grad(PAL_ARCH, -t * 0.1))
                c.put(mx + 2, y, ("▸ " if sel else "  ") + f"{i + 1}  {G.title}", (255, 255, 255) if sel else TEXT,
                      bold=sel)
                if best:
                    rec = f"рекорд {best}"
                    c.put(mx + mw - len(rec) - 2, y, rec, DIM if not sel else (220, 220, 235))
                y += 2
            self.app.hint("↑↓ выбор", "Enter играть", "Esc назад")
            return
        g = self.game
        g.scale = 1
        for sc in (3, 2):        # largest scale that fits the screen (big monitors get big cells)
            g.scale = sc
            w_, h_ = g.size()
            if w_ <= c.w - 6 and h_ <= min(c.h - 8, c.h * 3 // 4):
                break
            g.scale = 1
        gw, gh = g.size()
        x0 = (c.w - gw) // 2
        title = f"{g.title.upper()}   ·   очки {g.score}   ·   рекорд {max(g.score, self.best.get(g.name, 0))}"
        if c.h >= gh + 8:                  # roomy: strip, gap, title, board, gap, footer
            self.status_strip(c, t, 1)
            y0, foot = max(3, (c.h - gh) // 2), c.h - 2
            c.cput(y0 - 1, title, grad(PAL_ARCH, 0.2 - t * 0.1), bold=True)
        else:                              # low terminal (a laptop): title only if it fits, the rest centred
            self.status_strip(c, t, 0)
            foot = c.h - 1
            has_title = c.h >= gh + 3
            y0 = 1 + max(0, (c.h - 2 - gh - has_title) // 2)
            if has_title:
                c.cput(y0, title, grad(PAL_ARCH, 0.2 - t * 0.1), bold=True)
                y0 += 1
        c.blank(x0, y0, gw, gh, BG)        # the board counts as drawn: no star or aurora inside it
        g.draw(c, U, x0, y0, t)
        hint = g.hints + "   ·   Esc — выйти из игры"
        if len(hint) > c.w - 2:
            hint = g.hints + "  ·  Esc — выход"
        keyline(c, foot, hint)

    def draw_dashboard(self, c, t, fade=1.0):
        W = min(c.w - 8, 84)
        x0 = (c.w - W) // 2
        p = self.prog
        top = max(1, c.h // 2 - 13)
        gap = 1 if c.h < 30 else 2         # blank rows between blocks: one on a laptop, two on a desktop

        # header
        head = "A R C H   U P D A T E"
        hx = (c.w - len(head)) // 2
        for i, ch in enumerate(head):
            c.put(hx + i, top, ch, grad(PAL_RUN, i / len(head) * 0.7 - t * 0.15), bold=True, alpha=fade)
        sub = "демо-режим · ничего не меняется" if self.demo else "обновление системы"
        c.cput(top + 1, sub, DIM, alpha=fade)

        # stages
        stages = [("download", "Загрузка"), ("install", "Установка"), ("hooks", "Хуки")]
        if p.aur_pkgs:
            stages.append(("aur", "AUR"))
        stages.append(("cleanup", "Завершение"))
        order = engine.Progress.STAGES
        cur = order.index(p.stage) if p.stage in order else -1
        seg = W // len(stages)
        y = top + 2 + gap
        for i, (key, name) in enumerate(stages):
            idx = order.index(key)
            cx = x0 + i * seg + seg // 2
            if idx < cur:
                dot, col = "●", grad(PAL_RUN, i * 0.15)
            elif idx == cur:
                pulse = 0.55 + 0.45 * math.sin(t * 5)
                dot, col = "◉", lerp(DIM, grad(PAL_RUN, i * 0.15 - t * 0.2), pulse)
            else:
                dot, col = "○", MUTED
            if i < len(stages) - 1:
                lc = grad(PAL_RUN, i * 0.15) if idx < cur else FAINT
                c.put(cx + 2, y, ("━" if idx < cur else "─") * (seg - 3), lc, alpha=fade)     # done: heavier
            c.put(cx, y, dot, col, bold=True, alpha=fade)
            c.put(cx - len(name) // 2, y + 1, name, TEXT if idx == cur else (DIM if idx < cur else MUTED),
                  bold=idx == cur, alpha=fade)

        # stage line
        y += 2 + gap
        title = {"start": "Подготовка", "download": "Скачиваю пакеты", "install": "Устанавливаю пакеты",
                 "hooks": "Выполняю хуки", "aur": "Собираю пакеты из AUR", "cleanup": "Наводим порядок",
                 "end": "Готово"}.get(p.stage, "Обновление")
        if p.stage == "aur" and p.building:
            title = f"Собираю {p.building}"
        c.put(x0, y, title, TEXT, bold=True, alpha=fade)
        right = ""
        if p.stage == "install" and p.total:
            right = f"{p.done} / {p.total}"
        elif p.stage == "hooks" and p.hooks_total:
            right = f"{p.hooks_done} / {p.hooks_total}"
        elif p.stage == "download" and p.dl_seen:
            right = f"{int(p.dl_pct)}%"
        elif p.stage == "aur" and p.aur_pkgs:
            right = f"{p.aur_done} / {p.aur_count()}"
        c.put(x0 + W - len(right), y, right, DIM, alpha=fade)

        # progress bar (overall), sub-cell precision, flowing gradient
        y += 2
        frac = p.overall()
        bar(c, x0, y, W, frac, lambda i: grad(PAL_RUN, i / W * 0.8 - t * 0.25), alpha=fade)
        pct = f"{int(frac * 100)}%"
        c.put(x0 + W - len(pct), y + 1, pct, TEXT, bold=True, alpha=fade)

        # eta
        eta = p.eta()
        if self.eta_shown is None:
            self.eta_shown = eta
        else:
            self.eta_shown += (eta - self.eta_shown) * 0.08
        elapsed = time.time() - self.t_start
        el = f"прошло {int(elapsed // 60)}:{int(elapsed % 60):02d}"
        if p.stage in ("start",) and elapsed < 3:
            eta_txt = "оцениваю время…"
        else:
            eta_txt = f"осталось ≈ {fmt_dur(max(1, self.eta_shown))}"
        c.put(x0, y + 1, eta_txt, grad(PAL_RUN, 0.3 - t * 0.1), alpha=fade)
        c.put(x0 + len(eta_txt) + 3, y + 1, el, DIM, alpha=fade)

        # activity feed: newest at the bottom, older lines fade out
        y += 2 + gap
        rows = max(3, min(9, c.h - 5 - gap - y))      # the invitation keeps its blank row(s) above
        items = self.feed[-rows:]
        for i, (ts, text, kind) in enumerate(items):
            age_rank = len(items) - 1 - i
            k = 1.0 - age_rank / (rows + 1)
            k *= clamp01((time.time() - ts) / 0.25) * 0.85 + 0.15
            col = {"info": TEXT, "auto": hexrgb("#7cf5d6"), "warn": WARN, "err": BAD}[kind]
            icon = {"info": "›", "auto": "✓", "warn": "!", "err": "✗"}[kind]
            line = text if len(text) <= W - 4 else text[:W - 5] + "…"
            yy = y + (rows - len(items)) + i
            c.put(x0 + 1, yy, icon, col, alpha=fade * k)
            c.put(x0 + 3, yy, line, col if age_rank == 0 else lerp(DIM, col, k), alpha=fade * k)

        # invitation to play
        inv = "▶  G — мини-игры, пока идёт обновление"
        yy = y + rows + gap
        ix = (c.w - len(inv)) // 2
        pulse = 0.7 + 0.3 * math.sin(t * 2.2)
        for i, ch in enumerate(inv):
            c.put(ix + i, yy, ch, lerp(BG, grad(PAL_ARCH, i / len(inv) * 0.6 - t * 0.15), pulse), bold=True, alpha=fade)
        hint = "Ctrl+] — полный вывод и ручной режим" + ("   ·   ←→ монитор" if self.app.monitors > 1 else "")
        keyline(c, c.h - 2, hint, MUTED, DIM, alpha=fade)      # quieter than the invitation above


def transition(app, view):
    """The menu screen flows into the live view: a diagonal colour wave recolours the title
    into the run palette and dissolves everything else, then the dashboard fades in."""
    s, dur = app.s, 1.2
    t0 = time.time()
    while True:
        k = (time.time() - t0) / dur
        if k >= 1:
            break
        app.check_resize()
        app.draw_menu()
        c, t = s.canvas, app.now()
        front = ease(k) * (c.h + 24) - 12
        top = app.title_top()
        band = 6 if app.menu_layout().big_title else 1
        for y in range(c.h):
            for x in range(c.w):
                b = clamp01((front - y - (x / c.w) * 12) / 6)
                if b <= 0:
                    continue
                if c.bg[y][x]:
                    c.bg[y][x] = lerp(c.bg[y][x], BG, b)
                if c.fg[y][x] is None:
                    continue
                if top <= y < top + band and c.ch[y][x] != " ":
                    target = grad(PAL_RUN, x / c.w * 0.85 - t * 0.12)
                    if c.ch[y][x] in SHADOW_CHARS:
                        target = shade(target, 0.45)
                    c.fg[y][x] = lerp(c.fg[y][x], target, b)
                else:
                    c.fg[y][x] = lerp(c.fg[y][x], BG, b)
        for x in range(c.w):                       # glowing edge riding the wave
            yy = int(front - (x / c.w) * 12)
            if 0 <= yy < c.h and c.ch[yy][x] == " ":
                c.put(x, yy, "▁", grad(PAL_RUN, x / c.w - k), alpha=0.5 * (1 - k))
        s.flush()
        time.sleep(PACE.interval)
    t1 = time.time()
    while time.time() - t1 < 0.35:                 # big title dissolves
        a = 1 - ease((time.time() - t1) / 0.35)
        app.check_resize()
        if app.menu_layout().big_title:
            app.draw_title(app.title_top(), app.now(), pal=PAL_RUN, alpha=a)
        else:
            app.draw_small_title(app.title_top(), app.now(), pal=PAL_RUN, alpha=a)
        s.flush()
        time.sleep(PACE.interval)
    t1 = time.time()
    while time.time() - t1 < 0.5:                  # dashboard fades in
        app.check_resize()
        view.draw(fade=ease((time.time() - t1) / 0.5))
        s.flush()
        time.sleep(PACE.interval)


# ───────────────────────────── in the plain terminal: services restarted, problems fixed ─────────────────────────────

class QuietLog:
    """engine.LOG while a restart or a fix runs: its output stays out of the update's journal (what was typed
    there, a password typed ahead too, has no place in a report). What came of it is one event line instead."""
    broken, path = False, None

    def output(self, data):
        pass

    def event(self, kind, msg):
        pass

    def text(self, msg):
        pass


def note_ui_error(tb):
    try:
        os.makedirs(engine.STATE_DIR, exist_ok=True)
        with open(os.path.join(engine.STATE_DIR, "ui-error.log"), "a") as f:
            f.write(time.strftime("\n== %F %T ==\n") + tb)
    except OSError:
        pass


def say_plain(s, text, colour=None, bold=False):
    """A line of ours in the plain terminal, in the terminal's own text colour (a light theme stays readable) or
    an accent. The terminal is in raw mode: every newline goes out as \\r\\n."""
    pre = ("\x1b[1m" if bold else "") + ("\x1b[38;2;%d;%d;%dm" % colour if colour else "")
    s.write(pre + text.replace("\r\n", "\n").replace("\n", "\r\n") + "\x1b[0m\r\n")


def run_in_terminal(app, argv, intro):
    """argv in the plain terminal (the canvas left, as for «Обычный Arch-Update»), in a pty of its own and run as
    the engine runs a manual update: sudo asks for the password there, pacman asks before it changes anything, the
    output shows as it comes. Keys typed before it said anything never reach it (a password typed ahead), Ctrl+C
    never reaches pacman while it installs, and if the window closes meanwhile a question still waiting gets only
    the safe answer (no to pacman, a password prompt cancelled). intro: [(text, colour, bold)] said first.
    Returns (its exit status, None if it could not start; what went wrong in its output, as the engine's
    FAILURE_MARKERS found it: "errors were encountered during the build", "No space left on device" …). The caller
    says what came of it (back_to_canvas)."""
    s = app.s
    s.leave()
    s.write("\x1b[H\x1b[2J")
    for text, colour, bold in intro:
        say_plain(s, text, colour, bold)
    s.write("\r\n")
    view = engine.TerminalView()
    saved = engine.VIEW, engine.LOG
    engine.VIEW, engine.LOG = view, QuietLog()
    try:
        drop_typeahead()
        cols, rows = term_size()
        try:     # in English, as the update runs: the engine's safe answers know those questions
            child = pexpect.spawn(argv[0], argv[1:], env=engine.child_env(), dimensions=(rows, cols), echo=True)
        except (pexpect.ExceptionPexpect, OSError) as e:
            say_plain(s, f"не удалось запустить {argv[0]}: {e}", BAD)
            return None, set()
        app.child = child                       # window resizes reach it (main's SIGWINCH handler)
        responder = engine.Responder(child, stop_on_news=False, manual=True)
        try:
            pump_through(child, responder, view)
        finally:
            app.child = None
        child.wait()                            # its pty is at EOF: only reaped, never killed
        child.close()
        status = child.exitstatus if child.exitstatus is not None else 128 + (child.signalstatus or 0)
        return status, set(responder.failures)
    finally:
        engine.VIEW, engine.LOG = saved


def pump_through(child, responder, view):
    """engine.pump until the command is done. As in run_update, an error in it never leaves the command running
    unwatched (pacman may be at work): the plain pass-through goes on, and failing that the output alone."""
    for auto in (True, False):
        try:
            engine.pump(child, responder, auto=auto)
            return
        except Exception:
            note_ui_error(traceback.format_exc())
    while True:
        try:
            data = os.read(child.child_fd, 65536)
        except OSError:
            data = b""
        if not data:
            return
        view.out(data)


def back_to_canvas(app, lines):
    """What came of it under the output, which stays readable until Enter; then back to the canvas."""
    s = app.s
    for text, colour, bold in lines:
        say_plain(s, text, colour, bold)
    say_plain(s, "\nEnter — вернуться в Arch-Update", None, True)
    drop_typeahead()                            # an Enter typed while it ran is no answer to this
    while engine.TERM_OK:
        try:
            if not select.select([0], [], [], 0.5)[0]:
                continue
            data = os.read(0, 64)
        except (OSError, ValueError):
            data = b""
        if not data:
            engine.lost_terminal()
            break
        if any(k in ("enter", "esc") for k in parse_keys(data)):
            break
    s.enter()
    s.resize()
    drop_typeahead()


def merge(res, data):
    """The update's summary as the engine left it after a restart or a fix, into the result on the screen.
    False when there is none."""
    if not isinstance(data, dict) or not data:
        return False
    for k in ("problems", "warnings", "notes", "ok", "verdict", "services", "boot", "fixes", "resolved"):
        if k in data:
            res[k] = data[k]
    if "space" in data:                         # too little room: as the summary says it now (gone once freed)
        res["space"] = data["space"]
    else:
        res.pop("space", None)
    return True


def restart_services(app, res, argv):
    """R: the services the update left waiting (those safe to restart while the machine runs: argv is
    engine.services_command's) restarted now, in the plain terminal, where sudo may ask for the password. The
    update's summary follows (engine.services_restarted): the restarted ones become an ok line, one that failed
    a warning; when none was tried (the password refused, the question cancelled) they stay waiting.
    Returns what came of it: (text, colour)."""
    units = argv[argv.index("--") + 1:] if "--" in argv else []
    log = res.get("log")
    status, _ = run_in_terminal(app, argv, [
        (("[Arch-Update] Перезапускаю сервис: " if len(units) == 1 else "[Arch-Update] Перезапускаю сервисы: ")
         + engine.unit_list(units, 20), None, True),
        ("  " + shlex.join(argv), DIM, False)])
    failed, done = [], list(units)
    if status != 0:
        # One that failed is in the failed state now (it was running before: that is why it was waiting); then
        # the restart was tried, and the others went through. None failed: no telling whether any was tried.
        states = engine.run(["systemctl", "is-failed", "--", *units], timeout=10).split()
        failed = [u for u, st in zip(units, states) if st == "failed"] if len(states) == len(units) else []
        done = [u for u in units if u not in failed] if failed else []
    data = None
    if done:
        data = engine.services_restarted(log, done, ok=True)
    if failed:
        data = engine.services_restarted(log, failed, ok=False)
    if not merge(res, data) and (done or failed):          # no summary to follow: at least nothing waits twice
        svc = res.get("services") if isinstance(res.get("services"), dict) else {}
        svc["waiting"] = [u for u in svc.get("waiting") or [] if u not in done + failed]
    if failed:
        text, colour = engine.not_restarted_text(failed, "systemctl status " + " ".join(failed[:3])), WARN
    elif done:
        text, colour = engine.restarted_text(done), GOOD
    else:
        engine.journal_event(log, "СЕРВИСЫ", f"перезапуск по клавише R не прошёл (код {status}): " + ", ".join(units))
        text = ("сервис не перезапущен" if len(units) == 1 else "сервисы не перезапущены") + \
            (f" (код {status})" if status is not None else "")
        colour = WARN
    back_to_canvas(app, [("", None, False), (("✓ " if colour == GOOD else "✗ ") + text, colour, True)])
    return text, colour


FREE_HINT = "освободи место (например: sudo pacman -Sc) и нажми F ещё раз"
# The status line after F, by what came of the fixes (fixes.outcome): short, it has a row of its own.
FIX_SAYS = {"rolledback": "не помогло, всё вернул как было", "nothing": "ничего не менял",
            "error": "закончилось с ошибкой", "notenough": "место освободил, но его всё ещё мало",
            "rollbackfailed": "вернуть как было не удалось — копии в /tmp", "seen": "в выводе была ошибка",
            "stopped": "сделано не всё"}


def low_space():
    """What the fixes would run out of: "/" with less than 200 MiB free, /boot with less than 64 MiB (mkinitcpio and
    depmod write there). "" when there is room, or no telling."""
    for path, least in (("/", 200), ("/boot", 64)):
        free = engine.free_mib(path)
        if free is not None and free < least:
            return f"на диске {path} свободно всего {free} МБ"
    return ""


def fix_problems(app, res, plan):
    """F: the fixes the catalogue has for what the update left (engine.fix_commands, lib/fixes), in order, in the
    plain terminal, each one with its copies first, its check after and everything put back when it did not work;
    then a fresh look at the boot files (engine.recheck_boot, with what the probe right after the fixes saw as
    root). A fix that was not done (put back, or its output said an error) fixed nothing: what was found stays,
    whatever the look says now, and the menu goes on warning. Only when every fix was done and checked and nothing
    is wrong any more is the update marked fixed (engine.mark_resolved; a problem that is not about booting, a
    pacman lock left behind, keeps the warning). Whatever else came of it, a problem with booting still there is
    said first, in red, with НЕ перезагружайся. Returns what came of it: (text, colour); res follows the update's
    summary."""
    log = res.get("log")
    try:
        fd, out = tempfile.mkstemp(prefix="arch-update-probe-")     # 0600: this user's only
        os.close(fd)
    except OSError:
        out = None
    result = fixes.result_file()
    keys = [f.get("key") for f in plan]
    intro = [("[Arch-Update] Исправляю" + (", по порядку:" if len(plan) > 1 else ":"), None, True)]
    for i, fix in enumerate(plan, 1):
        intro += [(f"  {i}. {fix['label']}" if len(plan) > 1 else f"  {fix['label']}", None, False),
                  ("     " + (fix.get("how") or shlex.join(fix["argv"])), DIM, False)]
    if any(k != "space" for k in keys):
        intro.append(("Прежде чем менять файлы, сохраню их копии, потом проверю, что получилось; если не "
                      "получится — верну всё как было.", DIM, False))
    if "space" in keys:
        intro.append(("Место: удаляю только кэш pacman (установленные версии остаются) и старый журнал; снимки "
                      "snapper — только если ответишь «да».", DIM, False))
    asks = "sudo спросит пароль, если нужно" + ("; pacman спросит, прежде чем что-то менять"
                                                if "kernel" in keys else "")
    intro.append((asks + ".", DIM, False))
    space = low_space() or ("на диске кончалось место" if engine.DISK_FULL in strs(res.get("problems")) else "")
    if space and "space" not in keys:
        intro.append((f"{space[:1].upper()}{space[1:]}: сначала освободи место (например: sudo pacman -Sc), "
                      "иначе исправление не пройдёт.", WARN, True))
    status, seen = run_in_terminal(app, engine.fixes_command(plan, out or os.devnull, result), intro)
    results = fixes.read_results(result) if result else None       # no file for them: the exit status tells
    kind, how = fixes.outcome(status, results, plan)
    states = dict(results or [])
    failed = kind != "ok" or bool(seen)
    if kind == "ok" and seen:                   # done and checked, but something in its output said an error
        how = "в выводе " + ", ".join(f"«{m}»" for m in sorted(seen)[:2])
    short = FIX_SAYS.get(kind if kind != "ok" else "seen", how)
    engine.journal_event(log, "ИСПРАВЛЕНИЕ", "по клавише F: " + fixes.journal_text(status, results or [], plan)
                         + "".join(f", в выводе «{m}»" for m in sorted(seen)[:2]))
    if states.get("space") == "ok" or (results is None and kind == "ok" and "space" in keys):
        engine.space_freed(log)
    say_plain(app.s, "\nПроверяю файлы загрузки ещё раз…", DIM)
    old = {i.get("text") for i in res.get("boot") or [] if isinstance(i, dict)}
    try:
        left = engine.recheck_boot(log, probe=out, failed=failed)
    except Exception:
        note_ui_error(traceback.format_exc())
        left = None
    finally:
        if out:
            try:
                os.remove(out)
            except OSError:
                pass
    data = engine.read_json(engine.summary_path(log)) if log else {}
    if not merge(res, data) and left is not None:           # no summary to follow: as the look found them now
        res["problems"] = [p for p in strs(res.get("problems")) if p not in old] + left
        res["boot"] = res.get("boot") if left else []
        res["verdict"] = 2 if res["problems"] else (1 if res.get("warnings") else 0)
    rest = [p for p in strs(res.get("problems")) if p not in (left or [])]     # what is not about booting
    if not failed and left == [] and not rest and log:
        res["resolved"] = engine.mark_resolved(log) or res.get("resolved")
    disk = "No space left on device" in seen
    only_space = set(keys) == {"space"}
    room = "partial" in states.values()         # room for the fixes, not yet for the update
    if left is None:
        text = "не удалось проверить — НЕ перезагружайся, сначала: sudo ls -l /boot"
        lines = [("✗ " + text, BAD, True)]
        colour = BAD
    elif kind == "rollbackfailed":
        text, colour = f"НЕ перезагружайся: {short}", BAD
        lines = [("✗ Исправление не помогло, и вернуть всё как было не удалось — копии остались в /tmp "
                  "(путь выше). НЕ перезагружайся.", BAD, True),
                 ("Отчёт об этом уйдёт разработчику сам." if log and report.follow_up_due(log) else
                  "Отправь отчёт (S): по нему будет видно, что случилось.", WARN, False)]
    elif left:                                  # a problem with booting is still there: that first, in red
        more = f" (и ещё {len(left) - 1})" if len(left) > 1 else ""
        text, colour = f"НЕ перезагружайся: всё ещё {short_problem(left[0])}{more}", BAD
        lines = [("✗ Всё ещё: " + short_problem(p), BAD, False) for p in left] + \
            [("НЕ перезагружайся, пока это не исправлено.", BAD, True)]
        if failed:
            lines.insert(0, ("✗ Исправление не прошло: " + how + ".", BAD, True))
        if kind == "rolledback":
            lines.insert(1, ("Всё, что оно меняло, вернул как было (сверил с копиями).", None, False))
        if kind == "notenough":
            lines.append(("Места не хватило даже для исправлений — что ещё занимает место, написано выше.",
                          WARN, False))
        if disk:
            lines.append(("На диске нет места: " + FREE_HINT + ".", WARN, True))
    elif kind == "notenough":
        text, colour = short, WARN
        lines = [("! Место освободил, но его всё ещё мало — что ещё занимает место, написано выше.", WARN, True)]
    elif failed and only_space:
        text, colour = f"место освободить не вышло: {how}", WARN
        lines = [("! Место освободить не вышло: " + how + ".", WARN, True)]
    elif failed:
        text, colour = f"НЕ перезагружайся: исправление не прошло — {short}", BAD
        lines = [("✗ Исправление не прошло: " + how + ". НЕ перезагружайся.", BAD, True)]
        if kind == "rolledback":
            lines.append(("Всё, что оно меняло, вернул как было (сверил с копиями).", None, False))
    elif only_space:
        text, colour = "место освобождено — запусти обновление ещё раз", GOOD
        lines = [("✓ Место освобождено. Запусти обновление ещё раз.", GOOD, True)]
    elif rest:
        text, colour = f"с загрузкой всё в порядке; осталось: {short_problem(rest[0])}", WARN
        lines = [("✓ С загрузкой всё в порядке.", GOOD, True),
                 ("Осталось: " + short_problem(rest[0]) + " — запусти обновление ещё раз: если оно пройдёт чисто, "
                  "предупреждение уйдёт.", WARN, False)]
    else:
        text = "исправлено: проблем с загрузкой больше не нашёл"
        lines, colour = [("✓ Проблем с загрузкой больше не нашёл.", GOOD, True)], GOOD
    if room and left == []:
        lines.append(("Для обновления места ещё мало — освободи его, прежде чем обновляться (F в итоге "
                      "обновления сделает это снова).", WARN, False))
        if colour == GOOD:
            text, colour = text + "; для обновления места ещё мало", WARN
    back_to_canvas(app, lines)
    return text, colour


def report_ui(app):
    """The screen and the monitors, for a report of this machine (counted only for Konsole on KDE: elsewhere
    unknown, not 0)."""
    w, h = term_size()
    return {"screen": f"{w}x{h}", "monitors": app.monitors or None}


class Actions:
    """What can be done about one finished update, on its summary and from the menu's warning about it: S sends its
    report by hand when it was not queued by itself; R restarts the services it left waiting, those safe to restart
    while the machine runs (engine.services_command); F runs the fixes the engine knows for the problems with
    booting it found (engine.fix_commands). Each one only where it applies, and in the demo each only says that it
    is not done there. A key held down or pressed twice counts once."""

    def __init__(self, app, res, sent=None, demo=False, sent_before=None):
        """sent_before: report.report_state of the update (the menu's warning): a report of it went out already."""
        self.app, self.res, self.sent, self.demo = app, res if isinstance(res, dict) else None, sent, demo
        self.sent_before = sent_before if isinstance(sent_before, dict) else {}
        self.job, self.status, self.pressed = None, None, {}
        self.again = False                      # F added to the journal since S: S once more, with that
        self.look()

    def look(self):
        """What applies now: again after a restart or a fix."""
        res = self.res or {}
        log = res.get("log")
        self.log = log if isinstance(log, str) and log else None
        svc = res.get("services") if isinstance(res.get("services"), dict) else {}
        waiting = [u for u in svc.get("waiting") or [] if isinstance(u, str)]
        self.restart = engine.services_command(waiting) if waiting else []
        self.units = self.restart[self.restart.index("--") + 1:] if "--" in self.restart else []
        self.fixes = engine.fix_commands(res) if res else []

    def can_send(self):
        if not self.log or (self.job and (not self.job.done or (self.job.ok and not self.again))):
            return False                        # on its way, or gone (and nothing new since)
        sent = self.sent                        # this update's report queued by itself, as the reports are on
        return sent is None or not (sent.thread.is_alive() or sent.path)

    def keys(self):
        """The hints of what applies, as (long, short) pairs."""
        out = []
        if self.can_send():
            out.append(("S — отправить отчёт ещё раз", "S — ещё раз") if self.sent_before.get("sent") else
                       ("S — отправить отчёт", "S — отчёт"))
        if self.units:
            out.append(("R — перезапустить сервис" + ("" if len(self.units) == 1 else "ы"), "R — сервисы"))
        if self.fixes:
            more = f" и ещё {len(self.fixes) - 1}" if len(self.fixes) > 1 else ""
            out.append((f"F — {self.fixes[0]['label']}{more}", "F — исправить"))
        return out

    def press(self, key):
        """A key: True when it went to the plain terminal and back (R, F)."""
        key = key.lower() if len(key) == 1 else key
        applies = {"s": self.can_send, "r": lambda: bool(self.units), "f": lambda: bool(self.fixes)}.get(key)
        if not applies or not applies():
            return False
        now, last = time.time(), self.pressed.get(key, 0.0)
        self.pressed[key] = now
        if now - last <= FRESH:                 # held down, or pressed twice: once is enough
            return False
        if self.demo:
            self.app.toast(DEMO_SAYS)
            return False
        if key == "s":
            self.again = False
            self.job = self.status = SendJob(self.log, report_ui(self.app), app=self.app)
            return False
        if engine.pacman_busy():                # another update's pacman at work: mkinitcpio twice, or a restart
            self.app.toast(PACMAN_BUSY, secs=4)  # in the middle of its transaction
            return False
        try:
            self.status = Status(*(restart_services(self.app, self.res, self.restart) if key == "r" else
                                   fix_problems(self.app, self.res, self.fixes)))
        finally:
            self.look()
            if key == "f":
                self.after_fix()
        return True

    def after_fix(self):
        """What F did is news for this update's report: with the reports on it goes again by itself, as a report of
        its own (report.after_fix; the summary's report line follows it); else S is offered again, also when a
        report went by hand before (it had none of this)."""
        if self.log and report.follow_up_due(self.log):
            log, ui = self.log, report_ui(self.app)
            self.sent = self.app.report_line = ReportLine(lambda: report.after_fix(log, ui=ui))
        else:
            # S again, once a report still on its way has its answer (send_now sends one at a time: the next one
            # knows what that one had, and is news); no report goes by itself for this update now
            self.again, self.sent = True, None

    def view(self, elapsed, review=None, status=None):
        return summary_view(self.res, elapsed, self.sent, self.keys(), status or self.status, review)


# ───────────────────────────── summary ─────────────────────────────

class ReportLine:
    """This update's report and the summary's quiet line about it. The report is put together in a
    thread of its own (the device, pacman and the whole log take a moment on a slow machine, and the
    screen must not stall on it), then queued and sent by a process of its own. Where it is now is
    looked up at most once a second."""
    SENDING = 10                    # seconds of "отправляется…" before it counts as waiting
    FINISH = 8                      # seconds the program waits at its end for a report still being put together

    def __init__(self, build):
        """build() queues the report and returns its file, or None if it made none; it never raises
        (report.after_update)."""
        self.path, self.t0, self.state, self.polled = None, time.time(), "waiting", 0.0
        self.endpoint = bool(report.endpoint())
        self.thread = threading.Thread(target=self._build, args=(build,), daemon=True)
        self.thread.start()

    def _build(self, build):
        path = build()
        self.t0, self.path = time.time(), path      # "отправляется…" counts from the moment it was queued

    def finish(self, timeout=FINISH):
        """At the program's end: a report started just before the window closed still gets queued."""
        self.thread.join(timeout)

    def text(self, short=False):
        """The line; short: the few words that fit after the journal line's path."""
        if self.thread.is_alive():
            return "отчёт: собираю…"
        if not self.path:
            return ""                                # none was made after all
        now = time.time()
        if now - self.polled >= 1:
            self.polled = now
            # looked up twice when not found: the sender may move it between two folders just then
            self.state = report.state_of(self.path) or report.state_of(self.path)
        if self.state == "sent":
            return "отчёт отправлен" if short else "отчёт отправлен разработчику"
        if self.state == "rejected":
            return "отчёт не принят сервером"
        if self.state == "waiting":
            if not self.endpoint:            # nothing sends it before a server is set
                return "отчёт сохранён" if short else "отчёт сохранён — уйдёт, когда подключат сервер для отчётов"
            if now - self.t0 < self.SENDING:
                return "отчёт: отправляется…"
            return "отчёт ждёт отправки" if short else "отчёт ждёт отправки — уйдёт при следующем запуске"
        return ""


def queue_report(app, res, mode, elapsed):
    """This update's report, if the user said yes (never for the demo): put together and queued
    in a thread, sent by a process of its own. Returns its ReportLine (also kept as app.report_line,
    for the wait at the end), or None when there is none to make."""
    if DEMO or not res or not report.enabled():
        return None
    ui = report_ui(app)
    app.report_line = ReportLine(lambda: report.after_update(res, demo=DEMO, mode=mode, seconds=elapsed, ui=ui))
    return app.report_line


def strs(value):
    return [x for x in value if isinstance(x, str)] if isinstance(value, list) else []


def fit(text, width):
    return text if len(text) <= width else text[:max(0, width - 1)] + "…"


def list_fit(wraps, rows):
    """How a list of wrapped items fits into rows: (lines each item gets, how many items show). Every item gets
    as many lines as all of them can have alike (3, 2 or 1; one cut short ends in "…"); when not even one line
    each fits, the first ones show and the last row says how many more there are."""
    for per in (3, 2, 1):
        if sum(min(per, len(w)) for w in wraps) <= rows:
            return per, len(wraps)
    return 1, max(0, rows - 1)


def cut_lines(wrapped, per, width):
    """The first per lines of a wrapped item; the last of them ends in "…" when the item goes on."""
    part = list(wrapped[:per])
    if len(wrapped) > per:
        last = part[-1]
        part[-1] = (last if len(last) < width else last[:max(0, width - 1)].rstrip()) + "…"
    return part


def summary_view(res, elapsed, sent=None, keys=(), status=None, review=None):
    """What the summary screen shows for a finished run (res is None when nothing ran; a summary read back
    serves as well); sent: the ReportLine of its report, if one was made; keys: what can be done about it, as
    (long, short) hints; status: what came of the last of those (its line()); review: when the update began, for
    an earlier one opened from the menu. Notes are grey and come last: they never change the verdict."""
    res = res if isinstance(res, dict) else None
    verdict = res.get("verdict") if res else 0
    verdict = verdict if verdict in (0, 1, 2) and type(verdict) is int else 1
    n = len(strs((res or {}).get("changed"))) + len(strs((res or {}).get("added")))
    lines = []
    if res:
        lines += [("✗", p, BAD) for p in strs(res.get("problems"))]
        lines += [("⚠", w, WARN) for w in strs(res.get("warnings"))]
        lines += [("✓", o, GOOD) for o in strs(res.get("ok"))]
        lines += [("›", x, MUTED) for x in strs(res.get("notes"))]
    packages = f"{n} {plural(n, 'пакет', 'пакета', 'пакетов')}"
    took = f" за {fmt_dur(elapsed)}" if elapsed else ""
    if not res:
        stats = ""
    elif review is not None:
        stats = (f"обновление {review} · " if review else "") + packages + took
    else:
        stats = packages + f" за {fmt_dur(elapsed or 0)}"
    log = res.get("log") if res else None
    return types.SimpleNamespace(
        verdict=verdict, pal=[PAL_OK, PAL_WARN, PAL_BAD][verdict], glyph=[CHECK, BANG, CROSS][verdict],
        head=(res or {}).get("head") or
        ["Обновление завершено", "Готово — есть что прочитать", "Нужна проверка — не перезагружайся"][verdict],
        stats=stats, lines=lines, log=log if isinstance(log, str) else None, sent=sent, keys=list(keys),
        status=status, review=review)


def draw_summary(app, sv, t, demo, left):
    """One frame of the summary; left = seconds until it closes by itself, None if it stays open."""
    c = app.s.canvas
    W = min(c.w - 8, 84)
    gap = 7 if c.h < 30 else 8                                   # glyph top -> headline
    tw = max(10, W - 4)
    wraps = [textwrap.wrap(tx, tw, break_on_hyphens=False) or [""] for _, tx, _ in sv.lines]
    head = gap + 3                                               # glyph, headline, stats, blank
    keys = fit_keys(sv.keys, c.w - 4)
    shift = 1 if keys else 0                                     # the keys' row above the closing one
    status = sv.status.line() if sv.status else None
    # The note below the journal line (where this update's report is, or what came of a key pressed) gets a row
    # of its own only while every row of the list still fits with it: no problem or warning ever makes room for
    # it. Else the report's goes onto the journal line, in short, if there is room there, or is left out; what
    # came of a key takes the journal line's place.
    rows = c.h - 6 - shift - head                                # the list's rows when the note has no row of its own
    own_row = (sv.sent is not None or status is not None) and \
        head + sum(min(2, len(w)) for w in wraps) <= c.h - 7 - shift and \
        list_fit(wraps, rows - 1) == list_fit(wraps, rows)       # and no item gives up a line for it
    foot = (c.h - 5 if own_row else c.h - 4) - shift             # the journal line
    # The list ends a row above the journal line. Every item shows, cut alike when it must be (with "…"); only
    # when not even a line each fits, the last row says how many more the journal has: nothing goes unsaid.
    per, shown = list_fit(wraps, foot - 2 - head)
    hidden = len(wraps) - shown
    need = head + sum(min(per, len(w)) for w in wraps[:shown]) + (1 if hidden else 0)
    top = max(1, (foot - need) // 2)                             # centred above the journal line
    gw = len(sv.glyph[0])
    gx = (c.w - gw) // 2
    for ry, row in enumerate(sv.glyph):
        a = clamp01((t - ry * 0.06) / 0.3)
        for i, ch in enumerate(row):
            if ch != " ":
                col = grad(sv.pal, i / gw * 0.7 + ry * 0.04 - t * 0.12)
                if ch in SHADOW_CHARS:
                    col = shade(col, 0.45)
                c.put(gx + i, top + ry, ch, col, bold=True, alpha=a)
    y = top + gap
    c.cput(y, sv.head, grad(sv.pal, 0.2 - t * 0.1), bold=True, alpha=clamp01((t - 0.4) / 0.4))
    if demo:
        c.cput(y + 1, "демо-режим: это была имитация, система не менялась", DIM, alpha=clamp01((t - 0.5) / 0.4))
    elif sv.stats:
        c.cput(y + 1, sv.stats, DIM, alpha=clamp01((t - 0.5) / 0.4))
    y += 3
    longest = max([min(len(tx), tw) for _, tx, _ in sv.lines] or [0]) + 4
    x0 = (c.w - longest) // 2
    for i, (icon, _, col) in enumerate(sv.lines[:shown]):
        a = clamp01((t - 0.7 - i * 0.08) / 0.35)
        c.put(x0 + 2, y, icon, col, bold=True, alpha=a)
        tcol = DIM if icon in ("✓", "›") else TEXT       # one colour per item, all its lines
        for line in cut_lines(wraps[i], per, tw):
            c.put(x0 + 4, y, line, tcol, alpha=a)
            y += 1
    if hidden:                                  # the journal has the problems, warnings and notes; not the ✓ checks
        where = "" if any(icon == "✓" for icon, _, _ in sv.lines[shown:]) else " — в журнале"
        c.put(x0 + 4, y, f"… и ещё {hidden}{where}", MUTED, alpha=clamp01((t - 0.7 - shown * 0.08) / 0.35))
    journal = "журнал: " + sv.log.replace(os.path.expanduser("~"), "~") if sv.log else ""
    jcol, note, ncol = MUTED, "", MUTED
    if status:
        note, ncol = status
        also = sv.sent.text(short=True) if sv.sent else ""        # its report after F, on its way
        if also and len(f"{note} · {also}") <= c.w - 4:
            note = f"{note} · {also}"
    elif sv.sent:
        note = sv.sent.text(short=not own_row)
    if note and not own_row:
        if status:
            journal, jcol, note = note, ncol, ""
        else:
            both = f"{journal} · {note}" if journal else note
            journal, note = (both if len(both) <= c.w - 4 else journal), ""
    if journal:
        c.cput(foot, fit(journal, c.w - 4), jcol)
    if note:
        c.cput(foot + 1, fit(note, c.w - 4), ncol)
    if keys:
        keyline(c, c.h - 3, keys)
    mon = "   ·   ←→ монитор" if app.monitors > 1 else ""
    if left is not None:
        keyline(c, c.h - 2, f"закроется через {int(math.ceil(left))} с   ·   Enter — закрыть{mon}   ·   "
                            "любая клавиша — оставить")
    elif sv.review is not None:
        keyline(c, c.h - 2, "Enter — назад в меню" + mon)
    else:
        keyline(c, c.h - 2, "Enter — закрыть" + mon)


def summary_screen(app, res, elapsed, demo=False, sent=None, review=None, acts=None):
    """The summary of a run until Enter, with its keys (Actions): S sends its report by hand, R restarts the
    services it left waiting, F fixes what it found wrong with booting. review: when an earlier update began,
    for one opened from the menu (Enter or Esc goes back there; it never closes by itself); acts: the menu's
    Actions for that update."""
    s = app.s
    acts = acts or Actions(app, res, sent, demo)
    countdown = review is None and acts.view(elapsed).verdict == 0 and not (res or {}).get("exitstatus")
    drop_typeahead()                           # an Enter typed during the run/checks must not close it
    t0, keep, deadline = time.time(), not countdown, time.time() + 10
    calm = t0 + 1.0                            # keys count from then on: late typeahead, the verdict read first
    # Enter while this update's report sent by hand is on its way: the answer first (the user asked for the report
    # and for a word on how it went), then a moment to read it. leaving: since when it waits; answered: since when
    # the answer shows.
    leaving = answered = None
    waiting = Status(WAITING + " (Enter ещё раз — не ждать)", DIM)
    while True:
        app.check_resize()
        left = None
        if not keep:
            left = max(0, deadline - time.time())
            if left <= 0:
                return
        job = acts.job
        if job and job.done and acts.status is job:
            job.told = True                    # its own line said it: the menu tells it no more
        if leaving:
            if job is None or job.done:
                if job is not None:
                    acts.status = job
                answered = answered or time.time()
                if time.time() - answered > 1.5:
                    return
            elif time.time() - leaving > SendJob.WAIT:
                return
        draw_summary(app, acts.view(elapsed, review, waiting if leaving and not answered else None),
                     time.time() - t0, demo, left)
        app.draw_toast()
        s.flush()
        if select.select([0], [], [], PACE.interval)[0]:
            try:
                data = os.read(0, 64)
            except OSError:
                return
            if not data:
                return
            if time.time() < calm:
                continue
            keys = [LATIN.get(k, k) for k in parse_keys(data)]
            if "enter" in keys or (review is not None and ("esc" in keys or "q" in keys)):
                if leaving or not (job and not job.done):
                    return
                leaving = time.time()
                continue
            if leaving:
                continue                       # on the way out: nothing else starts now
            moves = [k for k in keys if k in ("left", "right")] if app.monitors > 1 else []
            for k in moves:
                app.move_screen(k)
            if not keep and len(moves) < len(keys):
                keep = True                    # «любая клавиша — оставить»: the countdown stops, that is all it does
                continue
            for k in keys:
                if acts.press(k):              # it went to the plain terminal and back: what was typed meanwhile
                    calm = time.time() + 1.0   # is no answer here
                    break
            if not engine.TERM_OK:
                return


# ───────────────────────────── self-test ─────────────────────────────

def self_test():
    """Draw every screen off-screen at laptop and desktop sizes: no terminal, no network, no change
    to the system. install.sh --check runs it before a machine accepts a self-update, so a version
    that cannot draw itself never goes live."""
    global save_ui_state
    save_ui_state = lambda **kw: None          # noqa: E731 — the user's ui.json is never touched
    for name in ("set_consent", "set_option", "after_update", "after_fix", "follow_up_due", "queue", "start_sender",
                 "send_pending", "send_now", "delete_local", "ensure_id", "report_state"):
        setattr(report, name, lambda *a, **kw: None)     # nor the reports' settings.json, outbox and journals
    for name in ("mark_resolved", "recheck_boot", "services_restarted", "save_summary", "journal_event", "space_freed"):
        setattr(engine, name, lambda *a, **kw: None)     # nor an update's summary or journal
    # What R and F would run, made up here: the self-test asks no display manager, looks at no kernel or preset
    # of this machine's and runs nothing.
    engine.services_command = lambda names: ["sudo", "systemctl", "restart", "--", *names] if names else []
    engine.fix_commands = lambda res: [fixes.fix("initramfs", "собрать initramfs заново (mkinitcpio)",
                                                 ["sudo", "mkinitcpio", "-P"], ["p:linux"])] \
        if isinstance(res, dict) and res.get("boot") else []
    Screen.write = lambda self, s: None
    app = App(live=False)
    app.repo = [("linux", "6.18.1-1", "6.18.2-1"), ("mesa", "1:26.2.5-1", "1:26.2.6-1")] + \
        [(f"package-with-a-long-name-{i}", "1.0.0-1", "1.0.1-1") for i in range(30)]
    app.aur = [("brave-bin", "1:1.97.59-1", "1:1.97.60-1")]
    app._risky = lambda n: n == "linux"        # the kernel/NVIDIA warning, whatever this machine has
    app.version = ("abc1234", "30.10.2026", "a new version with a long description of what changed")
    app.low_battery = 17
    app.toast("апдейтер обновился: " + app.version[2], secs=5)
    app.news = [{"date": f"2026-10-1{i}", "url": "", "new": i == 0, "info": "автор · дата",
                 "title": f"Новость {i}: длинный заголовок, который не помещается в узкое окно терминала",
                 "body": "Первый абзац.\n\n" + "слово " * 400} for i in range(6)]
    res = {"verdict": 2, "changed": ["a"] * 40, "added": ["b"], "removed": [], "exitstatus": 1,
           "problems": ["очень длинное описание проблемы " * 6], "warnings": ["предупреждение"],
           "ok": ["/boot в порядке"], "log": os.path.join(engine.STATE_DIR, "logs", "x.log")}
    full = dict(res, problems=[f"проблема {i}: " + "длинное описание " * 6 for i in range(4)],     # more rows
                warnings=[f"предупреждение {i}" for i in range(6)], ok=[f"проверка {i} прошла" for i in range(8)])
    # An update that left services waiting and a broken initramfs (all three keys), with notes; the same one
    # read back as the menu's warning about it.
    boot = [{"kind": "image", "pkg": "linux", "path": "/boot/initramfs-linux.img", "how": "missing",
             "text": "нет /boot/initramfs-linux.img — НЕ перезагружайся, система не загрузится"}]
    keyed = dict(res, problems=[boot[0]["text"]], boot=boot, warnings=["сервисы ждут перезапуска: cups, sshd"],
                 notes=["обновилось ядро — перезагрузись, когда будет удобно (обновились: linux)",
                        ".pacnew от прошлых обновлений: 2 — посмотреть: pacdiff -o"],
                 services={"waiting": ["cups.service", "sshd.service"]}, began="2026-11-02T12:50:12",
                 ended="2026-11-02T12:57:55")
    keyed_full = dict(full, boot=boot, services={"waiting": ["cups.service"]}, notes=["заметка " * 12] * 3)
    banners = [dict(keyed, problems=["в выводе: «error: command failed to execute correctly»"] + keyed["problems"]),
               dict(keyed, problems=["не исправлено после обновления в 12:34: " + "очень длинное описание " * 8]),
               dict(keyed, boot=[], problems=["arch-update завершился с кодом 1"], log=None)]
    statuses = [None, Status(SENDING, DIM), Status(WAITING + " (Enter ещё раз — не ждать)", DIM),
                Status("отчёт отправлен разработчику (№ 12)", GOOD),
                Status("НЕ перезагружайся: исправление не прошло — " + FIX_SAYS["rolledback"], BAD),
                Status("с загрузкой всё в порядке; осталось: остался замок pacman /var/lib/pacman/db.lck — pacman "
                       "мог прерваться", WARN),
                Status("сервер просит подождать — попробуй позже: до 6 отчётов в час с компьютера", WARN),
                Status("не перезапустились сервисы: cups — посмотри: systemctl status cups.service " * 2, WARN),
                Status("НЕ перезагружайся: всё ещё нет /boot/initramfs-linux.img", BAD)]
    updates = [{"log": "/x/2026-11-03_12-50-12.log", "time": "2026-11-03T12:50:12", "verdict": 2, "started": True,
                "packages": 27, "problems": [boot[0]["text"]], "warnings": [], "notes": [], "sent": "",
                "issue": None, "waiting": False},
               {"log": "/x/2026-11-02_12-59-25.log", "time": "2026-11-02T12:59:25", "verdict": 1, "started": True,
                "packages": 1, "problems": [], "warnings": ["предупреждение " * 12], "notes": [],
                "sent": "2026-11-02T13:00:00", "issue": 12345, "waiting": False},
               {"log": "/x/2026-10-31_17-42-38.log", "time": "2026-10-31T17:42:38", "verdict": 0, "started": True,
                "packages": 3, "problems": [], "warnings": [], "notes": ["заметка"], "sent": "", "issue": None,
                "waiting": True},
               {"log": "/x/2026-10-30_10-00-00.log", "time": "2026-10-30T10:00:00", "verdict": None,
                "started": True, "packages": 0, "problems": [], "warnings": [], "notes": [], "sent": "",
                "issue": None, "waiting": False},
               {"log": "/x/2026-10-29_10-00-00.log", "time": "2026-10-29T10:00:00", "verdict": 2, "started": False,
                "packages": 0, "problems": ["/boot не смонтирован"], "warnings": [], "notes": [],
                "sent": "2026-10-29T10:01:00", "issue": None, "waiting": False, "resolved": True}]
    # The settings with what report.status() and report.preview() can give, made up here: the
    # self-test reads and writes none of the real ones.
    states = [dict(REPORTS_UNDECIDED), dict(REPORTS_UNDECIDED, decided=True),
              dict(REPORTS_UNDECIDED, decided=True, id="1a2b3c4d"),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="1a2b3c4d", waiting=2),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="f" * 90, endpoint=True, waiting=12,
                   last_sent="2026-10-30T17:45:45", last_error="URLError: " + "name resolution failed " * 6),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="1a2b3c4d", endpoint=True, waiting=1,
                   last_error="HTTP 503"),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="1a2b3c4d", endpoint=True,
                   last_sent="2026-10-30T17:45:45", last_error="HTTP 400: отчёт не принят"),
              dict(REPORTS_UNDECIDED, enabled=True, decided=True, id="1a2b3c4d", endpoint=True,
                   last_sent="2026-10-30T17:45:45", last_error="HTTP 500: отчёт не принят после 3 попыток")]
    sent = ReportLine(lambda: os.path.join(report.OUTBOX, "x.json"))     # queued at once
    gate = threading.Event()
    building = ReportLine(lambda: gate.wait(60) and None)               # still being put together
    sent.finish()
    preview = json.dumps({"schema": 1, "id": "1a2b3c4d", "time": "2026-10-31T08:00:00Z",
                          "updater": {"commit": "abc1234", "date": "31.10.2026"},
                          "device": {"model": "очень длинное название модели " * 6, "odd": "\x1b[2J\x9b2J",
                                     "gpu": [{"id": "8086:3185", "name": "Intel UHD Graphics 600", "driver": "i915"}],
                                     "network": {"type": "Wi-Fi", "driver": "iwlwifi", "signal_dbm": -61}},
                          "update": {"mode": "auto", "verdict": 1, "changed": [f"pkg-{i}" for i in range(40)]},
                          "log": "[17:42:38 СТАРТ] arch-update\n" + ("строка\tжурнала\x07 " * 12 + "\n") * 300
                                 + "x" * 500 + "\n"}, ensure_ascii=False, indent=1)
    for w, h in ((80, 24), (100, 30), (136, 38), (320, 80)):
        c = app.s.canvas = Canvas(w, h)

        def shot(draw):
            draw()
            c.rows()
            c.clear()

        def bottom(draw, above=h - 2):
            """The lowest row above the footer (or the given row) a screen's own content reaches: the stars and
            the toast left out."""
            BACKDROP.draw, toast, app.toast_text = (lambda *a, **kw: None), app.toast_text, ""
            try:
                draw()
                return max((y for y in range(above) if "".join(c.ch[y]).strip()), default=0)
            finally:
                del BACKDROP.draw
                app.toast_text = toast
                c.clear()
        app.state, app.confirm = "splash", None
        for age in (0.0, 1.3, 3.0, 20.0):
            app.t0 = time.time() - age
            shot(app.draw_splash)
        app.state, app.menu_t, app.from_splash = "menu", time.time() - 5, True
        for bad in [None] + banners:            # with the warning about the last update, in one row or two
            for before in ({}, {"sent": "2026-11-02T13:00:00", "issue": 12}):     # its report sent already, or not
                app.bad = Actions(app, bad, sent_before=before) if bad else None
                for count in (True, False):     # updates to offer, or none (and no news: offline)
                    saved = app.repo, app.aur, app.news
                    if not count:
                        app.repo, app.aur, app.news, app.news_err = [], [], [], "offline"
                    # every item and warning, the toast's row and a free row above the footer
                    if app.menu_layout().total > h - 5:
                        raise RuntimeError(f"the menu does not fit into {w}x{h}" + (" with the warning" if bad else ""))
                    app.menu_sel = len(app.menu_items()) - 3
                    shot(app.draw_menu)
                    app.repo, app.aur, app.news = saved
                    app.news_err = None
        for st in states:
            app.rep, app.menu_sel = st, len(app.menu_items()) - 2
            shot(app.draw_menu)
        app.menu_sel = 0
        app.toast(REPORTS_HINT)
        shot(app.draw_menu)
        app.confirm = time.time()
        shot(app.draw_menu)
        app.confirm, app.state, app.bad = None, "settings", None
        for st in states:                       # what the reports' state says, under their switch
            app.rep, app.set_sel = st, 0
            shot(app.draw_settings)
        for on in (False, True):                # every other item chosen, the services' switch either way
            app.services_on = on
            for i in range(1, len(SETTINGS_ITEMS)):
                app.set_sel = i
                shot(app.draw_settings)
        app.rep = states[4]                     # the longest status line, two rows
        for i in range(len(SETTINGS_ITEMS)):    # every description ends above the toast's row
            app.set_sel = i
            if bottom(app.draw_settings) >= h - 4:
                raise RuntimeError(f"the settings do not fit into {w}x{h} ({SETTINGS_ITEMS[i][0]})")
        app.pv = Reader(None, start=False)
        shot(app.draw_settings)                 # still being put together
        app.pv.src = preview_source(preview)
        for scroll in (0, 40, 1 << 30):
            app.pv.scroll = scroll
            shot(app.draw_settings)
        app.pv, app.state = None, "updates"
        for got in (None, [], updates):         # being read, none yet, five
            app.up_list = got
            for sel in (0, 2, 4):
                app.up_sel = sel
                shot(app.draw_updates)
        app.up_del, app.up_sel = (updates[4]["log"], time.time()), 4      # the last one chosen, a D pressed
        if bottom(app.draw_updates) >= h - 4:
            raise RuntimeError(f"the last updates do not fit into {w}x{h}")
        shot(app.draw_updates)
        app.up_del, app.up_reader = None, Reader(None, start=False)
        shot(app.draw_updates)                  # its report still being put together
        app.up_reader.src = preview_source(json.loads(preview))
        for scroll in (0, 1 << 30):
            app.up_reader.scroll = scroll
            shot(app.draw_updates)
        app.up_reader, app.state, app.article = None, "news", None
        shot(app.draw_news)
        app.article, app.scroll = app.news[0], 3
        shot(app.draw_news)
        app.state, app.article = "menu", None
        view = LiveView(app, demo=True)
        view.bell = lambda: None
        for kind in ("info", "auto", "warn", "err"):
            view.push("строка ленты " * 8, kind)
        shot(view.draw)
        view.handover("запрос пароля", "[sudo] password for cactus:")
        view.input = "secret"
        shot(view.draw)
        view.handover_done()
        view.hub = True
        shot(view.draw)
        view.hub = False
        for G in games.GAMES:
            view.game = G()
            for k in ("down", "left", "up", "right", "down"):
                view.game.key(k)
                view.game.step(time.time())
            shot(view.draw)
        view.update_done = True
        shot(view.draw)
        view.game = None
        for sv, demo, left in ((summary_view(res, 125), False, None), (summary_view(res, 3), False, 7.5),
                               (summary_view(None, 0), True, None)):
            shot(lambda: draw_summary(app, sv, 2.0, demo, left))
        for state, age, endpoint in (("waiting", 0, True), ("waiting", 60, True), ("waiting", 0, False),
                                     ("sent", 0, True), ("rejected", 0, True)):
            sent.state, sent.t0, sent.polled, sent.endpoint = state, time.time() - age, math.inf, endpoint
            for r in (res, full):               # a row of its own below the journal line, or a place on it
                shot(lambda: draw_summary(app, summary_view(r, 125, sent), 2.0, False, 7.5))
        shot(lambda: draw_summary(app, summary_view(res, 125, building), 2.0, False, 7.5))

        for r in (keyed, keyed_full):           # its keys, the notes, what came of a key; and opened from the menu
            acts = Actions(app, r)
            if len(acts.keys()) != 3:
                raise RuntimeError(f"the summary offers {len(acts.keys())} of its 3 keys")
            for st in statuses:
                acts.status = st
                shot(lambda: draw_summary(app, acts.view(463), 2.0, False, None))
                shot(lambda: draw_summary(app, acts.view(seconds_of(r), review="02.11 12:50"), 2.0, False, None))
            acts.sent = sent                    # queued by itself: no S
            shot(lambda: draw_summary(app, acts.view(463), 2.0, False, 7.5))
            # S after F: not while a report is still on its way (it knows nothing of F), then once more
            acts = Actions(app, r)
            acts.job = types.SimpleNamespace(done=False, ok=False, log=acts.log)
            acts.after_fix()
            if acts.can_send():
                raise RuntimeError("S is offered again while a report is still on its way")
            acts.job.done = acts.job.ok = True
            if not acts.can_send():
                raise RuntimeError("S is not offered again after F")
            shot(lambda: draw_summary(app, acts.view(463), 2.0, True, None))

        def items(sv):
            draw_summary(app, sv, 2.0, False, 7.5)
            n = sum(ch in "✗⚠✓" for row in c.ch for ch in row)
            c.clear()
            return n
        if items(summary_view(full, 125, sent)) < items(summary_view(full, 125)):
            raise RuntimeError(f"the summary's report line pushes a problem or a warning off at {w}x{h}")
        # Nothing goes unsaid: every item shows (cut alike, with "…"), or the last row says how many more there are.
        many = dict(full, problems=[f"проблема {i}: " + "длинное описание " * 9 for i in range(14)])
        for sv in (summary_view(many, 125, sent), summary_view(full, 125, sent)):
            draw_summary(app, sv, 2.0, False, 7.5)
            shown = sum(ch in "✗⚠✓›" for row in c.ch for ch in row)
            told = re.search(r"и ещё (\d+)", "\n".join("".join(row) for row in c.ch))
            c.clear()
            if shown + (int(told.group(1)) if told else 0) != len(sv.lines):
                raise RuntimeError(f"the summary leaves items out unsaid at {w}x{h}")
        # The report's line takes a row of its own only where no item gives up a line for it: with it, never more
        # items cut short ("…") than without it.
        tw = max(10, min(w - 8, 84) - 4)
        for n3 in range(4):
            for n1 in range(4):
                mix = dict(res, problems=[f"проблема {i}: " + "слово " * (tw * 5 // 12) for i in range(n3)],
                           ok=[f"проверка {i}" for i in range(n1)], warnings=[], notes=[])
                cut = []
                for with_line in (sent, None):
                    draw_summary(app, summary_view(mix, 125, with_line, keys=[("F — исправить", "F")]), 2.0, False,
                                 None)
                    cut.append(sum(row.count("…") for row in ("".join(r) for r in c.ch)))
                    c.clear()
                if cut[0] > cut[1]:
                    raise RuntimeError(f"the summary's report line cuts items short at {w}x{h} ({n3}+{n1} items)")
        acts = Actions(app, keyed_full)
        acts.status = statuses[2]
        if items(acts.view(125)) < items(summary_view(keyed_full, 125, keys=acts.keys())):
            raise RuntimeError(f"the summary's status line pushes a problem or a warning off at {w}x{h}")
        if bottom(lambda: draw_summary(app, acts.view(125), 2.0, False, 7.5), above=h - 3) >= h - 4:
            raise RuntimeError(f"the summary runs into its keys at {w}x{h}")     # a blank row between them
    gate.set()
    building.finish()
    print("arch-update-ui: self-test ok")


# ───────────────────────────── main ─────────────────────────────

def run_auto(app):
    view = LiveView(app, demo=DEMO)
    transition(app, view)
    t0 = time.time()
    status, res, _ = engine.run_update(view, manual=False, stop_on_news=False,
                                       cmd=DEMO_CMD if DEMO else None, dims=tuple(app.s.size),
                                       on_spawn=lambda ch: setattr(app, "child", ch), demo=DEMO)
    elapsed = time.time() - t0
    sent = queue_report(app, res, "auto", elapsed)     # started now: a game left open must not hold it back
    if not DEMO and not view.raw and res is not None and res.get("started", True):
        view.prog.learn()
    if (view.game or view.hub) and not view.raw and engine.TERM_OK:
        view.play_after()
    return view, res, elapsed, sent


def run_manual(app, tty_state):
    app.s.leave()
    termios.tcsetattr(0, termios.TCSADRAIN, tty_state)
    tty.setraw(0)
    view = engine.TerminalView()
    engine.VIEW = view
    view.message("[arch-update] обычный Arch-Update: на вопросы отвечаешь ты. Всё пишется в журнал, "
                 "в конце будет проверка системы.\n")

    # Keys typed while the screen switched (a password typed ahead) must never reach arch-update: its
    # pty echoes them, onto the screen and into the journal. Nothing has asked for anything yet, so
    # they go now, and again the moment it starts: run_update gets ready first (pacman -Q, sudo -n),
    # which takes a moment on a slow machine, and whatever is typed meanwhile would go to it too.
    def spawned(child):
        app.child = child
        drop_typeahead()

    drop_typeahead()
    t0 = time.time()
    status, res, _ = engine.run_update(view, manual=True, cmd=DEMO_CMD if DEMO else None,
                                       dims=tuple(app.s.size), on_spawn=spawned, demo=DEMO)
    elapsed = time.time() - t0
    return res, elapsed, queue_report(app, res, "manual", elapsed)


def main():
    if "--self-test" in sys.argv:
        return self_test()
    if not sys.stdin.isatty():
        sys.exit("arch-update-ui нужен терминал")
    if DEMO:
        os.environ["ARCH_UPDATE_AUTO_NOTIFY"] = "0"
        os.environ["ARCH_UPDATE_AUTO_LOGDIR"] = os.path.join(engine.STATE_DIR, "demo-logs")
    engine.shield_from_window_close()
    old = termios.tcgetattr(0)
    holder = {}

    def on_winch(*_):
        app = holder.get("app")
        if not app:
            return
        app.resized = True
        ch = getattr(app, "child", None)
        if ch:
            try:
                ch.setwinsize(*reversed(term_size()))
            except (OSError, ValueError):
                pass
    signal.signal(signal.SIGWINCH, on_winch)      # before the size is first read: no resize gets lost
    app, action, res = None, None, None
    try:
        app = holder["app"] = App()
        app.child = None
        tty.setraw(0)
        app.s.enter()
        app.resized = True                        # the terminal may still be going full screen
        action = app.loop()
        app.send_waiting(leaving=True)            # what an earlier run could not send, if still on
        if action == "auto":
            view, res, elapsed, sent = run_auto(app)
            if engine.TERM_OK:
                if view.raw:
                    app.s.enter()
                app.s.resize()
                summary_screen(app, res, elapsed, demo=DEMO, sent=sent)
        elif action == "manual":
            res, elapsed, sent = run_manual(app, old)
            if engine.TERM_OK:
                app.s.enter()
                app.s.resize()
                summary_screen(app, res, elapsed, demo=DEMO, sent=sent)
    except Exception:
        tb = traceback.format_exc()
        note_ui_error(tb)
        if app:
            app.s.leave()
        try:
            termios.tcsetattr(0, termios.TCSADRAIN, old)
        except termios.error:
            pass
        print("\narch-update-ui: ошибка интерфейса (подробности в ~/.local/state/arch-update-auto/ui-error.log)")
        print(tb)
        if res:
            for p in res["problems"]:
                print("✗", p)
            for w in res["warnings"]:
                print("⚠", w)
            for n in res.get("notes") or []:
                print("·", n)
            print("✓ проблем не найдено" if not res["problems"] else "НЕ перезагружайся, пока не разберёмся")
            print("журнал:", res["log"])
        # Nothing has run yet (and this is not the demo, which must never touch the system):
        # the plain updater still can. Chosen mode as chosen; before a choice, the user answers.
        if engine.LOG is None and not DEMO and engine.TERM_OK and action != "quit":
            mode = action if action in ("auto", "manual") else None
            if not mode:
                try:
                    if input("Enter — обычный Arch-Update (на вопросы отвечаешь сам), q — выход: ").strip() \
                            in ("q", "й"):
                        return
                except (EOFError, KeyboardInterrupt, OSError):
                    return
                mode = "manual"
            os.environ["ARCH_UPDATE_AUTO_MODE"] = mode
            print("Запускаю обычный режим…\n")
            try:
                os.execv(os.path.join(HERE, "arch-update-auto"), ["arch-update-auto"])
            except OSError as e:
                print(f"не удалось запустить arch-update-auto: {e}")
        if engine.TERM_OK:
            try:
                input("Enter — закрыть")
            except (EOFError, OSError):
                pass
        return
    finally:
        if app and app.report_line:
            app.report_line.finish()              # one started just before the window closed still gets queued
        SendJob.finish()                          # and one sent by hand still gets its answer and its record
        if engine.TERM_OK and app:
            app.s.leave()
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old)
            except termios.error:
                pass


if __name__ == "__main__":
    main()
