def fit_keys(parts, width):
    """Key hints, (long, short) pairs, in one line of at most width: wide apart, closer, or with the longest
    hints in their short forms, whatever fits first. "" without any."""
    use = [0] * len(parts)
    text = ""
    while parts:
        for sep in ("   ·   ", "  ·  ", " · "):
            text = sep.join(p[u] for p, u in zip(parts, use))
            if len(text) <= width:
                return text
        longs = [i for i, u in enumerate(use) if not u and parts[i][0] != parts[i][1]]
        if not longs:
            break                                   # keyline() cuts it
        use[max(longs, key=lambda i: len(parts[i][0]))] = 1
    return text


def first_problem(res):
    """The problem of an update to name first: one that says not to reboot, else the first one."""
    problems = [p for p in (res or {}).get("problems") or [] if isinstance(p, str)]
    worst = [p for p in problems if "НЕ перезагружайся" in p] + problems
    return worst[0] if worst else ""


def short_problem(text):
    return NOT_REBOOT.sub("", text) or text


def verdict_mark(u):
    """(glyph, words, colour) of an update in the list of the last ones."""
    if not u.get("started", True):
        return ("✗", "не начиналось", BAD) if u.get("verdict") == 2 else ("·", "не начиналось", DIM)
    if u.get("resolved"):                       # it found problems, and a fix and a second look ended them
        return "✓", "исправлено", GOOD
    return {0: ("✓", "всё чисто", GOOD), 1: ("⚠", "есть что прочитать", WARN),
            2: ("✗", "нужна проверка", BAD)}.get(u.get("verdict"), ("·", "без итога", DIM))


def when_text(iso, year=True):
    """"02.11.2026 12:59" (or without the year) from an ISO local time; "" for anything else."""
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)", iso if isinstance(iso, str) else "")
    if not m:
        return ""
    y, mo, d, h, mi = m.groups()
    return f"{d}.{mo}.{y} {h}:{mi}" if year else f"{d}.{mo} {h}:{mi}"


def seconds_of(res):
    """How long an update took, from its summary's began and ended; None when that is not known."""
    times = [(res or {}).get(k) for k in ("began", "ended")]
    m = [re.match(r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)", v if isinstance(v, str) else "") for v in times]
    if not all(m):
        return None
    began, ended = (time.mktime(tuple(map(int, x.groups())) + (0, 0, -1)) for x in m)
    return ended - began if 0 <= ended - began <= 30 * 86400 else None


def write_error(e):
    return WRITE_ERRORS.get(getattr(e, "errno", None), "ошибка записи")


def reports_parts(st):
    """What the quiet line under the reports switch says, from report.status()."""
    if not st["enabled"]:
        # Whoever wants their reports deleted switches them off first, and then still needs the ID.
        return ["сейчас ничего не собирается и не отправляется"] + \
            ([f"ID этой машины в прошлых отчётах: {st['id']}"] if st["id"] else [])
    parts = [f"ID этой машины в отчётах: {st['id'] or '—'}"]
    if not st["endpoint"]:
        return parts + ["сервер для отчётов ещё не подключён — отчёты ждут на этой машине"
                        + (f": {st['waiting']}" if st["waiting"] else "")]
    # The sender notes its last error as it came ("HTTP 400: …", "URLError: …"), said here in short.
    # A refusal is final; other errors are tried again with the reports still waiting, so with none
    # waiting such an error is out of date.
    http = re.match(r"HTTP (\d+)", st["last_error"] or "")
    code = int(http.group(1)) if http else None
    # A refusal: a 4xx answer, or a report set aside after the server failed on it again and again
    refused = code is not None and ((code < 500 and code not in (404, 405, 408, 429))
                                    or "не принят" in st["last_error"])
    m = re.match(r"\d{4}-(\d\d)-(\d\d)T(\d\d):(\d\d)", st["last_sent"] or "")
    if st["waiting"]:
        parts.append(f"ждут отправки: {st['waiting']}")
    elif not refused:                                   # a refusal is newer than the last report sent
        parts.append("последний отчёт отправлен {1}.{0} {2}:{3}".format(*m.groups()) if m else
                     "первый отчёт уйдёт после следующего обновления")
    if refused:
        parts.append("последний отчёт не принят сервером")
    elif st["last_error"] and st["waiting"]:            # 408, 429, 5xx, or no answer at all
        parts.append(("сервер пока не принимает отчёты" if code else "нет связи с сервером")
                     + " — повторю при следующем запуске")
    return parts


def wrap_parts(parts, width, rows=2):
    """Parts joined by " · " with the line breaks between them (inside one only when it is longer
    than a line), in at most `rows` lines: the last one keeps what fits and ends in "…"."""
    lines = []
    for part in parts:
        if lines and len(lines[-1]) + 3 + len(part) <= width:
            lines[-1] += " · " + part
        elif len(lines) >= rows:
            room = width - len(lines[-1]) - 3
            lines[-1] = lines[-1] + " · " + part[:room - 1] if room > 12 else lines[-1][:width - 1]
            lines[-1] += "…"
            break
        else:
            lines += textwrap.wrap(part, width, break_on_hyphens=False) or [""]
    if len(lines) > rows:                           # one part longer than the rows left for it
        lines = lines[:rows]
        lines[-1] = lines[-1][:width - 1] + "…"
    return lines


def preview_source(text):
    """A report (report.preview()'s text, or report.build_from_log()'s dict) as lines to read: (kind, line).
    The fields as JSON, then the log line by line (inside the JSON the whole log is one string with \\n in it)."""
    if isinstance(text, dict):
        data = dict(text)
    else:
        try:
            data = json.loads(text)
        except ValueError:
            data = None
    if not isinstance(data, dict):
        return [("json", UNPRINTABLE.sub("?", line.expandtabs())) for line in str(text).split("\n")]
    log = data.pop("log", None)
    out = [("json", UNPRINTABLE.sub("?", line))           # JSON leaves U+0080…U+009F as they are
           for line in json.dumps(data, ensure_ascii=False, indent=1).split("\n")]
    if isinstance(log, str):
        rows = log.split("\n")
        if rows[-1] == "":
            rows.pop()
        n = len(rows)
        out += [("json", ""), ("rule", f'"log": журнал обновления, {n} {plural(n, "строка", "строки", "строк")}'
                               if n else '"log": пусто (журнала обновления на этой машине пока нет)')]
        out += [("log", UNPRINTABLE.sub("?", row.expandtabs())) for row in rows]
    return out


def wrap_source(src, width):
    """(kind, text, first) rows of the given width; a wrapped line goes on indented under itself."""
    out = []
    for kind, line in src:
        if len(line) <= width:
            out.append((kind, line, True))
            continue
        indent = " " * min(len(line) - len(line.lstrip(" ")) + 2, width // 2)
        parts = textwrap.wrap(line, width, subsequent_indent=indent, break_on_hyphens=False) or [line[:width]]
        out += [(kind, p, i == 0) for i, p in enumerate(parts)]
    return out


class Reader:
    """A report to read ("Что именно уходит", or the report of one of the last updates), laid out like a news
    article. make() returns it (text or dict) and runs in a thread of its own: the device, pacman and the whole
    journal take a moment on a slow machine. start=False: nothing is made (the self-test fills src itself)."""

    def __init__(self, make, start=True):
        self.src, self.scroll, self.page, self.wrapped = None, 0, 10, None
        if start:
            threading.Thread(target=self._make, args=(make,), daemon=True).start()

    def _make(self, make):
        try:
            src = preview_source(make())
        except Exception as e:               # whatever went wrong, the screen says it instead of waiting
            src = [("json", f"не удалось собрать отчёт: {e!r}")]
        self.src = src

    def rows(self, width):
        """The report wrapped to the width (once per width), or None while it is being put together."""
        if self.src is None:
            return None
        if not self.wrapped or self.wrapped[0] != width:
            self.wrapped = (width, wrap_source(self.src, width))
        return self.wrapped[1]

    def key(self, key):
        """Scrolls by a line or a page (here ←→ page, never move the window); False for any other key."""
        if key in ("up", "k"):
            self.scroll = max(0, self.scroll - 1)
        elif key in ("down", "j", "space"):
            self.scroll += 1
        elif key in ("pgup", "left"):
            self.scroll = max(0, self.scroll - self.page)
        elif key in ("pgdn", "right"):
            self.scroll += self.page
        elif key in ("home", "end"):
            self.scroll = 0 if key == "home" else 1 << 30     # the next frame clamps it
        else:
            return False
        return True


class SendJob:
    """One update's report sent by hand (report.send_now: the key is the consent for this one report, with the
    automatic reports off too), in a thread of its own. Its line says «отправляю отчёт…» until the answer, then
    what came of it; a toast that says it is on its way gets the answer too, on whatever screen is open by then.
    The program waits for the answer before it closes (WAIT, and FINISH at its very end): the user is told."""
    WAIT = 45                       # seconds a screen being left waits for the answer at most (send_now: 20 + build)
    FINISH = 8                      # seconds the program's end waits for one still on its way (see main)
    ALL = []                        # every one of this run

    def __init__(self, log, ui=None, app=None):
        self.log, self.result, self.told, self.app = log, None, False, app
        self.thread = threading.Thread(target=self._send, args=(log, ui), daemon=True)
        SendJob.ALL.append(self)
        self.thread.start()

    def _send(self, log, ui):
        try:
            ok, message, _ = report.send_now(log, ui=ui)
        except Exception:                     # send_now never raises; this is in case it ever does
            ok, message = False, "не удалось собрать отчёт"
        self.result = (ok, message)
        app = self.app
        if app is not None and app.toast_text == SENDING and not self.told:
            self.told = True                  # the toast said it was on its way: it says the answer too
            app.toast(message, secs=5)

    @property
    def done(self):
        return self.result is not None

    @property
    def ok(self):
        return bool(self.result and self.result[0])

    def line(self):
        if self.result is None:
            return SENDING, DIM
        return self.result[1], GOOD if self.result[0] else WARN

    @classmethod
    def finish(cls, timeout=FINISH):
        """At the program's end: a report sent by hand just before still gets its answer (and its record)."""
        end = time.time() + timeout
        for job in cls.ALL:
            job.thread.join(max(0, end - time.time()))


class Status:
    """What came of a key pressed on the summary (a restart, a fix): one line in its colour."""

    def __init__(self, text, colour):
        self.text, self.colour = text, colour

    def line(self):
        return self.text, self.colour


