#!/usr/bin/env bash
# arch-update-launcher: opens the full-screen Arch Update UI (by Cactus) in its own terminal window.
# The tray icon, its notification's "Run" and the menu entry all come here (share/arch-update.desktop.in).
# First it installs a newer tested version of the updater if there is one (arch-update-cactus-sync).
#
#   arch-update-launcher [--demo]     start the UI (arguments are passed to arch-update-ui)
#   arch-update-launcher --terminal   print the terminal that would be used (exit 1: none found)
#
# Terminal: $ARCH_UPDATE_TERMINAL if set, else Konsole (with our profile), else the first one
# installed from TERMINALS. The UI paints its own colours, so any of them looks the same.
BIN=$(dirname "$(realpath "$0")")
TERMINALS=(konsole kitty alacritty foot wezterm ptyxis gnome-terminal kgx xfce4-terminal mate-terminal
	xdg-terminal-exec terminator tilix lxterminal xterm)
BG='#0b0e17' FG='#c9d1e3' TITLE='Arch Update'

pick_terminal() {
	local t
	for t in ${ARCH_UPDATE_TERMINAL-} "${TERMINALS[@]}"; do
		command -v "$t" >/dev/null && { echo "$t"; return 0; }
	done
	return 1
}

# Print the command line that runs "$@" full-screen in terminal $1, one word per line.
terminal_cmd() {
	local t=$1
	shift
	case $t in
	konsole) printf '%s\n' konsole --separate --fullscreen --profile ArchUpdate --hide-menubar --hide-tabbar \
		--hide-toolbars -p "tabtitle=$TITLE" -e "$@" ;;
	kitty) printf '%s\n' kitty --class arch-update --title "$TITLE" --start-as fullscreen -o "background=$BG" \
		-o "foreground=$FG" -o window_padding_width=20 -o font_size=13 "$@" ;;
	alacritty) printf '%s\n' alacritty --class arch-update --title "$TITLE" -o 'window.startup_mode="Fullscreen"' \
		-o "colors.primary.background=\"$BG\"" -o "colors.primary.foreground=\"$FG\"" \
		-o 'window.padding={x=20,y=20}' -o font.size=13 -e "$@" ;;
	foot) printf '%s\n' foot --fullscreen --title "$TITLE" --app-id arch-update -o "colors-dark.background=${BG#\#}" \
		-o "colors-dark.foreground=${FG#\#}" -o pad=20x20 "$@" ;;
	wezterm) printf '%s\n' wezterm start --always-new-process --class arch-update -- "$@" ;;
	ptyxis) printf '%s\n' ptyxis --fullscreen --title="$TITLE" -- "$@" ;;
	gnome-terminal) printf '%s\n' gnome-terminal --full-screen --hide-menubar --title "$TITLE" -- "$@" ;;
	kgx) printf '%s\n' kgx --title "$TITLE" -- "$@" ;;
	xfce4-terminal) printf '%s\n' xfce4-terminal --disable-server --fullscreen --hide-menubar --hide-toolbar \
		--hide-scrollbar -T "$TITLE" --color-bg="$BG" --color-text="$FG" -x "$@" ;;
	mate-terminal) printf '%s\n' mate-terminal --full-screen --hide-menubar -t "$TITLE" -x "$@" ;;
	xdg-terminal-exec) printf '%s\n' xdg-terminal-exec "$@" ;;
	terminator) printf '%s\n' terminator --fullscreen -T "$TITLE" -x "$@" ;;
	tilix | lxterminal) printf '%s\n' "$t" -t "$TITLE" -e "$*" ;;
	xterm) printf '%s\n' xterm -fullscreen -bg "$BG" -fg "$FG" -fa Hack -fs 13 -T "$TITLE" -e "$@" ;;
	*) printf '%s\n' "$t" -e "$@" ;;
	esac
}

if [[ ${1-} == --terminal ]]; then
	pick_terminal
	exit
fi

# A newer tested version? Install it, then start that version of this launcher.
if [[ -z ${ARCH_UPDATE_SYNCED-} ]]; then
	"$BIN/arch-update-cactus-sync" --quick
	if [[ $? -eq 10 ]]; then
		export ARCH_UPDATE_SYNCED=1
		exec "$BIN/arch-update-launcher" "$@"
	fi
fi

term=$(pick_terminal) || {
	notify-send -a Arch-Update "Arch Update" "Не найден терминал. Переустанови: ~/.local/share/arch-update-cactus/install.sh" \
		2>/dev/null
	exit 1
}
prog=$BIN/arch-update-ui
[[ -x $prog ]] || prog=$BIN/arch-update-auto
export ARCH_UPDATE_TERMINAL_USED=$term      # for the update report, if the user allows reports
mapfile -t cmd < <(terminal_cmd "$term" "$prog" "$@")
exec "${cmd[@]}"
