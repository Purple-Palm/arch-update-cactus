#!/usr/bin/env python3
"""arch-update-auto: run arch-update in the plain terminal and answer its routine questions.

The logic lives in lib/engine.py next to this program (shared with the
full-screen arch-update-ui). Risky or unrecognised questions are handed back to
you (bell + notification); Ctrl+] switches to manual mode. Closing the window
never interrupts pacman. Every run is logged to
~/.local/state/arch-update-auto/logs/ (latest.log = newest). With
"restart_services" on in settings.json (Arch-Update → Настройки) the services
safe to restart are restarted when arch-update asks; the summary prints the
commands for what is left (services waiting, fixes before a reboot).

It takes no arguments and has no demo (that is arch-update-ui --demo): given any
argument it refuses and runs nothing, the real update least of all.

Environment:
  ARCH_UPDATE_CMD          command to run (default: arch-update)
  ARCH_UPDATE_AUTO_MODE    "auto" (default) or "manual" (only logging + checks)
  ARCH_UPDATE_AUTO_NEWS    "stop" (default) hand over on [NEW] Arch news, "skip" to continue
  ARCH_UPDATE_AUTO_SUMMARY "0" skips the post-update system checks
  ARCH_UPDATE_AUTO_NOTIFY  "0" disables desktop notifications
  ARCH_UPDATE_AUTO_LOGDIR  log directory
"""
import os
import select
import shlex
import shutil
import signal
import sys
import termios
import time
import tty

# No arguments: one meant for arch-update-ui (--demo above all) must never end in the real update.
# Checked before anything else, the fallback to plain arch-update below included.
if sys.argv[1:]:
    sys.exit("arch-update-auto: " + ("демо есть только в arch-update-ui" if "--demo" in sys.argv[1:] else
                                     f"неизвестный параметр «{sys.argv[1]}» — параметров у этой программы нет, "
                                     "ничего не запускаю"))

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
try:
    import engine  # noqa: E402
    import report  # noqa: E402
    from engine import C_BOLD, C_DIM, C_GRN, C_RED, C_YEL, say  # noqa: E402
except Exception as e:      # no python-pexpect, a damaged file…: run the plain upstream updater instead
    print(f"arch-update-auto: не загрузился движок апдейтера: {e!r}")
    print("Если не хватает pexpect: sudo pacman -S --needed python-pexpect\nЗапускаю обычный arch-update…\n")
    os.execvp("arch-update", ["arch-update"])


def print_summary(res):
    say(f"\n{C_BOLD}══════ Итог обновления ══════{engine.C_OFF}\n", "")
    say(f"Обновлено: {len(res['changed'])}, установлено новых: {len(res['added'])}, "
        f"удалено: {len(res['removed'])}\n", "")
    for p in res["problems"]:
        say(f"✗ {p}\n", C_RED)
    for w in res["warnings"]:
        say(f"⚠ {w}\n", C_YEL)
    for n in res.get("notes") or []:          # not this update's problem, or nothing to do now
        say(f"· {n}\n", C_DIM)
    if res.get("head"):
        say(f"{res['head']}.\n", C_YEL)
    elif res["verdict"] == 0:
        say("✓ Всё прошло чисто — перезагрузись, когда будет удобно.\n" if res.get("reboot") else
            "✓ Всё прошло чисто, перезагрузка не нужна.\n", C_GRN)
    elif res["verdict"] == 1:
        say("✓ Обновление прошло нормально.\n", C_GRN)
    fixes = res.get("fixes") or []
    if fixes:
        say("Исправить до перезагрузки — по порядку, в терминале:\n", C_BOLD)
        for fix in fixes:
            say(f"  {fix.get('how') or shlex.join(fix['argv'])}   # {fix['label']}\n", "")
    waiting = engine.services_command((res.get("services") or {}).get("waiting") or [])
    if waiting:
        say(f"Перезапустить сервисы сейчас: {shlex.join(waiting)}\n", "")
    say(f"Журнал: {res['log']}\n", C_DIM)


def drop_typeahead():
    """Throw away the keys typed but not read yet. Never raises (it runs as arch-update starts)."""
    try:
        termios.tcflush(0, termios.TCIFLUSH)
    except (termios.error, OSError):        # no terminal any more: the window was closed
        pass


def wait_close(verdict, status):
    try:
        termios.tcflush(0, termios.TCIFLUSH)   # an Enter typed earlier must not skip the summary
        if verdict == 0 and not status:
            # Clean run: close by itself like MX; any key other than Enter keeps the window open.
            cooked = termios.tcgetattr(0)
            tty.setcbreak(0)
            try:
                key = None
                for left in range(10, 0, -1):
                    say(f"\rОкно закроется через {left:2d} с (Enter — закрыть сейчас, "
                        f"любая другая клавиша — оставить). ", C_BOLD)
                    if select.select([0], [], [], 1)[0]:
                        key = os.read(0, 16)
                        break
            finally:
                termios.tcsetattr(0, termios.TCSADRAIN, cooked)
            if key and key.strip(b"\r\n"):
                say("\nОставляю открытым. Нажми Enter, чтобы закрыть.", C_BOLD)
                termios.tcflush(0, termios.TCIFLUSH)
                sys.stdin.readline()
        else:
            say("\nНажми Enter, чтобы закрыть окно.", C_BOLD)
            sys.stdin.readline()
    except (termios.error, OSError, ValueError):
        pass


def main():
    interactive = sys.stdin.isatty()
    if interactive:
        engine.shield_from_window_close()
    manual = os.environ.get("ARCH_UPDATE_AUTO_MODE", "auto") == "manual"
    stop_on_news = os.environ.get("ARCH_UPDATE_AUTO_NEWS", "stop") != "skip"
    view = engine.TerminalView()
    engine.VIEW = view
    if manual:
        say("[arch-update] обычный Arch-Update: на вопросы отвечаешь ты. Всё пишется в журнал, "
            "в конце будет проверка системы.\n")
    else:
        say(f"{C_BOLD}[автоответчик]{engine.C_OFF}{C_DIM} отвечаю на стандартные вопросы сам; "
            f"Ctrl+] — ручной режим.\n")

    old_tty = None
    if interactive:
        old_tty = termios.tcgetattr(0)
        tty.setraw(0)
    child_holder = {}
    # In manual mode every key goes straight to arch-update's pty, which echoes it onto the screen and
    # into the journal: keys typed ahead (a password for the sudo question that is bound to come) must
    # never get there. Nothing has asked for anything yet, so they go now, and again the moment it
    # starts: run_update gets ready first (pacman -Q, sudo -n), which takes a moment on a slow machine.
    flush = manual and interactive

    def spawned(child):
        child_holder["child"] = child
        if flush:
            drop_typeahead()

    def on_winch(*_):
        child = child_holder.get("child")
        if child:
            try:
                child.setwinsize(*reversed(shutil.get_terminal_size((120, 40))))
            except (OSError, ValueError):
                pass
    if interactive:
        signal.signal(signal.SIGWINCH, on_winch)
    summary = os.environ.get("ARCH_UPDATE_AUTO_SUMMARY", "1") != "0"
    t0 = time.time()
    try:
        if flush:
            drop_typeahead()
        status, res, _ = engine.run_update(view, manual=manual, stop_on_news=stop_on_news, summary=summary,
                                           on_spawn=spawned)
    finally:
        signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        if old_tty is not None and engine.TERM_OK:
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old_tty)
            except termios.error:
                pass
    verdict = 0
    if res:
        print_summary(res)
        verdict = res["verdict"]
        cols, rows = shutil.get_terminal_size((120, 40))
        if report.after_update(res, mode="manual" if manual else "auto", seconds=time.time() - t0,
                               ui={"screen": f"{cols}x{rows}"}):
            if report.endpoint():
                say("Отчёт об этом обновлении уходит разработчику (выключить: Arch-Update → Настройки).\n")
            else:                   # no server yet: nothing sends it, it waits on this machine
                say("Отчёт сохранён — уйдёт, когда подключат сервер для отчётов "
                    "(выключить: Arch-Update → Настройки).\n")
    if interactive and engine.TERM_OK:
        wait_close(verdict, status)
    sys.exit(2 if verdict == 2 else (status or 0))


if __name__ == "__main__":
    main()
